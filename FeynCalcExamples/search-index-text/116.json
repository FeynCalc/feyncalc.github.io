[{"text":"\\left\\{G^{\\text{fctopology1}}(0,1,1,0,1)\\to (-\\text{pp})^{1-2 \\;\\text{ep}} \\left(-\\frac{13}{8} \\;\\text{ep}^2 \\zeta (2)-\\frac{5 \\;\\text{ep}^2 \\zeta (3)}{12}+\\frac{9}{8} \\;\\text{ep}^2 \\left(\\frac{9}{4}-2 \\zeta (3)\\right)+\\frac{49 \\;\\text{ep}^2}{2}-\\frac{1}{4} \\;\\text{ep} \\zeta (2)+\\frac{115 \\;\\text{ep}}{16}+\\frac{1}{4 \\;\\text{ep}}+\\frac{13}{8}\\right),G^{\\text{fctopology1}}(1,1,0,1,1)\\to (-\\text{pp})^{-2 \\;\\text{ep}} \\left(\\text{ep}^2 (-\\zeta (2))+\\frac{\\text{ep}^2 \\zeta (3)}{3}+\\frac{4}{3} \\;\\text{ep}^2 (2-2 \\zeta (3))+\\frac{16 \\;\\text{ep}^2}{3}-\\frac{1}{2} \\;\\text{ep} \\zeta (2)+4 \\;\\text{ep}+\\frac{1}{\\text{ep}}+2\\right)^2\\right\\}","anchor":"cb28-4","section":"Rewrite the amplitude in terms of GLIs"},{"text":"resEpPre = FCReplaceD[resFinal /. ruleMasters, D -> 4 - 2 ep]","anchor":"cb29","section":"Rewrite the amplitude in terms of GLIs"},{"text":"resEp = Collect2[Series[FCReplaceD[Cancel[resEpPre/(-pp)^(-2 ep)], D -> 4 - 2 ep], {ep, 0, 0}] // Normal // SUNSimplify[#, SUNNToCACF -> False] &, ep]","anchor":"cb30","section":"Rewrite the amplitude in terms of GLIs"},{"text":"\\[-\\frac{5 i \\;\\text{gs}^4 N (5 N-2)}{12 \\;\\text{ep}^2}-\\frac{i \\;\\text{gs}^4 \\left(583 N^3-238 N^2+36\\right)}{72 \\;\\text{ep} N}+\\frac{i \\;\\text{gs}^4 \\left(900 \\zeta (2) N^3+432 N^3 \\zeta (3)-14311 N^3-360 \\zeta (2) N^2+5902 N^2+1728 \\zeta (3)-1980\\right)}{432 N}\\]","anchor":"cb30-1","section":"Rewrite the amplitude in terms of GLIs"},{"text":"funJ[2, xi] = (1 - 1/12 Pi^2 ep^2)^2 (CA^2 gs^4 (1/ep^2 (-25/12 + 5/24 xi + 1/4 xi^2) + 1/ep (-583/72 + 113/144 xi - 19/24 xi^2 + 3/8 xi^3) - 14311/432 + Zeta[3] + 425/864 xi + 2 xi Zeta[3] - 71/72 xi^2 + 9/16 xi^3 + 1/16 xi^4)); funJ[2, q] = (1 - 1/12 Pi^2 ep^2)^2 (CA Tf gs^4 (1/ep^2 (5/3 - 2/3 xi) + 1/ep (101/18 + 8/9 xi - 2/3 xi^2) + 1961/108 + 8 Zeta[3] + 142/27 xi - 22/9 xi^2 ) + CF Tf gs^4 (2/ep + 55/3 - 16 Zeta[3]));","anchor":"cb31","section":"Check the final results"},{"text":"resLit = Collect2[Series[ I (funJ[2, xi] + funJ[2, q]) /. {xi -> 0, Tf -> 1/2}, {ep, 0, 0}] // Normal // SimplifyPolyLog // SUNSimplify[#, SUNNToCACF -> False] &, ep]","anchor":"cb32","section":"Check the final results"},{"text":"\\[-\\frac{5 i \\;\\text{gs}^4 N (5 N-2)}{12 \\;\\text{ep}^2}-\\frac{i \\;\\text{gs}^4 \\left(583 N^3-238 N^2+36\\right)}{72 \\;\\text{ep} N}+\\frac{i \\;\\text{gs}^4 \\left(900 \\zeta (2) N^3+432 N^3 \\zeta (3)-14311 N^3-360 \\zeta (2) N^2+5902 N^2+1728 \\zeta (3)-1980\\right)}{432 N}\\]","anchor":"cb32-1","section":"Check the final results"},{"text":"```mathematica FCCompareResults[resLit, resEp, Text -> {“to Davydychev, Osland and Tarasov, hep-ph/9801380, Eqs. 6.10-6.11:”, “CORRECT.”, “WRONG!”}, Interrupt -> {Hold[Quit[1]], Automatic}, Factoring -> Simplify]; Print[“Time used:”, Round[N[TimeUsed[], 4], 0.001], ” s.”];","anchor":"cb32-1","section":"Check the final results"},{"text":"```mathematica","anchor":"cb32-1","section":"Check the final results"},{"text":"\\[\\text{$\\backslash $tCompare to Davydychev, Osland and Tarasov, hep-ph/9801380, Eqs. 6.10-6.11:} \\;\\text{CORRECT.}\\]","anchor":"cb32-1","section":"Check the final results"},{"text":"\\[\\text{$\\backslash $tCPU Time used: }32.412\\text{ s.}\\]","anchor":"cb32-1","section":"Check the final results"}]