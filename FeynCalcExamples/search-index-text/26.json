ules"},{"text":"SetDirectory[FileNameJoin[{$UserBaseDirectory, \"Applications\", \"FeynCalc\", \"FeynArts\", \"Models\"}]]; WriteFeynArtsOutput[LQCD, Output -> \"QCDBGF\", CouplingRename -> False,SelectParticles -> { {ghG, ghGbar, B}, {ghG, ghGbar, B, B}, {B, G, G}, {ghG, ghGbar, G}, {ghG, ghGbar, B, G}, {B, B, G, G}, {G, G, G}, {B, G, G, G}, {G, G, G, G}, {uqbar, uq, G}, {dqbar, dq, G}, {uqbar, uq, B}, {dqbar, dq, B}}];","anchor":"cb5","section":"Create FeynArts model"},{"text":"\\[\\text{ - - - FeynRules interface to FeynArts - - -}\\]","anchor":"cb5-6","section":"Create FeynArts model"},{"text":"\\[\\text{ C. Degrande C. Duhr, 2013}\\]","anchor":"cb5-6","section":"Create FeynArts model"},{"text":"\\[\\text{ Counterterms: B. Fuks, 2012}\\]","anchor":"cb5-6","section":"Create FeynArts model"},{"text":"\\[\\text{Calculating Feynman rules for }\\;\\text{L1}\\]","anchor":"cb5-6","section":"Create FeynArts model"},{"text":"\\[\\text{Starting Feynman rules calculation for L1.}\\]","anchor":"cb5-6","section":"Create FeynArts model"},{"text":"\\[\\text{Expanding the Lagrangian...}\\]","anchor":"cb5-6","section":"Create FeynArts model"},{"text":"\\[\\text{Selecting specified field content. Warning! Only mass eigenstates should be selected!}\\]","anchor":"cb5-6","section":"Create FeynArts model"},{"text":"\\[\\text{Neglecting all terms with more than }4\\text{ particles.}\\]","anchor":"cb5-6","section":"Create FeynArts model"},{"text":"\\[\\text{Neglecting all terms with less than }3\\text{ particles.}\\]","anchor":"cb5-6","section":"Create FeynArts model"},{"text":"\\[13\\text{ possible non-zero vertices have been found -$>$ starting the computation: }\\;\\text{FeynRules$\\grave{ }$FR\\$FeynmanRules}\\;\\text{ / }13.\\]","anchor":"cb5-6","section":"Create FeynArts model"},{"text":"\\[13\\text{ vertices obtained.}\\]","anchor":"cb5-6","section":"Create FeynArts model"},{"text":"\\[\\text{mytimecheck,after LGC}\\]","anchor":"cb5-6","section":"Create FeynArts model"},{"text":