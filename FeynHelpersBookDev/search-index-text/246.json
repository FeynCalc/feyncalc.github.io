[{"text":"PaXD0Expand is an option for PaXEvaluate. If set to True, Package-X function D0Expand will be applied to the output of Package-X.","anchor":"paxd0expand"},{"text":"Overview, PaXEvaluate.","anchor":"see-also","section":"See also"},{"text":"D0[0, 0, 0, 0, s, t, m^2, m^2, m^2, m^2] PaXEvaluate[%]","anchor":"cb1","section":"Examples"},{"text":"\\text{D}_0\\left(0,0,0,0,s,t,m^2,m^2,m^2,m^2\\right)","anchor":"cb1-2","section":"Examples"},{"text":"\\text{D}_0\\left(0,0,0,0,s,t,m^2,m^2,m^2,m^2\\right)","anchor":"cb1-2","section":"Examples"},{"text":"The full result is a ConditionalExpression","anchor":"cb1-2","section":"Examples"},{"text":"D0[0, 0, 0, 0, s, t, m^2, m^2, m^2, m^2] res = PaXEvaluate[%, PaXC0Expand -> True];","anchor":"cb2","section":"Examples"},{"text":"\\text{D}_0\\left(0,0,0,0,s,t,m^2,m^2,m^2,m^2\\right)","anchor":"cb2-2","section":"Examples"},{"text":"res // Short res // Last","anchor":"cb3","section":"Examples"},{"text":"\\text{D}_0\\left(0,0,0,0,s,t,m^2,m^2,m^2,m^2\\right)","anchor":"cb3-2","section":"Examples"},{"text":"\\[m^2\\]","anchor":"cb3-2","section":"Examples"},{"text":"Use Normal to get the actual expression","anchor":"cb3-2","section":"Examples"},{"text":"(res // Normal)","anchor":"cb4","section":"Examples"},{"text":"\\text{D}_0\\left(0,0,0,0,s,t,m^2,m^2,m^2,m^2\\right)","anchor":"cb4-1","section":"Examples"}]