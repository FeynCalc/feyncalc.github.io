[{"text":"FerCommand[str, args] is an auxiliary function that returns a Fermat command corresponding to str (possibly using arguments args) as a list of strings.","anchor":"fercommand"},{"text":"At the moment only a very limited set of Fermat instructions is implemented.","anchor":"fercommand"},{"text":"Overview.","anchor":"see-also","section":"See also"},{"text":"FerCommand[\"Quit\"]","anchor":"cb1","section":"Examples"},{"text":"\\[\\text{$\\&$q;}\\]","anchor":"cb1-1","section":"Examples"},{"text":"FerCommand[\"StopReadingFromTheInputFile\"]","anchor":"cb2","section":"Examples"},{"text":"\\[\\text{$\\&$x;}\\]","anchor":"cb2-1","section":"Examples"},{"text":"FerCommand[\"EnableUglyDisplay\"]","anchor":"cb3","section":"Examples"},{"text":"\\[\\text{$\\&$(U=1);}\\]","anchor":"cb3-1","section":"Examples"},{"text":"FerCommand[\"ReadFromAnInputFile\", \"myFile.txt\"]","anchor":"cb4","section":"Examples"},{"text":"\\text{$\\&$(R='myFile.txt');}","anchor":"cb4-1","section":"Examples"},{"text":"FerCommand[\"SaveToAnOutputFile\", \"myFile.txt\"]","anchor":"cb5","section":"Examples"},{"text":"\\text{$\\&$(S='myFile.txt');}","anchor":"cb5-1","section":"Examples"},{"text":"FerCommand[\"SaveSpecifiedVariablesToAnOutputFile\", {x, y, z}]","anchor":"cb6","section":"Examples"},{"text":"\\[\\text{!($\\&$o, x, y, z);}\\]","anchor":"cb6-1","section":"Examples"},{"text":"FerCommand[\"ReducedRowEchelonForm\", \"mat\"]","anchor":"cb7","section":"Examples"},{"text":"\\[\\text{Redrowech(mat);}\\]","anchor":"cb7-1","section":"Examples"},{"text":"FerCommand[\"AdjoinPolynomialVariable\", x]","anchor":"cb8","section":"Examples"},{"text":"\\[\\text{$\\&$(J=x);}\\]","anchor":"cb8-1","section":"Examples"}]