[{"text":"FCLoopMixedToCartesianAndTemporal[int, {q1, q2, ...}] attempts to convert loop integrals that contain both Lorentz and Cartesian or temporal indices/momenta to pure temporal and Cartesian indices.","anchor":"fcloopmixedtocartesianandtemporal"},{"text":"Overview","anchor":"see-also","section":"See also"},{"text":"FCI@SFAD[q] FCLoopMixedToCartesianAndTemporal[%, {q}, FCE -> True]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{1}{(q^2+i \\eta )}\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[-\\frac{1}{(q^2-\\left(q^0\\right)^2-i \\eta )}\\]","anchor":"cb1-3","section":"Examples"},{"text":"FCI@SFAD[{q1 + q2 + p, m^2}] FCLoopMixedToCartesianAndTemporal[%, {q1, q2}]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{((p+\\text{q1}+\\text{q2})^2-m^2+i \\eta )}\\]","anchor":"cb2-3","section":"Examples"},{"text":"-\\frac{1}{((p+\\text{q1}+\\text{q2})^2+m^2-\\left((p+\\text{q1}+\\text{q2})^0\\right)^2-i \\eta )}","anchor":"cb2-3","section":"Examples"},{"text":"FCI[TC[k] FVD[k, mu] FAD[k, k + p]] FCLoopMixedToCartesianAndTemporal[%, {k}]","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{k^0 k^{\\text{mu}}}{k^2.(k+p)^2}\\]","anchor":"cb3-3","section":"Examples"},{"text":"\\[\\frac{k^0 \\left(k^0 \\bar{g}^{0\\text{mu}}-k^{\\$} g^{\\$\\text{mu}}\\right)}{(k^2-\\left(k^0\\right)^2-i \\eta ).((k+p)^2-\\left((k+p)^0\\right)^2-i \\eta )}\\]","anchor":"cb3-3","section":"Examples"}]