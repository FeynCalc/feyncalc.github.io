[{"text":"SMP[par] displays a symbol for the model parameter par. Typical parameters are masses, coupling constants, mixing angles etc.","anchor":"smp"},{"text":"Parameters that are complex, like a CKM matrix element, have an I as an additional argument, e.g. SMP[\"V_ud\", I] and SMP[\"V_ud\", -I].","anchor":"smp"},{"text":"SMP[] shows the list of all available parameters.","anchor":"smp"},{"text":"Overview, SMPToSymbol.","anchor":"see-also","section":"See also"},{"text":"Electron mass \\(m_e\\)","anchor":"examples","section":"Examples"},{"text":"SMP[\"m_e\"]","anchor":"cb1","section":"Examples"},{"text":"\\[m_e\\]","anchor":"cb1-1","section":"Examples"},{"text":"Weak coupling constant \\(g_W\\)","anchor":"cb1-1","section":"Examples"},{"text":"SMP[\"g_W\"]","anchor":"cb2","section":"Examples"},{"text":"\\[g_W\\]","anchor":"cb2-1","section":"Examples"},{"text":"List all available SMP’s","anchor":"cb2-1","section":"Examples"},{"text":"SMP[]","anchor":"cb3","section":"Examples"},{"text":"SMP /@ Last /@ SMP[]","anchor":"cb4","section":"Examples"}]