[{"text":"LorentzToCartesian[exp] rewrites Lorentz tensors in form of Cartesian tensors (when possible). Using options one can specify which types of tensors should be converted.","anchor":"lorentztocartesian"},{"text":"Overview, CartesianToLorentz.","anchor":"see-also","section":"See also"},{"text":"SPD[p, q] % // LorentzToCartesian","anchor":"cb1","section":"Examples"},{"text":"\\[p\\cdot q\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[p^0 q^0-p\\cdot q\\]","anchor":"cb1-3","section":"Examples"},{"text":"LC[\\[Mu], \\[Nu]][p, q] % // LorentzToCartesian","anchor":"cb2","section":"Examples"},{"text":"\\[\\bar{\\epsilon }^{\\mu \\nu \\overline{p}\\overline{q}}\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[\\bar{g}^{0\\mu } \\bar{g}^{\\text{\\$MU}(\\text{\\$20})\\nu } \\left(-\\bar{\\epsilon }^{\\text{\\$MU}(\\text{\\$20})\\overline{p}\\overline{q}}\\right)-\\bar{g}^{\\text{\\$MU}(\\text{\\$20})\\mu } \\left(\\bar{g}^{0\\nu } \\left(-\\bar{\\epsilon }^{\\text{\\$MU}(\\text{\\$20})\\overline{p}\\overline{q}}\\right)-\\bar{g}^{\\text{\\$MU}(\\text{\\$21})\\nu } \\left(q^0 \\bar{\\epsilon }^{\\text{\\$MU}(\\text{\\$20})\\text{\\$MU}(\\text{\\$21})\\overline{p}}-p^0 \\bar{\\epsilon }^{\\text{\\$MU}(\\text{\\$20})\\text{\\$MU}(\\text{\\$21})\\overline{q}}\\right)\\right)\\]","anchor":"cb2-3","section":"Examples"},{"text":"GAD[\\[Mu]] % // LorentzToCartesian","anchor":"cb3","section":"Examples"},{"text":"\\[\\gamma ^{\\mu }\\]","anchor":"cb3-3","section":"Examples"},{"text":"\\[\\bar{\\gamma }^0 \\bar{g}^{0\\mu }-\\gamma ^{\\text{\\$MU}(\\text{\\$22})} g^{\\text{\\$MU}(\\text{\\$22})\\mu }\\]","anchor":"cb3-3","section":"Examples"}]