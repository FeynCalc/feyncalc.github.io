[{"text":"GluonPropagator[p, {mu, a}, {nu, b}] or GluonPropagator[p, mu, a, nu, b] yields the gluon propagator.","anchor":"gluonpropagator"},{"text":"GluonPropagator[p, {mu}, {nu}] or GluonPropagator[p, mu, nu] omits the SUNDelta.","anchor":"gluonpropagator"},{"text":"GP can be used as an abbreviation of GluonPropagator.","anchor":"gluonpropagator"},{"text":"The gauge and the dimension are determined by the options Gauge and Dimension. The following settings of Gauge are possible:","anchor":"gluonpropagator"},{"text":"1 for the Feynman gauge","anchor":"gluonpropagator"},{"text":"alpha for the general covariant gauge","anchor":"gluonpropagator"},{"text":"{Momentum[n] ,1} for the axial gauge","anchor":"gluonpropagator"},{"text":"Overview, GluonVertex, GluonGhostVertex, GhostPropagator, GluonGhostVertex.","anchor":"see-also","section":"See also"},{"text":"GluonPropagator[p, \\[Mu], a, \\[Nu], b] Explicit[%]","anchor":"cb1","section":"Examples"},{"text":"\\[\\Pi _{ab}^{\\mu \\nu }(p)\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[-\\frac{i \\delta ^{ab} g^{\\mu \\nu }}{p^2}\\]","anchor":"cb1-3","section":"Examples"},{"text":"GP[p, \\[Mu], a, \\[Nu], b, Gauge -> \\[Alpha]] Explicit[%]","anchor":"cb2","section":"Examples"},{"text":"\\[\\Pi _{ab}^{\\mu \\nu }(p)\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[\\frac{i \\delta ^{ab} \\left(\\frac{(1-\\alpha ) p^{\\mu } p^{\\nu }}{p^2}-g^{\\mu \\nu }\\right)}{p^2}\\]","anchor":"cb2-3","section":"Examples"},{"text":"GluonPropagator[p, \\[Mu], a, \\[Nu], b, Gauge -> {Momentum[n], 1}, Explicit -> True]","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{i \\delta ^{ab} \\left(\\frac{p^{\\mu } \\overline{n}^{\\nu }+p^{\\nu } \\overline{n}^{\\mu }}{(\\overline{n}\\cdot \\overline{p}+i \\eta )}-\\frac{\\overline{n}^2 p^{\\mu } p^{\\nu }-p^2 \\overline{n}^{\\mu } \\overline{n}^{\\nu }}{(\\overline{n}\\cdot \\overline{p}+i \\eta )^2}-g^{\\mu \\nu }\\right)}{p^2}\\]","anchor":"cb3-1","section":"Examples"},{"text":"GP[p, \\[Mu], \\[Nu]]","anchor":"cb4","section":"Examples"},{"text":"\\[\\Pi _g^{\\mu \\nu }(p)\\]","anchor":"cb4-1","section":"Examples"},{"text":"Explicit[%]","anchor":"cb5","section":"Examples"},{"text":"\\[-\\frac{i g^{\\mu \\nu }}{p^2}\\]","anchor":"cb5-1","section":"Examples"}]