[{"text":"B1[pp, ma^2, mb^2] the Passarino-Veltman B_1-function. All arguments are scalars and have dimension mass squared.","anchor":"b1"},{"text":"Overview, B0, B00, B11, PaVe, PaVeReduce.","anchor":"see-also","section":"See also"},{"text":"B1[SPD[p], m^2, M^2]","anchor":"cb1","section":"Examples"},{"text":"\\[-\\frac{\\left(m^2-M^2+p^2\\right) \\;\\text{B}_0\\left(p^2,m^2,M^2\\right)}{2 p^2}+\\frac{\\text{A}_0\\left(m^2\\right)}{2 p^2}-\\frac{\\text{A}_0\\left(M^2\\right)}{2 p^2}\\]","anchor":"cb1-1","section":"Examples"},{"text":"B1[SPD[p], m^2, M^2, BReduce -> False]","anchor":"cb2","section":"Examples"},{"text":"\\text{B}_1\\left(p^2,m^2,M^2\\right)","anchor":"cb2-1","section":"Examples"},{"text":"B1[SP[p], m^2, m^2]","anchor":"cb3","section":"Examples"},{"text":"\\[-\\frac{1}{2} \\;\\text{B}_0\\left(\\overline{p}^2,m^2,m^2\\right)\\]","anchor":"cb3-1","section":"Examples"},{"text":"B1[SPD[p], m^2, m^2, BReduce -> False]","anchor":"cb4","section":"Examples"},{"text":"\\text{B}_1\\left(p^2,m^2,m^2\\right)","anchor":"cb4-1","section":"Examples"},{"text":"B1[m^2, m^2, 0]","anchor":"cb5","section":"Examples"},{"text":"\\[\\frac{\\text{A}_0\\left(m^2\\right)}{2 m^2}-\\text{B}_0\\left(m^2,0,m^2\\right)\\]","anchor":"cb5-1","section":"Examples"},{"text":"B1[m^2, m^2, 0, BReduce -> False]","anchor":"cb6","section":"Examples"},{"text":"\\text{B}_1\\left(m^2,m^2,0\\right)","anchor":"cb6-1","section":"Examples"},{"text":"B1[0, 0, m^2]","anchor":"cb7","section":"Examples"},{"text":"\\[\\text{B}_1\\left(0,0,m^2\\right)\\]","anchor":"cb7-1","section":"Examples"},{"text":"B1[pp, SmallVariable[SMP[\"m_e\"]^2], Subsuperscript[m, 2, 2]]","anchor":"cb8","section":"Examples"},{"text":"\\[-\\frac{(\\text{pp}-m_2^2) \\;\\text{B}_0\\left(\\text{pp},m_e^2,m_2^2\\right)}{2 \\;\\text{pp}}-\\frac{\\text{A}_0(m_2^2)}{2 \\;\\text{pp}}\\]","anchor":"cb8-1","section":"Examples"}]