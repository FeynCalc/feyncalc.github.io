[{"text":"CSISE[p] can be used as input for D-4-dimensional \\sigma^i p^i with D-4-dimensional Cartesian vector p and is transformed into PauliSigma[CartesianMomentum[p,D-4],D-4] by FeynCalcInternal.","anchor":"csise"},{"text":"Overview, PauliSigma.","anchor":"see-also","section":"See also"},{"text":"CSISE[p]","anchor":"cb1","section":"Examples"},{"text":"\\[\\hat{\\sigma }\\cdot \\hat{p}\\]","anchor":"cb1-1","section":"Examples"},{"text":"CSISE[p] // FCI // StandardForm (*PauliSigma[CartesianMomentum[p, -4 + D], -4 + D]*)","anchor":"cb2","section":"Examples"},{"text":"CSISE[p, q, r, s]","anchor":"cb3","section":"Examples"},{"text":"\\[\\left(\\hat{\\sigma }\\cdot \\hat{p}\\right).\\left(\\hat{\\sigma }\\cdot \\hat{q}\\right).\\left(\\hat{\\sigma }\\cdot \\hat{r}\\right).\\left(\\hat{\\sigma }\\cdot \\hat{s}\\right)\\]","anchor":"cb3-1","section":"Examples"},{"text":"CSISE[p, q, r, s] // StandardForm (*CSISE[p] . CSISE[q] . CSISE[r] . CSISE[s]*)","anchor":"cb4","section":"Examples"}]