[{"text":"ToLightConeComponents[expr, n, nb] rewrites all Dirac matrices, scalar products, 4-vectors and metric tensors in terms of their component along the lightcone directions n and nb","anchor":"tolightconecomponents"},{"text":"Using the option NotMomentum one can specify that quantities containing the listed 4-momenta should be left untouched.","anchor":"tolightconecomponents"},{"text":"Overview, ExpandScalarProduct, LightConePerpendicularComponent.","anchor":"see-also","section":"See also"},{"text":"ToLightConeComponents[SP[a, b], n, nb]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{1}{2} \\left(\\overline{a}\\cdot \\overline{\\text{nb}}\\right) \\left(\\overline{b}\\cdot \\overline{n}\\right)+\\frac{1}{2} \\left(\\overline{a}\\cdot \\overline{n}\\right) \\left(\\overline{b}\\cdot \\overline{\\text{nb}}\\right)+\\overline{a}\\cdot \\overline{b}_{\\perp }\\]","anchor":"cb1-1","section":"Examples"},{"text":"ToLightConeComponents[FV[p, \\[Mu]], n, nb]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{2} \\overline{\\text{nb}}^{\\mu } \\left(\\overline{n}\\cdot \\overline{p}\\right)+\\frac{1}{2} \\overline{n}^{\\mu } \\left(\\overline{\\text{nb}}\\cdot \\overline{p}\\right)+\\overline{p}^{\\mu }{}_{\\perp }\\]","anchor":"cb2-1","section":"Examples"},{"text":"ToLightConeComponents[GA[\\[Mu]], n, nb]","anchor":"cb3","section":"Examples"},{"text":"\\[\\bar{\\gamma }^{\\mu }{}_{\\perp }+\\frac{1}{2} \\overline{n}^{\\mu } \\bar{\\gamma }\\cdot \\overline{\\text{nb}}+\\frac{1}{2} \\overline{\\text{nb}}^{\\mu } \\bar{\\gamma }\\cdot \\overline{n}\\]","anchor":"cb3-1","section":"Examples"},{"text":"ToLightConeComponents[GS[p], n, nb]","anchor":"cb4","section":"Examples"},{"text":"\\[\\frac{1}{2} \\left(\\overline{n}\\cdot \\overline{p}\\right) \\bar{\\gamma }\\cdot \\overline{\\text{nb}}+\\frac{1}{2} \\bar{\\gamma }\\cdot \\overline{n} \\left(\\overline{\\text{nb}}\\cdot \\overline{p}\\right)+\\bar{\\gamma }\\cdot \\overline{p}_{\\perp }\\]","anchor":"cb4-1","section":"Examples"}]