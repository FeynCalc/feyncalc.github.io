[{"text":"Uncontract[exp, q1, q2, ...] uncontracts Eps and DiracGamma.","anchor":"uncontract"},{"text":"Uncontract[exp, q1, q2, Pair -> {p}] uncontracts also \\(p \\cdot q_1\\) and p \\cdot q_2;","anchor":"uncontract"},{"text":"The option Pair -> All uncontracts all momenta.","anchor":"uncontract"},{"text":"Overview, Contract.","anchor":"see-also","section":"See also"},{"text":"LC[\\[Mu], \\[Nu]][p, q] Uncontract[%, p]","anchor":"cb1","section":"Examples"},{"text":"\\[\\bar{\\epsilon }^{\\mu \\nu \\overline{p}\\overline{q}}\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[\\overline{p}^{\\text{\\$AL}(\\text{\\$11})} \\bar{\\epsilon }^{\\mu \\nu \\;\\text{\\$AL}(\\text{\\$11})\\overline{q}}\\]","anchor":"cb1-3","section":"Examples"},{"text":"GS[p] Uncontract[%, p]","anchor":"cb2","section":"Examples"},{"text":"\\[\\bar{\\gamma }\\cdot \\overline{p}\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[\\bar{\\gamma }^{\\text{\\$AL}(\\text{\\$12})} \\overline{p}^{\\text{\\$AL}(\\text{\\$12})}\\]","anchor":"cb2-3","section":"Examples"},{"text":"Uncontract[LC[\\[Mu], \\[Nu]][p, q], p, q]","anchor":"cb3","section":"Examples"},{"text":"\\[\\overline{p}^{\\text{\\$AL}(\\text{\\$14})} \\overline{q}^{\\text{\\$AL}(\\text{\\$13})} \\left(-\\bar{\\epsilon }^{\\mu \\nu \\;\\text{\\$AL}(\\text{\\$13})\\text{\\$AL}(\\text{\\$14})}\\right)\\]","anchor":"cb3-1","section":"Examples"},{"text":"By default scalar products are not uncontracted.","anchor":"cb3-1","section":"Examples"},{"text":"Uncontract[SP[p, q], q]","anchor":"cb4","section":"Examples"},{"text":"\\[\\overline{p}\\cdot \\overline{q}\\]","anchor":"cb4-1","section":"Examples"},{"text":"Use the option Pair->All to make the function take care of the scalar products as well","anchor":"cb4-1","section":"Examples"},{"text":"Uncontract[SP[p, q], q, Pair -> All]","anchor":"cb5","section":"Examples"},{"text":"\\[\\overline{p}^{\\text{\\$AL}(\\text{\\$15})} \\overline{q}^{\\text{\\$AL}(\\text{\\$15})}\\]","anchor":"cb5-1","section":"Examples"},{"text":"Uncontract[SP[p, q]^2, q, Pair -> All]","anchor":"cb6","section":"Examples"},{"text":"\\[\\overline{p}^{\\text{\\$AL}(\\text{\\$16})} \\overline{p}^{\\text{\\$AL}(\\text{\\$17})} \\overline{q}^{\\text{\\$AL}(\\text{\\$16})} \\overline{q}^{\\text{\\$AL}(\\text{\\$17})}\\]","anchor":"cb6-1","section":"Examples"},{"text":"For Cartesian scalar products you need to use the option CartesianPair->All","anchor":"cb6-1","section":"Examples"},{"text":"Uncontract[CSP[p, q], q, Pair -> All]","anchor":"cb7","section":"Examples"},{"text":"\\[\\overline{p}\\cdot \\overline{q}\\]","anchor":"cb7-1","section":"Examples"},{"text":"Uncontract[CSP[p, q], q, CartesianPair -> All]","anchor":"cb8","section":"Examples"},{"text":"\\[\\overline{p}^{\\text{\\$AL}(\\text{\\$18})} \\overline{q}^{\\text{\\$AL}(\\text{\\$18})}\\]","anchor":"cb8-1","section":"Examples"}]