[{"text":"FCSymmetrize[expr, {a1, a2, ...}] symmetrizes expr with respect to the variables a1,a2, ....","anchor":"fcsymmetrize"},{"text":"Overview, FCAntiSymmetrize.","anchor":"see-also","section":"See also"},{"text":"FCSymmetrize[f[a, b], {a, b}]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{1}{2} (f(a,b)+f(b,a))\\]","anchor":"cb1-1","section":"Examples"},{"text":"FCSymmetrize[f[x, y, z], {x, y, z}]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{6} (f(x,y,z)+f(x,z,y)+f(y,x,z)+f(y,z,x)+f(z,x,y)+f(z,y,x))\\]","anchor":"cb2-1","section":"Examples"}]