[{"text":"FCFactorOut[exp, pref] factors out pref out of exp. This is often needed to bring exp into a particular form that Mathematica refuses to give.","anchor":"fcfactorout"},{"text":"Overview, Collect2.","anchor":"see-also","section":"See also"},{"text":"FCFactorOut[(a + 3 b), 3 b]","anchor":"cb1","section":"Examples"},{"text":"\\[3 b \\left(\\frac{a}{3 b}+1\\right)\\]","anchor":"cb1-1","section":"Examples"},{"text":"FCFactorOut[(a + 3 b), 3 b, Head -> hold]","anchor":"cb2","section":"Examples"},{"text":"\\[3 b \\;\\text{hold}\\left(\\frac{a}{3 b}+1\\right)\\]","anchor":"cb2-1","section":"Examples"},{"text":"FCFactorOut is also an option of Collect2","anchor":"cb2-1","section":"Examples"},{"text":"x^2 + 6 y Collect2[%, {x, y}, FCFactorOut -> 3]","anchor":"cb3","section":"Examples"},{"text":"\\[x^2+6 y\\]","anchor":"cb3-3","section":"Examples"},{"text":"\\[3 \\left(\\frac{x^2}{3}+2 y\\right)\\]","anchor":"cb3-3","section":"Examples"}]