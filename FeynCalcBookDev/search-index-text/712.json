[{"text":"MomentumExpand[expr] expands Momentum[a+b+ ...] in expr into Momentum[a] + Momentum[b] + ....","anchor":"momentumexpand"},{"text":"Overview, ExpandScalarProduct, MomentumCombine.","anchor":"see-also","section":"See also"},{"text":"MomentumExpand[Momentum[p + q]] // StandardForm (*Momentum[p] + Momentum[q]*)","anchor":"cb1","section":"Examples"},{"text":"ScalarProduct[p + q, r]","anchor":"cb2","section":"Examples"},{"text":"\\[(\\overline{p}+\\overline{q})\\cdot \\overline{r}\\]","anchor":"cb2-1","section":"Examples"},{"text":"ScalarProduct[p + q, r] // StandardForm (*Pair[Momentum[p + q], Momentum[r]]*)","anchor":"cb3","section":"Examples"},{"text":"ex = MomentumExpand[ScalarProduct[p + q, r]]","anchor":"cb4","section":"Examples"},{"text":"\\[(\\overline{p}+\\overline{q})\\cdot \\overline{r}\\]","anchor":"cb4-1","section":"Examples"},{"text":"ex // StandardForm (*Pair[Momentum[p] + Momentum[q], Momentum[r]]*)","anchor":"cb5","section":"Examples"},{"text":"ex = MomentumExpand[ScalarProduct[p + q, r - p]]","anchor":"cb6","section":"Examples"},{"text":"\\[(\\overline{p}+\\overline{q})\\cdot (\\overline{r}-\\overline{p})\\]","anchor":"cb6-1","section":"Examples"},{"text":"ex // StandardForm (*Pair[Momentum[p] + Momentum[q], -Momentum[p] + Momentum[r]]*)","anchor":"cb7","section":"Examples"}]