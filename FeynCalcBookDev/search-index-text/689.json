[{"text":"\\[\\bar{g}^{\\mu \\nu } \\bar{g}^{\\mu \\rho }{}_{\\perp }\\]","anchor":"cb14-2","section":"Notation for light-cone components"},{"text":"\\[\\bar{g}^{\\nu \\rho }{}_{\\perp }\\]","anchor":"cb14-2","section":"Notation for light-cone components"},{"text":"The dimensionality of the perpendicular component is 2 in 4-dimensions and D-2 in D-dimensions","anchor":"cb14-2","section":"Notation for light-cone components"},{"text":"MT[\\[Mu], \\[Nu]] MTLR[\\[Mu], \\[Nu]] % // Contract","anchor":"cb15","section":"Notation for light-cone components"},{"text":"\\[\\bar{g}^{\\mu \\nu } \\bar{g}^{\\mu \\nu }{}_{\\perp }\\]","anchor":"cb15-2","section":"Notation for light-cone components"},{"text":"\\[2\\]","anchor":"cb15-2","section":"Notation for light-cone components"},{"text":"MTD[\\[Mu], \\[Nu]] MTLRD[\\[Mu], \\[Nu]] % // Contract","anchor":"cb16","section":"Notation for light-cone components"},{"text":"\\[g^{\\mu \\nu } g^{\\mu \\nu }{}_{\\perp }\\]","anchor":"cb16-2","section":"Notation for light-cone components"},{"text":"\\[D-2\\]","anchor":"cb16-2","section":"Notation for light-cone components"},{"text":"Dirac algebra involving matrices contracted to light-cone momenta or having particular light-cone components is fully supported. The general strategy followed by DiracSimplify is to move all perpendicular components to the very right of the chain.","anchor":"dirac-matrices-with-light-cone-components","section":"Dirac matrices with light-cone components"},{"text":"ex1 = GALR[p] . GA[\\[Mu], \\[Nu]]","anchor":"cb17","section":"Dirac matrices with light-cone components"},{"text":"\\[\\bar{\\gamma }^p{}_{\\perp }.\\bar{\\gamma }^{\\mu }.\\bar{\\gamma }^{\\nu }\\]","anchor":"cb17-1","section":"Dirac matrices with light-cone components"},{"text":"ex1 // DiracSimplify","anchor":"cb18","section":"Dirac matrices with light-cone components"},{"text":"ex2 = GALR[p] . GA[\\[Mu], \\[Nu]] . GALR[p]","anchor":"cb19","section":"Dirac matrices with light-cone components"},{"text":"\\[\\bar{\\gamma }^p{}_{\\perp }.\\bar{\\gamma }^{\\mu }.\\bar{\\gamma }^{\\nu }.\\bar{\\gamma }^p{}_{\\perp }\\]","anchor":"cb19-1","section":"Dirac matrices with light-cone components"},{"text":"ex2 // DiracSimplify","anchor":"cb20","section":"Dirac matrices with light-cone components"},{"text":"\\[-2 \\bar{\\gamma }^{\\mu }{}_{\\perp }.\\bar{\\gamma }^{\\nu }{}_{\\perp }+4 \\bar{g}^{\\mu \\nu }{}_{\\perp }+\\frac{1}{2} \\overline{n}^{\\nu } \\overline{\\text{nb}}^{\\mu } \\left(\\bar{\\gamma }\\cdot \\overline{n}\\right).\\left(\\bar{\\gamma }\\cdot \\overline{\\text{nb}}\\right)-\\frac{1}{2} \\overline{n}^{\\mu } \\overline{\\text{nb}}^{\\nu } \\left(\\bar{\\gamma }\\cdot \\overline{n}\\right).\\left(\\bar{\\gamma }\\cdot \\overline{\\text{nb}}\\right)+2 \\overline{n}^{\\mu } \\overline{\\text{nb}}^{\\nu }\\]","anchor":"cb20-1","section":"Dirac matrices with light-cone components"},{"text":"Notice that when entering particular light-cone components of Dirac matrices, the standard trick for entering multiple indices does not work. This is because the 2nd and 3rd arguments are reserved for user-specified light-cone vectors","anchor":"cb20-1","section":"Dirac matrices with light-cone components"},{"text":"GALR[mu1, myN, myNB] % // FCI // StandardForm","anchor":"cb21","section":"Dirac matrices with light-cone components"},{"text":"\\[\\bar{\\gamma }^{\\text{mu1}}{}_{\\perp }\\]","anchor":"cb21-2","section":"Dirac matrices with light-cone components"},{"text":"(*DiracGamma[LightConePerpendicularComponent[LorentzIndex[mu1], Momentum[myN], Momentum[myNB]]]*)","anchor":"cb22","section":"Dirac matrices with light-cone components"},{"text":"Instead, you should put your list of indices into curly brackets","anchor":"cb22-1","section":"Dirac matrices with light-cone components"},{"text":"GALR[{\\[Mu], \\[Nu], \\[Rho]}]","anchor":"cb23","section":"Dirac matrices with light-cone components"},{"text":"\\[\\bar{\\gamma }^{\\mu }{}_{\\perp }.\\bar{\\gamma }^{\\nu }{}_{\\perp }.\\bar{\\gamma }^{\\rho }{}_{\\perp }\\]","anchor":"cb23-1","section":"Dirac matrices with light-cone components"},{"text":"ex3 = GALR[p] . GALR[{\\[Mu], \\[Nu]}] . GALR[p]","anchor":"cb24","section":"Dirac matrices with light-cone components"},{"text":"\\[\\bar{\\gamma }^p{}_{\\perp }.\\bar{\\gamma }^{\\mu }{}_{\\perp }.\\bar{\\gamma }^{\\nu }{}_{\\perp }.\\bar{\\gamma }^p{}_{\\perp }\\]","anchor":"cb24-1","section":"Dirac matrices with light-cone components"},{"text":"ex3 // DiracSimplify","anchor":"cb25","section":"Dirac matrices with light-cone components"},{"text":"\\[4 \\bar{g}^{\\mu \\nu }{}_{\\perp }-2 \\bar{\\gamma }^{\\mu }{}_{\\perp }.\\bar{\\gamma }^{\\nu }{}_{\\perp }\\]","anchor":"cb25-1","section":"Dirac matrices with light-cone components"},{"text":"ex4 = DiracTrace[GA[\\[Rho], \\[Sigma]] . GALR[{\\[Mu], \\[Nu]}]]","anchor":"cb26","section":"Dirac matrices with light-cone components"},{"text":"\\[\\text{tr}\\left(\\bar{\\gamma }^{\\rho }.\\bar{\\gamma }^{\\sigma }.\\bar{\\gamma }^{\\mu }{}_{\\perp }.\\bar{\\gamma }^{\\nu }{}_{\\perp }\\right)\\]","anchor":"cb26-1","section":"Dirac matrices with light-cone components"},{"text":"ex4 // DiracSimplify","anchor":"cb27","section":"Dirac matrices with light-cone components"},{"text":"\\[4 \\bar{g}^{\\mu \\sigma }{}_{\\perp } \\bar{g}^{\\nu \\rho }{}_{\\perp }-4 \\bar{g}^{\\mu \\rho }{}_{\\perp } \\bar{g}^{\\nu \\sigma }{}_{\\perp }+4 \\bar{g}^{\\rho \\sigma } \\bar{g}^{\\mu \\nu }{}_{\\perp }\\]","anchor":"cb27-1","section":"Dirac matrices with light-cone components"}]