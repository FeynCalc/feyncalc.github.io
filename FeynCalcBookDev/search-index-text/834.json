[{"text":"QuarkGluonVertex[mu, a] gives the Feynman rule for the quark-gluon vertex.","anchor":"quarkgluonvertex"},{"text":"QGV can be used as an abbreviation of QuarkGluonVertex.","anchor":"quarkgluonvertex"},{"text":"The dimension and the name of the coupling constant are determined by the options Dimension and CouplingConstant.","anchor":"quarkgluonvertex"},{"text":"Overview, GluonVertex.","anchor":"see-also","section":"See also"},{"text":"QuarkGluonVertex[\\[Mu], a, Explicit -> True]","anchor":"cb1","section":"Examples"},{"text":"\\[i g_s T^a.\\gamma ^{\\mu }\\]","anchor":"cb1-1","section":"Examples"},{"text":"QGV[\\[Mu], a]","anchor":"cb2","section":"Examples"},{"text":"\\[Q_a^{\\mu }\\]","anchor":"cb2-1","section":"Examples"},{"text":"Explicit[%]","anchor":"cb3","section":"Examples"},{"text":"\\[i g_s T^a.\\gamma ^{\\mu }\\]","anchor":"cb3-1","section":"Examples"}]