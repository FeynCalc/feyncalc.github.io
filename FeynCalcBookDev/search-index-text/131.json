[{"text":"CartesianToLorentz[exp] rewrites Cartesian tensors in form of Lorentz tensors (when possible). Using options one can specify which types of tensors should be converted.","anchor":"cartesiantolorentz"},{"text":"Overview, LorentzToCartesian.","anchor":"see-also","section":"See also"},{"text":"CGS[p] % // CartesianToLorentz","anchor":"cb1","section":"Examples"},{"text":"\\[\\overline{\\gamma }\\cdot \\overline{p}\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[p^0 \\bar{\\gamma }^0-\\bar{\\gamma }\\cdot \\overline{p}\\]","anchor":"cb1-3","section":"Examples"},{"text":"CSP[p, q] % // CartesianToLorentz","anchor":"cb2","section":"Examples"},{"text":"\\[\\overline{p}\\cdot \\overline{q}\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[p^0 q^0-\\overline{p}\\cdot \\overline{q}\\]","anchor":"cb2-3","section":"Examples"}]