[{"text":"MTLND[mu,nu,n,nb] denotes the positive component in the lightcone decomposition of the metric tensor g^{\\mu \\nu} along the vectors n and nbin \\(D\\) dimensions. It corresponds to \\(\\frac{1}{2} n^{\\mu} \\bar{n}^\\nu\\).","anchor":"mtlnd"},{"text":"Overview, Pair, FVLPD, FVLND, FVLRD, SPLPD, SPLND, SPLRD, MTLPD, MTLRD.","anchor":"see-also","section":"See also"},{"text":"MTLND[\\[Mu], \\[Nu], n, nb]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{n^{\\mu } \\;\\text{nb}^{\\nu }}{2}\\]","anchor":"cb1-1","section":"Examples"},{"text":"StandardForm[MTLND[\\[Mu], \\[Nu], n, nb] // FCI]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{2} \\;\\text{Pair}[\\text{LorentzIndex}[\\mu ,D],\\text{Momentum}[n,D]] \\;\\text{Pair}[\\text{LorentzIndex}[\\nu ,D],\\text{Momentum}[\\text{nb},D]]\\]","anchor":"cb2-1","section":"Examples"},{"text":"MTLND[\\[Mu], \\[Nu], n, nb] FVD[p, \\[Mu]] // Contract","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{1}{2} \\;\\text{nb}^{\\nu } (n\\cdot p)\\]","anchor":"cb3-1","section":"Examples"},{"text":"MTLND[\\[Mu], \\[Nu], n, nb] FVD[p, \\[Nu]] // Contract","anchor":"cb4","section":"Examples"},{"text":"\\[\\frac{1}{2} n^{\\mu } (\\text{nb}\\cdot p)\\]","anchor":"cb4-1","section":"Examples"},{"text":"MTLND[\\[Mu], \\[Nu], n, nb] FVD[n, \\[Nu]] // Contract","anchor":"cb5","section":"Examples"},{"text":"\\[\\frac{1}{2} n^{\\mu } (n\\cdot \\;\\text{nb})\\]","anchor":"cb5-1","section":"Examples"},{"text":"MTLND[\\[Mu], \\[Nu], n, nb] FVD[n, \\[Nu]] // Contract","anchor":"cb7","section":"Examples"},{"text":"\\[n^{\\mu }\\]","anchor":"cb7-1","section":"Examples"},{"text":"FCClearScalarProducts[]","anchor":"cb8","section":"Examples"}]