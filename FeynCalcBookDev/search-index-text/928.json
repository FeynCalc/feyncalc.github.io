[{"text":"SUNF[a, b, c] are the structure constants of SU(N). The arguments a, b, c should be of symbolic type.","anchor":"sunf"},{"text":"Overview, SUND, SUNDelta, SUNIndex, SUNSimplify, SUNT.","anchor":"see-also","section":"See also"},{"text":"SUNF[a, b, c] x + SUNF[b, a, c] SUNSimplify[%]","anchor":"cb1","section":"Examples"},{"text":"\\[x f^{abc}+f^{bac}\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[(x-1) f^{abc}\\]","anchor":"cb1-3","section":"Examples"},{"text":"SUNF[a, a, b] SUNSimplify[%]","anchor":"cb2","section":"Examples"},{"text":"\\[f^{aab}\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[0\\]","anchor":"cb2-3","section":"Examples"},{"text":"This is a consequence of the usual choice for the normalization of the \\(T_a\\) generators.","anchor":"cb2-3","section":"Examples"},{"text":"SUNF[a, b, c, Explicit -> True]","anchor":"cb3","section":"Examples"},{"text":"\\[2 i \\left(\\text{tr}\\left(T^a.T^c.T^b\\right)-\\text{tr}\\left(T^a.T^b.T^c\\right)\\right)\\]","anchor":"cb3-1","section":"Examples"},{"text":"SUNSimplify[SUNF[a, b, c] SUNF[a, b, d]]","anchor":"cb4","section":"Examples"},{"text":"\\[C_A \\delta ^{cd}\\]","anchor":"cb4-1","section":"Examples"},{"text":"SUNSimplify[SUNF[a, b, c], Explicit -> True]","anchor":"cb5","section":"Examples"},{"text":"\\[f^{abc}\\]","anchor":"cb5-1","section":"Examples"},{"text":"SUNF[a, b, c] // StandardForm (*SUNF[a, b, c]*)","anchor":"cb6","section":"Examples"},{"text":"SUNF[a, b, c] // FCI // StandardForm (*SUNF[SUNIndex[a], SUNIndex[b], SUNIndex[c]]*)","anchor":"cb7","section":"Examples"},{"text":"SUNF[a, b, c] // FCI // FCE // StandardForm (*SUNF[a, b, c]*)","anchor":"cb8","section":"Examples"},{"text":"SUNF[b, a, c] % // FCI","anchor":"cb9","section":"Examples"},{"text":"\\[f^{bac}\\]","anchor":"cb9-3","section":"Examples"},{"text":"\\[-f^{abc}\\]","anchor":"cb9-3","section":"Examples"}]