[{"text":"SISD[p] can be used as input for D-1-dimensional \\sigma^{\\mu } p_{\\mu } with D-dimensional Lorentz vector p and is transformed into PauliSigma[Momentum[p,D],D-1] by FeynCalcInternal.","anchor":"sisd"},{"text":"Overview, PauliSigma, SIS.","anchor":"see-also","section":"See also"},{"text":"SISD[p]","anchor":"cb1","section":"Examples"},{"text":"\\[\\sigma \\cdot p\\]","anchor":"cb1-1","section":"Examples"},{"text":"SISD[p] // FCI // StandardForm (*PauliSigma[Momentum[p, D], -1 + D]*)","anchor":"cb2","section":"Examples"},{"text":"SISD[p, q, r, s]","anchor":"cb3","section":"Examples"},{"text":"\\[(\\sigma \\cdot p).(\\sigma \\cdot q).(\\sigma \\cdot r).(\\sigma \\cdot s)\\]","anchor":"cb3-1","section":"Examples"},{"text":"SISD[p, q, r, s] // StandardForm (*SISD[p] . SISD[q] . SISD[r] . SISD[s]*)","anchor":"cb4","section":"Examples"},{"text":"SISD[q] . (SISD[p] + m) . SISD[q]","anchor":"cb5","section":"Examples"},{"text":"\\[(\\sigma \\cdot q).(m+\\sigma \\cdot p).(\\sigma \\cdot q)\\]","anchor":"cb5-1","section":"Examples"}]