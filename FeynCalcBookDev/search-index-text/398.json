[{"text":"FCLoopFactorizinQI[int, topo] checks whether the given loop integral factorizes or not. The input can be made integrals in the GLI or FAD notation.","anchor":"fcloopfactorizingq"},{"text":"Overview, FCLoopFactorizingSplit, FCLoopCreateFactorizingRules.","anchor":"see-also","section":"See also"},{"text":"FCLoopFactorizingQ[FAD[{k, m}], {k}]","anchor":"cb1","section":"Examples"},{"text":"\\[\\text{False}\\]","anchor":"cb1-1","section":"Examples"},{"text":"FCLoopFactorizingQ[FAD[{k1, m1}, {k2, m2}, {k1 - k2}], {k1, k2}]","anchor":"cb2","section":"Examples"},{"text":"\\[\\text{False}\\]","anchor":"cb2-1","section":"Examples"},{"text":"FCLoopFactorizingQ[FAD[{k1, m1}, {k2, m2}], {k1, k2}]","anchor":"cb3","section":"Examples"},{"text":"\\[\\text{True}\\]","anchor":"cb3-1","section":"Examples"},{"text":"int = FAD[{k1, m1}, {k1 - p1}, {k2, m2}, {k2 - p2}] /. k1 -> k1 + k2","anchor":"cb4","section":"Examples"},{"text":"\\frac{1}{\\left((\\text{k1}+\\text{k2})^2-\\text{m1}^2\\right).(\\text{k1}+\\text{k2}-\\text{p1})^2.\\left(\\text{k2}^2-\\text{m2}^2\\right).(\\text{k2}-\\text{p2})^2}","anchor":"cb4-1","section":"Examples"},{"text":"FCLoopFactorizingQ[int, {k1, k2}]","anchor":"cb5","section":"Examples"},{"text":"\\[\\text{True}\\]","anchor":"cb5-1","section":"Examples"}]