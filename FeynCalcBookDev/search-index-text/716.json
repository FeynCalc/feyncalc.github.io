[{"text":"MTLN[mu,nu,n,nb] denotes the positive component in the lightcone decomposition of the metric tensor g^{\\mu \\nu} along the vectors n and nb. It corresponds to \\frac{1}{2} n^{\\mu} \\bar{n}^\\nu.","anchor":"mtln"},{"text":"Overview, Pair, FVLP, FVLN, FVLR, SPLP, SPLN, SPLR, MTLP, MTLR.","anchor":"see-also","section":"See also"},{"text":"MTLN[\\[Mu], \\[Nu], n, nb]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{1}{2} \\overline{n}^{\\mu } \\overline{\\text{nb}}^{\\nu }\\]","anchor":"cb1-1","section":"Examples"},{"text":"StandardForm[MTLN[\\[Mu], \\[Nu], n, nb] // FCI]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{2} \\;\\text{Pair}[\\text{LorentzIndex}[\\mu ],\\text{Momentum}[n]] \\;\\text{Pair}[\\text{LorentzIndex}[\\nu ],\\text{Momentum}[\\text{nb}]]\\]","anchor":"cb2-1","section":"Examples"},{"text":"MTLN[\\[Mu], \\[Nu], n, nb] FV[p, \\[Mu]] // Contract","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{1}{2} \\overline{\\text{nb}}^{\\nu } \\left(\\overline{n}\\cdot \\overline{p}\\right)\\]","anchor":"cb3-1","section":"Examples"},{"text":"MTLN[\\[Mu], \\[Nu], n, nb] FV[p, \\[Nu]] // Contract","anchor":"cb4","section":"Examples"},{"text":"\\[\\frac{1}{2} \\overline{n}^{\\mu } \\left(\\overline{\\text{nb}}\\cdot \\overline{p}\\right)\\]","anchor":"cb4-1","section":"Examples"},{"text":"MTLN[\\[Mu], \\[Nu], n, nb] FV[n, \\[Nu]] // Contract","anchor":"cb5","section":"Examples"},{"text":"\\[\\frac{1}{2} \\overline{n}^{\\mu } \\left(\\overline{n}\\cdot \\overline{\\text{nb}}\\right)\\]","anchor":"cb5-1","section":"Examples"},{"text":"MTLN[\\[Mu], \\[Nu], n, nb] FV[n, \\[Nu]] // Contract","anchor":"cb7","section":"Examples"},{"text":"\\[\\overline{n}^{\\mu }\\]","anchor":"cb7-1","section":"Examples"},{"text":"FCClearScalarProducts[]","anchor":"cb8","section":"Examples"}]