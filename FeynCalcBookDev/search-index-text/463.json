[{"text":"FCMakeSymbols[name, range, type] generates a list or a sequence of symbols (depending on the value of type) by attaching elements of the list range to name.","anchor":"fcmakesymbols"},{"text":"For example, FCMakeSymbols[mu, Range[1, 3], List] returns {mu1,mu2,mu3}.","anchor":"fcmakesymbols"},{"text":"Overview, FCMakeIndex.","anchor":"see-also","section":"See also"},{"text":"FCMakeSymbols[a, Range[1, 4], List]","anchor":"cb1","section":"Examples"},{"text":"\\{\\text{a1},\\text{a2},\\text{a3},\\text{a4}\\}","anchor":"cb1-1","section":"Examples"},{"text":"f[FCMakeSymbols[a, Range[1, 4], Sequence]]","anchor":"cb2","section":"Examples"},{"text":"f(\\text{a1},\\text{a2},\\text{a3},\\text{a4})","anchor":"cb2-1","section":"Examples"},{"text":"f[FCMakeSymbols[a, {1, 3}, Sequence]]","anchor":"cb3","section":"Examples"},{"text":"\\[f(\\text{a1},\\text{a3})\\]","anchor":"cb3-1","section":"Examples"}]