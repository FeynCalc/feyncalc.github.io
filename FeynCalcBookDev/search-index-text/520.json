[{"text":"FermionSpinSum[exp] converts products of closed spinor chains in exp into Dirac traces. Both Dirac and Majorana particles are supported. It is understood, that exp represents a squared amplitude.","anchor":"fermionspinsum"},{"text":"Overview, Spinor, ComplexConjugate, DiracTrace.","anchor":"see-also","section":"See also"},{"text":"FeynCalc uses the customary relativistic normalization of the spinors.","anchor":"examples","section":"Examples"},{"text":"SpinorUBar[Momentum[p], m] . SpinorU[Momentum[p], m] FermionSpinSum[%] DiracSimplify[%]","anchor":"cb1","section":"Examples"},{"text":"\\bar{u}\\left(\\overline{p},m\\right).u\\left(\\overline{p},m\\right)","anchor":"cb1-5","section":"Examples"},{"text":"\\[\\text{tr}\\left(\\bar{\\gamma }\\cdot \\overline{p}+m\\right)\\]","anchor":"cb1-5","section":"Examples"},{"text":"\\[4 m\\]","anchor":"cb1-5","section":"Examples"},{"text":"SpinorVBar[Momentum[p], m] . SpinorV[Momentum[p], m] FermionSpinSum[%] DiracSimplify[%]","anchor":"cb2","section":"Examples"},{"text":"\\bar{v}\\left(\\overline{p},m\\right).v\\left(\\overline{p},m\\right)","anchor":"cb2-5","section":"Examples"},{"text":"\\[\\text{tr}\\left(\\bar{\\gamma }\\cdot \\overline{p}-m\\right)\\]","anchor":"cb2-5","section":"Examples"},{"text":"\\[-4 m\\]","anchor":"cb2-5","section":"Examples"},{"text":"amp = SpinorUBar[k1, m] . GS[p] . GA[5] . SpinorU[p1, m] ampSq = amp ComplexConjugate[amp]","anchor":"cb3","section":"Examples"},{"text":"\\[\\bar{u}(\\text{k1},m).\\left(\\bar{\\gamma }\\cdot \\overline{p}\\right).\\bar{\\gamma }^5.u(\\text{p1},m)\\]","anchor":"cb3-3","section":"Examples"},{"text":"\\[\\bar{u}(\\text{k1},m).\\left(\\bar{\\gamma }\\cdot \\overline{p}\\right).\\bar{\\gamma }^5.u(\\text{p1},m) \\left(-\\left(\\varphi (\\overline{\\text{p1}},m)\\right).\\bar{\\gamma }^5.\\left(\\bar{\\gamma }\\cdot \\overline{p}\\right).\\left(\\varphi (\\overline{\\text{k1}},m)\\right)\\right)\\]","anchor":"cb3-3","section":"Examples"},{"text":"FermionSpinSum[ampSq] DiracSimplify[%]","anchor":"cb4","section":"Examples"},{"text":"\\[-\\text{tr}\\left(\\left(\\bar{\\gamma }\\cdot \\overline{\\text{k1}}+m\\right).\\left(\\bar{\\gamma }\\cdot \\overline{p}\\right).\\bar{\\gamma }^5.\\left(\\bar{\\gamma }\\cdot \\overline{\\text{p1}}+m\\right).\\bar{\\gamma }^5.\\left(\\bar{\\gamma }\\cdot \\overline{p}\\right)\\right)\\]","anchor":"cb4-3","section":"Examples"},{"text":"\\[-4 \\overline{p}^2 \\left(\\overline{\\text{k1}}\\cdot \\overline{\\text{p1}}\\right)+8 \\left(\\overline{\\text{k1}}\\cdot \\overline{p}\\right) \\left(\\overline{p}\\cdot \\overline{\\text{p1}}\\right)-4 m^2 \\overline{p}^2\\]","anchor":"cb4-3","section":"Examples"}]