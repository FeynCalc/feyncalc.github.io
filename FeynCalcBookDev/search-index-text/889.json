[{"text":"SP[a, b] denotes a 4-dimensional scalar product. SP[a, b] is transformed into ScalarProduct[a, b] by FeynCalcInternal.","anchor":"sp"},{"text":"SP[p] is the same as SP[p, p] (=p^2).","anchor":"sp"},{"text":"Overview, ExpandScalarProduct, ScalarProduct.","anchor":"see-also","section":"See also"},{"text":"SP[p, q] + SP[q]","anchor":"cb1","section":"Examples"},{"text":"\\[\\overline{p}\\cdot \\overline{q}+\\overline{q}^2\\]","anchor":"cb1-1","section":"Examples"},{"text":"SP[p - q, q + 2 p]","anchor":"cb2","section":"Examples"},{"text":"\\[(\\overline{p}-\\overline{q})\\cdot (2 \\overline{p}+\\overline{q})\\]","anchor":"cb2-1","section":"Examples"},{"text":"ExpandScalarProduct[ SP[p - q, q + 2 p] ]","anchor":"cb3","section":"Examples"},{"text":"\\[-\\overline{p}\\cdot \\overline{q}+2 \\overline{p}^2-\\overline{q}^2\\]","anchor":"cb3-1","section":"Examples"},{"text":"ExpandScalarProduct[SP[p - q]]","anchor":"cb4","section":"Examples"},{"text":"\\[-2 \\left(\\overline{p}\\cdot \\overline{q}\\right)+\\overline{p}^2+\\overline{q}^2\\]","anchor":"cb4-1","section":"Examples"},{"text":"SP[a, b] // StandardForm (*SP[a, b]*)","anchor":"cb5","section":"Examples"},{"text":"SP[a, b] // FCI // StandardForm (*Pair[Momentum[a], Momentum[b]]*)","anchor":"cb6","section":"Examples"},{"text":"SP[a, b] // FCI // FCE // StandardForm (*SP[a, b]*)","anchor":"cb7","section":"Examples"}]