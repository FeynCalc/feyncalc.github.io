[{"text":"DiracSlash[p] is the contraction p^{\\mu } \\gamma _{\\mu } (FV[p, mu] GA[mu]).","anchor":"diracslash"},{"text":"Products of those can be entered in the form GS[p1, p2, …].","anchor":"diracslash"},{"text":"The shortcut DiracSlash is deprecated, please use GS instead!","anchor":"diracslash"},{"text":"Overview, GS, FCI.","anchor":"see-also","section":"See also"},{"text":"This is \\(q\\)-slash, i.e., \\gamma^{\\mu} q_{\\mu }","anchor":"examples","section":"Examples"},{"text":"DiracSlash[q]","anchor":"cb1","section":"Examples"},{"text":"\\[\\bar{\\gamma }\\cdot \\overline{q}\\]","anchor":"cb1-1","section":"Examples"},{"text":"DiracSlash[p] . DiracSlash[q]","anchor":"cb2","section":"Examples"},{"text":"\\[\\left(\\bar{\\gamma }\\cdot \\overline{p}\\right).\\left(\\bar{\\gamma }\\cdot \\overline{q}\\right)\\]","anchor":"cb2-1","section":"Examples"},{"text":"DiracSlash[p, q]","anchor":"cb3","section":"Examples"},{"text":"\\[\\left(\\bar{\\gamma }\\cdot \\overline{p}\\right).\\left(\\bar{\\gamma }\\cdot \\overline{q}\\right)\\]","anchor":"cb3-1","section":"Examples"},{"text":"DiracSlash is scheduled for removal in the future versions of FeynCalc. The safe alternative is to use GS.","anchor":"cb3-1","section":"Examples"},{"text":"GS[p]","anchor":"cb4","section":"Examples"},{"text":"\\[\\bar{\\gamma }\\cdot \\overline{p}\\]","anchor":"cb4-1","section":"Examples"},{"text":"GSD[p]","anchor":"cb5","section":"Examples"},{"text":"\\[\\gamma \\cdot p\\]","anchor":"cb5-1","section":"Examples"},{"text":"FCI[GS[p]] === DiracSlash[p]","anchor":"cb6","section":"Examples"},{"text":"\\[\\text{True}\\]","anchor":"cb6-1","section":"Examples"},{"text":"FCI[GSD[p]] === DiracSlash[p, Dimension -> D]","anchor":"cb7","section":"Examples"},{"text":"\\[\\text{True}\\]","anchor":"cb7-1","section":"Examples"}]