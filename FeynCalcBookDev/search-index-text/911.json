[{"text":"SPLND[p,q,n,nb] denotes the negative component in the lightcone decomposition of the scalar product p \\cdot q along the vectors n and nb in \\(D\\)-dimensions. It corresponds to \\(\\frac{1}{2} (p \\cdot \\bar{n}) (q \\cdot n)\\).","anchor":"splnd"},{"text":"Overview, Pair, FVLND, FVLPD, FVLRD, SPLPD, SPLRD, MTLPD, MTLND, MTLRD.","anchor":"see-also","section":"See also"},{"text":"SPLND[p, q, n, nb]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{1}{2} (n\\cdot q) (\\text{nb}\\cdot p)\\]","anchor":"cb1-1","section":"Examples"},{"text":"StandardForm[SPLND[p, q, n, nb] // FCI]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{2} \\;\\text{Pair}[\\text{Momentum}[n,D],\\text{Momentum}[q,D]] \\;\\text{Pair}[\\text{Momentum}[\\text{nb},D],\\text{Momentum}[p,D]]\\]","anchor":"cb2-1","section":"Examples"},{"text":"SPLND[p1 + p2 + n, q, n, nb] // ExpandScalarProduct","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{1}{2} (n\\cdot q) (n\\cdot \\;\\text{nb}+\\text{nb}\\cdot \\;\\text{p1}+\\text{nb}\\cdot \\;\\text{p2})\\]","anchor":"cb3-1","section":"Examples"},{"text":"SPLND[p1 + p2 + n, q, n, nb] // ExpandScalarProduct","anchor":"cb5","section":"Examples"},{"text":"\\[\\frac{1}{2} (n\\cdot q) (\\text{nb}\\cdot \\;\\text{p1}+\\text{nb}\\cdot \\;\\text{p2}+2)\\]","anchor":"cb5-1","section":"Examples"},{"text":"FCClearScalarProducts[]","anchor":"cb6","section":"Examples"}]