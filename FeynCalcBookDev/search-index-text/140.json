[{"text":"CGSD[p] is transformed into DiracGamma[CartesianMomentum[p, D-1], D] by FeynCalcInternal.","anchor":"cgsd"},{"text":"CGSD[p,q, ...] is equivalent to CGSD[p].CGSD[q].","anchor":"cgsd"},{"text":"Overview, GSD, DiracGamma.","anchor":"see-also","section":"See also"},{"text":"CGSD[p]","anchor":"cb1","section":"Examples"},{"text":"\\[\\gamma \\cdot p\\]","anchor":"cb1-1","section":"Examples"},{"text":"CGSD[p] // FCI // StandardForm (*DiracGamma[CartesianMomentum[p, -1 + D], D]*)","anchor":"cb2","section":"Examples"},{"text":"CGSD[p, q, r, s]","anchor":"cb3","section":"Examples"},{"text":"\\[(\\gamma \\cdot p).(\\gamma \\cdot q).(\\gamma \\cdot r).(\\gamma \\cdot s)\\]","anchor":"cb3-1","section":"Examples"},{"text":"CGSD[p, q, r, s] // StandardForm (*CGSD[p] . CGSD[q] . CGSD[r] . CGSD[s]*)","anchor":"cb4","section":"Examples"},{"text":"CGSD[q] . (CGSD[p] + m) . CGSD[q]","anchor":"cb5","section":"Examples"},{"text":"\\[(\\gamma \\cdot q).(m+\\gamma \\cdot p).(\\gamma \\cdot q)\\]","anchor":"cb5-1","section":"Examples"}]