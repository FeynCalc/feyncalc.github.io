[{"text":"PauliOrder[exp] orders the Pauli matrices in expr alphabetically.","anchor":"pauliorder"},{"text":"PauliOrder[exp, orderlist] orders the Pauli matrices in expr according to orderlist.","anchor":"pauliorder"},{"text":"Overview","anchor":"see-also","section":"See also"},{"text":"CSI[k, j, i] PauliOrder[%]","anchor":"cb1","section":"Examples"},{"text":"\\[\\overline{\\sigma }^k.\\overline{\\sigma }^j.\\overline{\\sigma }^i\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[2 \\overline{\\sigma }^i \\bar{\\delta }^{jk}-2 \\overline{\\sigma }^j \\bar{\\delta }^{ik}+2 \\overline{\\sigma }^k \\bar{\\delta }^{ij}-\\overline{\\sigma }^i.\\overline{\\sigma }^j.\\overline{\\sigma }^k\\]","anchor":"cb1-3","section":"Examples"},{"text":"CSID[i, j, k] PauliOrder[%]","anchor":"cb2","section":"Examples"},{"text":"\\[\\sigma ^i.\\sigma ^j.\\sigma ^k\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[\\sigma ^i.\\sigma ^j.\\sigma ^k\\]","anchor":"cb2-3","section":"Examples"},{"text":"PauliOrder[%%, {j, i, k}]","anchor":"cb3","section":"Examples"},{"text":"\\[2 \\sigma ^k \\delta ^{ij}-\\sigma ^j.\\sigma ^i.\\sigma ^k\\]","anchor":"cb3-1","section":"Examples"}]