[{"text":"A0ToB0 is an option for A0. If set to True, A0[m^2] is expressed by (1 + B0[0, m^2, m^2]) m^2.","anchor":"a0tob0"},{"text":"Overview, A0, B0, C0, D0, PaVe.","anchor":"see-also","section":"See also"},{"text":"A0[m^2]","anchor":"cb1","section":"Examples"},{"text":"\\[\\text{A}_0\\left(m^2\\right)\\]","anchor":"cb1-1","section":"Examples"},{"text":"A0[m^2, A0ToB0 -> True]","anchor":"cb2","section":"Examples"},{"text":"\\[-\\frac{2 m^2 \\;\\text{B}_0\\left(0,m^2,m^2\\right)}{2-D}\\]","anchor":"cb2-1","section":"Examples"}]