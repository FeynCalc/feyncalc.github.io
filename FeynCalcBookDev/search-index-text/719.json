[{"text":"MTLPD[mu,nu,n,nb] denotes the positive component in the lightcone decomposition of the metric tensor g^{\\mu \\nu} along the vectors n and nb. It corresponds to \\frac{1}{2} \\bar{n}^{\\mu} n^\\nu.","anchor":"mtlpd"},{"text":"Overview, Pair, FVLPD, FVLND, FVLRD, SPLPD, SPLND, SPLRD, MTLND, MTLRD.","anchor":"see-also","section":"See also"},{"text":"MTLPD[\\[Mu], \\[Nu], n, nb]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{n^{\\nu } \\;\\text{nb}^{\\mu }}{2}\\]","anchor":"cb1-1","section":"Examples"},{"text":"StandardForm[MTLPD[\\[Mu], \\[Nu], n, nb] // FCI]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{2} \\;\\text{Pair}[\\text{LorentzIndex}[\\mu ,D],\\text{Momentum}[\\text{nb},D]] \\;\\text{Pair}[\\text{LorentzIndex}[\\nu ,D],\\text{Momentum}[n,D]]\\]","anchor":"cb2-1","section":"Examples"},{"text":"MTLPD[\\[Mu], \\[Nu], n, nb] FVD[p, \\[Mu]] // Contract","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{1}{2} n^{\\nu } (\\text{nb}\\cdot p)\\]","anchor":"cb3-1","section":"Examples"},{"text":"MTLPD[\\[Mu], \\[Nu], n, nb] FVD[p, \\[Nu]] // Contract","anchor":"cb4","section":"Examples"},{"text":"\\[\\frac{1}{2} \\;\\text{nb}^{\\mu } (n\\cdot p)\\]","anchor":"cb4-1","section":"Examples"},{"text":"MTLPD[\\[Mu], \\[Nu], n, nb] FVD[n, \\[Nu]] // Contract","anchor":"cb5","section":"Examples"},{"text":"\\[\\frac{n^2 \\;\\text{nb}^{\\mu }}{2}\\]","anchor":"cb5-1","section":"Examples"},{"text":"MTLPD[\\[Mu], \\[Nu], n, nb] FVD[n, \\[Nu]] // Contract","anchor":"cb7","section":"Examples"},{"text":"\\[0\\]","anchor":"cb7-1","section":"Examples"},{"text":"FCClearScalarProducts[]","anchor":"cb8","section":"Examples"}]