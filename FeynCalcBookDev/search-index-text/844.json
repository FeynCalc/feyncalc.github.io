[{"text":"ScalarProduct[p, q] is the input for the scalar product of two Lorentz vectors p and q.","anchor":"scalarproduct"},{"text":"ScalarProduct[p] is equivalent to ScalarProduct[p, p].","anchor":"scalarproduct"},{"text":"Expansion of sums of momenta in ScalarProduct is done with ExpandScalarProduct.","anchor":"scalarproduct"},{"text":"Scalar products may be set, e.g. via ScalarProduct[a, b] = m^2; but a and b may not contain sums.","anchor":"scalarproduct"},{"text":"ScalarProduct[a] corresponds to ScalarProduct[a,a]","anchor":"scalarproduct"},{"text":"Note that ScalarProduct[a, b] = m^2 actually sets Lorentzian scalar products in different dimensions specified by the value of the SetDimensions option.","anchor":"scalarproduct"},{"text":"It is highly recommended to set ScalarProducts before any calculation. This improves the performance of FeynCalc.","anchor":"scalarproduct"},{"text":"Overview, FCClearScalarProducts, ExpandScalarProduct, Pair, SP, SPD.","anchor":"see-also","section":"See also"},{"text":"ScalarProduct[p, q]","anchor":"cb1","section":"Examples"},{"text":"\\[\\overline{p}\\cdot \\overline{q}\\]","anchor":"cb1-1","section":"Examples"},{"text":"ScalarProduct[p + q, -q]","anchor":"cb2","section":"Examples"},{"text":"\\[-\\left(\\overline{q}\\cdot (\\overline{p}+\\overline{q})\\right)\\]","anchor":"cb2-1","section":"Examples"},{"text":"ScalarProduct[p, p]","anchor":"cb3","section":"Examples"},{"text":"\\[\\overline{p}^2\\]","anchor":"cb3-1","section":"Examples"},{"text":"ScalarProduct[q]","anchor":"cb4","section":"Examples"},{"text":"\\[\\overline{q}^2\\]","anchor":"cb4-1","section":"Examples"},{"text":"ScalarProduct[p, q] // StandardForm (*Pair[Momentum[p], Momentum[q]]*)","anchor":"cb5","section":"Examples"},{"text":"ScalarProduct[p, q, Dimension -> D] // StandardForm (*Pair[Momentum[p, D], Momentum[q, D]]*)","anchor":"cb6","section":"Examples"},{"text":"ScalarProduct[Subscript[p, 1], Subscript[p, 2]] = s/2","anchor":"cb7","section":"Examples"},{"text":"\\[\\frac{s}{2}\\]","anchor":"cb7-1","section":"Examples"},{"text":"ExpandScalarProduct[ ScalarProduct[Subscript[p, 1] - q, Subscript[p, 2] - k]]","anchor":"cb8","section":"Examples"},{"text":"\\[-\\overline{k}\\cdot \\overline{p}_1+\\overline{k}\\cdot \\overline{q}-\\overline{q}\\cdot \\overline{p}_2+\\frac{s}{2}\\]","anchor":"cb8-1","section":"Examples"},{"text":"ScalarProduct[q1] = qq;","anchor":"cb9","section":"Examples"},{"text":"SP[q1]","anchor":"cb10","section":"Examples"},{"text":"\\[\\text{qq}\\]","anchor":"cb10-1","section":"Examples"},{"text":"FCClearScalarProducts[]","anchor":"cb11","section":"Examples"}]