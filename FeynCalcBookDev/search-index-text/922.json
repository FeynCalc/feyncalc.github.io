[{"text":"SumP[k, m] is \\(2^{k-1}\\sum _{i=1}^{2m}\\left(1+(-1)^i\\right)/i^k\\).","anchor":"sump"},{"text":"Overview, SumS, SumT.","anchor":"see-also","section":"See also"},{"text":"SumP[1, m - 1]","anchor":"cb1","section":"Examples"},{"text":"\\[S_1^{'(m-1)}\\]","anchor":"cb1-1","section":"Examples"},{"text":"SumP[2, m - 1]","anchor":"cb2","section":"Examples"},{"text":"\\[S_2^{'(m-1)}\\]","anchor":"cb2-1","section":"Examples"},{"text":"SumP[1, m]","anchor":"cb3","section":"Examples"},{"text":"\\[S_1^{'(m)}\\]","anchor":"cb3-1","section":"Examples"},{"text":"SumP[1, 4]","anchor":"cb4","section":"Examples"},{"text":"\\[\\frac{25}{12}\\]","anchor":"cb4-1","section":"Examples"},{"text":"Explicit[SumP[1, n/2]] % /. n -> 8","anchor":"cb5","section":"Examples"},{"text":"\\[\\frac{1}{2} \\left(1-(-1)^n\\right) S_1\\left(\\frac{n-1}{2}\\right)+\\frac{1}{2} \\left((-1)^n+1\\right) S_1\\left(\\frac{n}{2}\\right)\\]","anchor":"cb5-3","section":"Examples"},{"text":"\\[\\frac{25}{12}\\]","anchor":"cb5-3","section":"Examples"}]