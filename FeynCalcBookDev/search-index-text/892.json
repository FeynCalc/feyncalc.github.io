[{"text":"SPE[a, b] denotes a D-4-dimensional scalar product. SPE[a, b] is transformed into Pair[Momentum[a, -4 + D], Momentum[b, -4 + D]] by FeynCalcInternal.","anchor":"spe"},{"text":"SPE[p] is the same as SPE[p,p] (=p^2).","anchor":"spe"},{"text":"Overview, PD, ExpandScalarProduct, ScalarProduct, SPD.","anchor":"see-also","section":"See also"},{"text":"SPE[p, q] + SPE[q]","anchor":"cb1","section":"Examples"},{"text":"\\[\\hat{p}\\cdot \\hat{q}+\\hat{q}^2\\]","anchor":"cb1-1","section":"Examples"},{"text":"SPE[p - q, q + 2 p]","anchor":"cb2","section":"Examples"},{"text":"\\[(\\hat{p}-\\hat{q})\\cdot (2 \\hat{p}+\\hat{q})\\]","anchor":"cb2-1","section":"Examples"},{"text":"ExpandScalarProduct[ SPE[p - q, q + 2 p] ]","anchor":"cb3","section":"Examples"},{"text":"\\[-\\hat{p}\\cdot \\hat{q}+2 \\hat{p}^2-\\hat{q}^2\\]","anchor":"cb3-1","section":"Examples"},{"text":"ExpandScalarProduct[SPE[p - q]]","anchor":"cb4","section":"Examples"},{"text":"\\[-2 \\left(\\hat{p}\\cdot \\hat{q}\\right)+\\hat{p}^2+\\hat{q}^2\\]","anchor":"cb4-1","section":"Examples"},{"text":"SPE[a, b] // StandardForm (*SPE[a, b]*)","anchor":"cb5","section":"Examples"},{"text":"SPE[a, b] // FCI // StandardForm (*Pair[Momentum[a, -4 + D], Momentum[b, -4 + D]]*)","anchor":"cb6","section":"Examples"},{"text":"SPE[a, b] // FCI // FCE // StandardForm (*SPE[a, b]*)","anchor":"cb7","section":"Examples"},{"text":"FCE[ChangeDimension[SP[p, q], D - 4]] // StandardForm (*SPE[p, q]*)","anchor":"cb8","section":"Examples"}]