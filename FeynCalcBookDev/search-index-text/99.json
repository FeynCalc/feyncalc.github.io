[{"text":"AntiCommutator[x, y] = c defines the anti-commutator of the non commuting objects x and y.","anchor":"anticommutator"},{"text":"Overview, Commutator, CommutatorExplicit, DeclareNonCommutative, DotSimplify.","anchor":"see-also","section":"See also"},{"text":"This declares a and b as noncommutative variables.","anchor":"examples","section":"Examples"},{"text":"DeclareNonCommutative[a, b] AntiCommutator[a, b] CommutatorExplicit[%]","anchor":"cb1","section":"Examples"},{"text":"\\[\\{a,\\medspace b\\}\\]","anchor":"cb1-5","section":"Examples"},{"text":"\\[a.b+b.a\\]","anchor":"cb1-5","section":"Examples"},{"text":"CommutatorExplicit[AntiCommutator[a + b, a - 2 b ]]","anchor":"cb2","section":"Examples"},{"text":"\\[(a-2 b).(a+b)+(a+b).(a-2 b)\\]","anchor":"cb2-1","section":"Examples"},{"text":"DotSimplify[AntiCommutator[a + b, a - 2 b ]]","anchor":"cb3","section":"Examples"},{"text":"\\[-a.b-b.a+2 a.a-4 b.b\\]","anchor":"cb3-1","section":"Examples"},{"text":"DeclareNonCommutative[c, d, ct, dt]","anchor":"cb4","section":"Examples"},{"text":"Defining {c,d} = z results in replacements of c.d by z-d.c.","anchor":"cb4-1","section":"Examples"},{"text":"AntiCommutator[c, d] = z DotSimplify[ d . c . d ]","anchor":"cb5","section":"Examples"},{"text":"\\[z\\]","anchor":"cb5-3","section":"Examples"},{"text":"\\[d z-d.d.c\\]","anchor":"cb5-3","section":"Examples"},{"text":"AntiCommutator[dt, ct] = zt","anchor":"cb6","section":"Examples"},{"text":"\\[\\text{zt}\\]","anchor":"cb6-1","section":"Examples"},{"text":"DotSimplify[dt . ct . dt]","anchor":"cb7","section":"Examples"},{"text":"\\[\\text{dt} \\;\\text{zt}-\\text{ct}.\\text{dt}.\\text{dt}\\]","anchor":"cb7-1","section":"Examples"},{"text":"UnDeclareNonCommutative[a, b, c, d, ct, dt] UnDeclareAllAntiCommutators[]","anchor":"cb8","section":"Examples"}]