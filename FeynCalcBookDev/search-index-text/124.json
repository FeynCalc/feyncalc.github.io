[{"text":"CartesianIndexNames is an option for FCFAConvert, FCCanonicalizeDummyIndices and other functions. It renames the generic dummy Cartesian indices to the indices in the supplied list.","anchor":"cartesianindexnames"},{"text":"Overview, FCFAConvert, FCCanonicalizeDummyIndices, CartesianIndexNames.","anchor":"see-also","section":"See also"},{"text":"CLC[i1, i2, i3] CGA[i1, i2, i3] FCCanonicalizeDummyIndices[%]","anchor":"cb1","section":"Examples"},{"text":"\\[\\overline{\\gamma }^{\\text{i1}}.\\overline{\\gamma }^{\\text{i2}}.\\overline{\\gamma }^{\\text{i3}} \\bar{\\epsilon }^{\\text{i1}\\;\\text{i2}\\;\\text{i3}}\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[\\overline{\\gamma }^{\\text{FCGV}(\\text{ci201})}.\\overline{\\gamma }^{\\text{FCGV}(\\text{ci202})}.\\overline{\\gamma }^{\\text{FCGV}(\\text{ci203})} \\bar{\\epsilon }^{\\text{FCGV}(\\text{ci201})\\text{FCGV}(\\text{ci202})\\text{FCGV}(\\text{ci203})}\\]","anchor":"cb1-3","section":"Examples"},{"text":"CLC[i1, i2, i3] CGA[i1, i2, i3] FCCanonicalizeDummyIndices[%, CartesianIndexNames -> {i, j, k}]","anchor":"cb2","section":"Examples"},{"text":"\\[\\overline{\\gamma }^{\\text{i1}}.\\overline{\\gamma }^{\\text{i2}}.\\overline{\\gamma }^{\\text{i3}} \\bar{\\epsilon }^{\\text{i1}\\;\\text{i2}\\;\\text{i3}}\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[\\overline{\\gamma }^i.\\overline{\\gamma }^j.\\overline{\\gamma }^k \\bar{\\epsilon }^{ijk}\\]","anchor":"cb2-3","section":"Examples"}]