[{"text":"Overview.","anchor":"see-also","section":"See also"},{"text":"FeynCalc allows you to specify the values of scalar products before doing the calculation.","anchor":"manipulations-of-scalar-products","section":"Manipulations of scalar products"},{"text":"SP[p, q] = s;","anchor":"cb1","section":"Manipulations of scalar products"},{"text":"SP[p, q]","anchor":"cb2","section":"Manipulations of scalar products"},{"text":"\\[s\\]","anchor":"cb2-1","section":"Manipulations of scalar products"},{"text":"FV[q, \\[Mu]] FV[q, \\[Nu]] (FV[p, \\[Mu]] FV[p, \\[Nu]] - MT[\\[Mu], \\[Nu]]/SP[p, p]) % // Contract","anchor":"cb3","section":"Manipulations of scalar products"},{"text":"\\[\\overline{q}^{\\mu } \\overline{q}^{\\nu } \\left(\\overline{p}^{\\mu } \\overline{p}^{\\nu }-\\frac{\\bar{g}^{\\mu \\nu }}{\\overline{p}^2}\\right)\\]","anchor":"cb3-2","section":"Manipulations of scalar products"},{"text":"s^2-\\frac{\\overline{q}^2}{\\overline{p}^2}","anchor":"cb3-2","section":"Manipulations of scalar products"},{"text":"To clear the previously set values, use","anchor":"cb3-2","section":"Manipulations of scalar products"},{"text":"FCClearScalarProducts[]","anchor":"cb4","section":"Manipulations of scalar products"},{"text":"SP[p, q]","anchor":"cb5","section":"Manipulations of scalar products"},{"text":"\\[\\overline{p}\\cdot \\overline{q}\\]","anchor":"cb5-1","section":"Manipulations of scalar products"},{"text":"FV[q, \\[Mu]] FV[q, \\[Nu]] (FV[p, \\[Mu]] FV[p, \\[Nu]] - MT[\\[Mu], \\[Nu]]/SP[p, p]) % // Contract","anchor":"cb6","section":"Manipulations of scalar products"},{"text":"\\[\\overline{q}^{\\mu } \\overline{q}^{\\nu } \\left(\\overline{p}^{\\mu } \\overline{p}^{\\nu }-\\frac{\\bar{g}^{\\mu \\nu }}{\\overline{p}^2}\\right)\\]","anchor":"cb6-2","section":"Manipulations of scalar products"},{"text":"\\[(\\overline{p}\\cdot \\overline{q})^2-\\frac{\\overline{q}^2}{\\overline{p}^2}\\]","anchor":"cb6-2","section":"Manipulations of scalar products"},{"text":"A good habit is to always apply FCClearScalarProducts[] before setting the values, like in","anchor":"cb6-2","section":"Manipulations of scalar products"},{"text":"FCClearScalarProducts[]; SP[p1, p1] = m1^2; SP[p2, p2] = m2^2;","anchor":"cb7","section":"Manipulations of scalar products"},{"text":"Setting up the kinematics in advance improves performance of FeynCalc and leads to more compact results. The results with the fully arbitrary kinematics are the most complicated and the longest ones.","anchor":"cb7-3","section":"Manipulations of scalar products"}]