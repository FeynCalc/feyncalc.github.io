[{"text":"GALN[mu,n,nb] denotes the negative component in the lightcone decomposition of the Dirac matrix \\gamma^{\\mu } along the vectors n and nb. It corresponds to \\frac{1}{2} n^{\\mu} (\\gamma \\cdot \\bar{n}).","anchor":"galn"},{"text":"Overview, DiracGamma, GALP, GALR, GSLP, GSLN, GSLR.","anchor":"see-also","section":"See also"},{"text":"GALN[\\[Mu], n, nb]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{1}{2} \\overline{n}^{\\mu } \\bar{\\gamma }\\cdot \\overline{\\text{nb}}\\]","anchor":"cb1-1","section":"Examples"},{"text":"StandardForm[GALN[\\[Mu], n, nb] // FCI]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{2} \\;\\text{DiracGamma}[\\text{Momentum}[\\text{nb}]] \\;\\text{Pair}[\\text{LorentzIndex}[\\mu ],\\text{Momentum}[n]]\\]","anchor":"cb2-1","section":"Examples"},{"text":"GALN[\\[Mu], n, nb] . GALN[\\[Nu], n, nb] // DiracSimplify","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{1}{4} \\overline{\\text{nb}}^2 \\overline{n}^{\\mu } \\overline{n}^{\\nu }\\]","anchor":"cb3-1","section":"Examples"},{"text":"GALN[\\[Mu], n, nb] . GALN[\\[Nu], n, nb] // DiracSimplify","anchor":"cb5","section":"Examples"},{"text":"\\[0\\]","anchor":"cb5-1","section":"Examples"},{"text":"FCClearScalarProducts[]","anchor":"cb6","section":"Examples"}]