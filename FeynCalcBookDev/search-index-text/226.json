[{"text":"DiracMatrix[mu] denotes a Dirac gamma matrix with Lorentz index \\(\\mu\\).","anchor":"diracmatrix"},{"text":"DiracMatrix[mu , nu , ...] is a product of \\gamma matrices with Lorentz indices mu , nu , ...","anchor":"diracmatrix"},{"text":"DiracMatrix[5] is \\(\\gamma ^5\\).","anchor":"diracmatrix"},{"text":"DiracMatrix[6] is \\((1 + \\gamma^5)/2\\).","anchor":"diracmatrix"},{"text":"DiracMatrix[7] is \\((1 - \\gamma^5)/2\\).","anchor":"diracmatrix"},{"text":"The shortcut DiracMatrix is deprecated, please use GA instead!","anchor":"diracmatrix"},{"text":"Overview, GA, FCI.","anchor":"see-also","section":"See also"},{"text":"DiracMatrix[\\[Mu]]","anchor":"cb1","section":"Examples"},{"text":"\\[\\bar{\\gamma }^{\\mu }\\]","anchor":"cb1-1","section":"Examples"},{"text":"This is how to enter the non-commutative product of two. The Mathematica Dot “.” is used as non-commutative multiplication operator.","anchor":"cb1-1","section":"Examples"},{"text":"DiracMatrix[\\[Mu]] . DiracMatrix[\\[Nu]]","anchor":"cb2","section":"Examples"},{"text":"\\[\\bar{\\gamma }^{\\mu }.\\bar{\\gamma }^{\\nu }\\]","anchor":"cb2-1","section":"Examples"},{"text":"DiracMatrix[\\[Alpha]] // StandardForm (*DiracGamma[LorentzIndex[\\[Alpha]]]*)","anchor":"cb3","section":"Examples"},{"text":"DiracMatrix is scheduled for removal in the future versions of FeynCalc. The safe alternative is to use GA.","anchor":"cb3-3","section":"Examples"},{"text":"GA[\\[Mu]]","anchor":"cb4","section":"Examples"},{"text":"\\[\\bar{\\gamma }^{\\mu }\\]","anchor":"cb4-1","section":"Examples"},{"text":"GAD[\\[Mu]]","anchor":"cb5","section":"Examples"},{"text":"\\[\\gamma ^{\\mu }\\]","anchor":"cb5-1","section":"Examples"},{"text":"FCI[GA[\\[Mu]]] === DiracMatrix[\\[Mu]]","anchor":"cb6","section":"Examples"},{"text":"\\[\\text{True}\\]","anchor":"cb6-1","section":"Examples"},{"text":"FCI[GAD[\\[Mu]]] === DiracMatrix[\\[Mu], Dimension -> D]","anchor":"cb7","section":"Examples"},{"text":"\\[\\text{True}\\]","anchor":"cb7-1","section":"Examples"}]