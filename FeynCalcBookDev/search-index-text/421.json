[{"text":"FCLoopGLILowerDimension[gli, topo] lowers the dimension of the given GLI from D to D-2 and expresses it in terms of D-dimensional loop integrals returned in the output.","anchor":"fcloopglilowerdimension"},{"text":"The algorithm is based on the code of the function RaisingDRR from R. Lee’s LiteRed","anchor":"fcloopglilowerdimension"},{"text":"Overview, FCLoopGLIRaiseDimension.","anchor":"see-also","section":"See also"},{"text":"topo = FCTopology[ topo1, {SFAD[p1], SFAD[p2], SFAD[Q - p1 - p2], SFAD[Q - p2], SFAD[Q - p1]}, {p1, p2}, {Q}, {Hold[SPD[Q]] -> qq}, {}]","anchor":"cb1","section":"Examples"},{"text":"FCLoopGLILowerDimension[GLI[topo1, {1, 1, 1, 1, 1}], topo]","anchor":"cb2","section":"Examples"},{"text":"G^{\\text{topo1}}(1,1,1,2,2)+G^{\\text{topo1}}(1,1,2,1,2)+G^{\\text{topo1}}(1,1,2,2,1)+G^{\\text{topo1}}(1,2,1,1,2)+G^{\\text{topo1}}(1,2,2,1,1)+G^{\\text{topo1}}(2,1,1,2,1)+G^{\\text{topo1}}(2,1,2,1,1)+G^{\\text{topo1}}(2,2,1,1,1)","anchor":"cb2-1","section":"Examples"},{"text":"FCLoopGLILowerDimension[GLI[topo1, {n1, n2, n3, 1, 1}], topo]","anchor":"cb3","section":"Examples"},{"text":"G^{\\text{topo1}}(\\text{n1},\\text{n2},\\text{n3},2,2)+\\text{n3} G^{\\text{topo1}}(\\text{n1},\\text{n2},\\text{n3}+1,1,2)+\\text{n3} G^{\\text{topo1}}(\\text{n1},\\text{n2},\\text{n3}+1,2,1)+\\text{n2} G^{\\text{topo1}}(\\text{n1},\\text{n2}+1,\\text{n3},1,2)+\\text{n2} \\;\\text{n3} G^{\\text{topo1}}(\\text{n1},\\text{n2}+1,\\text{n3}+1,1,1)+\\text{n1} G^{\\text{topo1}}(\\text{n1}+1,\\text{n2},\\text{n3},2,1)+\\text{n1} \\;\\text{n3} G^{\\text{topo1}}(\\text{n1}+1,\\text{n2},\\text{n3}+1,1,1)+\\text{n1} \\;\\text{n2} G^{\\text{topo1}}(\\text{n1}+1,\\text{n2}+1,\\text{n3},1,1)","anchor":"cb3-1","section":"Examples"}]