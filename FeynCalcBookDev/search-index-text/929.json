[{"text":"SUNFDelta[a, b] is the Kronecker-delta for SU(N) with color indices a and b in the fundamental representation.","anchor":"sunfdelta"},{"text":"Overview, SUNDelta.","anchor":"see-also","section":"See also"},{"text":"SUNFDelta[SUNFIndex[a], SUNFIndex[b]]","anchor":"cb1","section":"Examples"},{"text":"\\[\\delta _{ab}\\]","anchor":"cb1-1","section":"Examples"},{"text":"SUNFDelta[SUNFIndex[a], SUNFIndex[b]] SUNFDelta[SUNFIndex[b], SUNFIndex[c]] % // SUNSimplify","anchor":"cb2","section":"Examples"},{"text":"\\[\\delta _{ab} \\delta _{bc}\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[\\delta _{ac}\\]","anchor":"cb2-3","section":"Examples"},{"text":"SUNFDelta[SUNFIndex[a], SUNFIndex[b]]^2 % // SUNSimplify","anchor":"cb3","section":"Examples"},{"text":"\\[\\delta _{ab}^2\\]","anchor":"cb3-3","section":"Examples"},{"text":"\\[C_A\\]","anchor":"cb3-3","section":"Examples"},{"text":"SUNFDelta[SUNFIndex[a], SUNFIndex[b]] // StandardForm (*SUNFDelta[SUNFIndex[a], SUNFIndex[b]]*)","anchor":"cb4","section":"Examples"},{"text":"SUNFDelta[SUNFIndex[a], SUNFIndex[b]] // FCI // FCE // StandardForm (*SDF[a, b]*)","anchor":"cb5","section":"Examples"},{"text":"SDF[a, b] // FCI // StandardForm (*SUNFDelta[SUNFIndex[a], SUNFIndex[b]]*)","anchor":"cb6","section":"Examples"},{"text":"The arguments of SUNFDelta may also represent explicit integer indices via the head ExplictiSUNFIndex. The difference is that SUNSimplify will only sum over symbolic indices.","anchor":"cb6-3","section":"Examples"},{"text":"ex = SUNFDelta[SUNFIndex[a], ExplicitSUNFIndex[2]] SUNFDelta[SUNFIndex[a], SUNFIndex[b]] SUNFDelta[SUNFIndex[c], ExplicitSUNFIndex[2]] // SUNSimplify","anchor":"cb7","section":"Examples"},{"text":"\\[\\delta _{2b} \\delta _{2c}\\]","anchor":"cb7-1","section":"Examples"},{"text":"ex // StandardForm (*SUNFDelta[ExplicitSUNFIndex[2], SUNFIndex[b]] SUNFDelta[ExplicitSUNFIndex[2], SUNFIndex[c]]*)","anchor":"cb8","section":"Examples"},{"text":"SDF[1, 2] // FCI // StandardForm (*SUNFDelta[ExplicitSUNFIndex[1], ExplicitSUNFIndex[2]]*)","anchor":"cb9","section":"Examples"}]