[{"text":"Overview.","anchor":"see-also","section":"See also"},{"text":"Since version 9.3 FeynCalc can also deal with manifestly noncovariant expressions, such as 3-vectors, Kronecker deltas and Pauli matrices","anchor":"manipulations-of-cartesian-tensors","section":"Manipulations of Cartesian tensors"},{"text":"CV[p, i]","anchor":"cb1","section":"Manipulations of Cartesian tensors"},{"text":"\\[\\overline{p}^i\\]","anchor":"cb1-1","section":"Manipulations of Cartesian tensors"},{"text":"CV[p, i] CV[q, i] % // Contract","anchor":"cb2","section":"Manipulations of Cartesian tensors"},{"text":"\\[\\overline{p}^i \\overline{q}^i\\]","anchor":"cb2-2","section":"Manipulations of Cartesian tensors"},{"text":"\\[\\overline{p}\\cdot \\overline{q}\\]","anchor":"cb2-2","section":"Manipulations of Cartesian tensors"},{"text":"CLC[i, j, k] CLC[i, j, l] % // Contract","anchor":"cb3","section":"Manipulations of Cartesian tensors"},{"text":"\\[\\bar{\\epsilon }^{ijk} \\bar{\\epsilon }^{ijl}\\]","anchor":"cb3-2","section":"Manipulations of Cartesian tensors"},{"text":"\\[2 \\bar{\\delta }^{kl}\\]","anchor":"cb3-2","section":"Manipulations of Cartesian tensors"},{"text":"CSI[i, j, i] % // PauliSimplify","anchor":"cb4","section":"Manipulations of Cartesian tensors"},{"text":"\\[\\overline{\\sigma }^i.\\overline{\\sigma }^j.\\overline{\\sigma }^i\\]","anchor":"cb4-2","section":"Manipulations of Cartesian tensors"},{"text":"\\[-\\overline{\\sigma }^j\\]","anchor":"cb4-2","section":"Manipulations of Cartesian tensors"},{"text":"PauliTrace[CSI[i, j, i, j]] % // PauliSimplify","anchor":"cb5","section":"Manipulations of Cartesian tensors"},{"text":"\\[\\text{tr}\\left(\\overline{\\sigma }^i.\\overline{\\sigma }^j.\\overline{\\sigma }^i.\\overline{\\sigma }^j\\right)\\]","anchor":"cb5-2","section":"Manipulations of Cartesian tensors"},{"text":"\\[-6\\]","anchor":"cb5-2","section":"Manipulations of Cartesian tensors"},{"text":"The function LorentzToCartesian is used to break the manifest Lorentz covariance when doing nonrelativistic expansions","anchor":"cb5-2","section":"Manipulations of Cartesian tensors"},{"text":"SP[p, q] % // LorentzToCartesian","anchor":"cb6","section":"Manipulations of Cartesian tensors"},{"text":"\\[\\overline{p}\\cdot \\overline{q}\\]","anchor":"cb6-2","section":"Manipulations of Cartesian tensors"},{"text":"\\[p^0 q^0-\\overline{p}\\cdot \\overline{q}\\]","anchor":"cb6-2","section":"Manipulations of Cartesian tensors"}]