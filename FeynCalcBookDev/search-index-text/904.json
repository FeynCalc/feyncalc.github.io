[{"text":"SpinorVBarD[p, m] denotes a \\bar{v}(p,m)-spinor that depends on the D-dimensional momentum p.","anchor":"spinorvbard"},{"text":"Overview, Spinor, SpinorUBar, SpinorU, SpinorV, SpinorVBar, SpinorUBarD, SpinorUD, SpinorVD.","anchor":"see-also","section":"See also"},{"text":"SpinorVBarD[p, m]","anchor":"cb1","section":"Examples"},{"text":"\\[\\bar{v}(p,m)\\]","anchor":"cb1-1","section":"Examples"},{"text":"SpinorVBarD[p, m] // FCI // StandardForm (*Spinor[-Momentum[p, D], m, 1]*)","anchor":"cb2","section":"Examples"},{"text":"SpinorVBarD[p]","anchor":"cb3","section":"Examples"},{"text":"\\[\\bar{v}(p)\\]","anchor":"cb3-1","section":"Examples"},{"text":"SpinorVBarD[p] // FCI // StandardForm (*Spinor[-Momentum[p, D], 0, 1]*)","anchor":"cb4","section":"Examples"},{"text":"SpinorVBarD[p] . GSD[p] DiracEquation[%]","anchor":"cb5","section":"Examples"},{"text":"\\[\\bar{v}(p).(\\gamma \\cdot p)\\]","anchor":"cb5-3","section":"Examples"},{"text":"\\[0\\]","anchor":"cb5-3","section":"Examples"}]