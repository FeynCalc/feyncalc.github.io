[{"text":"A0[m^2] is the Passarino-Veltman one-point integral \\(A_0.\\).","anchor":"a0"},{"text":"Overview, B0, C0, D0, PaVe.","anchor":"see-also","section":"See also"},{"text":"By default \\(A_0\\) is not expressed in terms of \\(B_0\\).","anchor":"examples","section":"Examples"},{"text":"A0[m^2]","anchor":"cb1","section":"Examples"},{"text":"\\[\\text{A}_0\\left(m^2\\right)\\]","anchor":"cb1-1","section":"Examples"},{"text":"SetOptions[A0, A0ToB0 -> True]; A0[m^2]","anchor":"cb2","section":"Examples"},{"text":"\\[-\\frac{2 m^2 \\;\\text{B}_0\\left(0,m^2,m^2\\right)}{2-D}\\]","anchor":"cb2-3","section":"Examples"},{"text":"SetOptions[A0, A0ToB0 -> False];","anchor":"cb3","section":"Examples"},{"text":"According to the rules of dimensional regularization A_0(0) is set to 0.","anchor":"cb3-1","section":"Examples"},{"text":"A0[0]","anchor":"cb4","section":"Examples"},{"text":"\\[0\\]","anchor":"cb4-1","section":"Examples"},{"text":"A0[SmallVariable[M^2]]","anchor":"cb5","section":"Examples"},{"text":"\\[0\\]","anchor":"cb5-1","section":"Examples"}]