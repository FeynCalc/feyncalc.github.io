[{"text":"FourVector[p, mu] is the 4-dimensional vector p with Lorentz index mu.","anchor":"fourvector"},{"text":"A vector with space-time Dimension \\(D\\) is obtained by supplying the option Dimension -> D.","anchor":"fourvector"},{"text":"The shortcut FourVector is deprecated, please use FV instead!","anchor":"fourvector"},{"text":"Overview, FV, FCI.","anchor":"see-also","section":"See also"},{"text":"FourVector[p, \\[Mu]]","anchor":"cb1","section":"Examples"},{"text":"\\[\\overline{p}^{\\mu }\\]","anchor":"cb1-1","section":"Examples"},{"text":"FourVector[p - q, \\[Mu]]","anchor":"cb2","section":"Examples"},{"text":"\\left(\\overline{p}-\\overline{q}\\right)^{\\mu }","anchor":"cb2-1","section":"Examples"},{"text":"StandardForm[FourVector[p, \\[Mu]]] (*Pair[LorentzIndex[\\[Mu]], Momentum[p]]*)","anchor":"cb3","section":"Examples"},{"text":"StandardForm[FourVector[p, \\[Mu], Dimension -> D]] (*Pair[LorentzIndex[\\[Mu], D], Momentum[p, D]]*)","anchor":"cb4","section":"Examples"},{"text":"FourVector is scheduled for removal in the future versions of FeynCalc. The safe alternative is to use FV.","anchor":"cb4-3","section":"Examples"},{"text":"FV[p, \\[Mu]]","anchor":"cb5","section":"Examples"},{"text":"\\[\\overline{p}^{\\mu }\\]","anchor":"cb5-1","section":"Examples"},{"text":"FVD[p, \\[Mu]]","anchor":"cb6","section":"Examples"},{"text":"\\[p^{\\mu }\\]","anchor":"cb6-1","section":"Examples"},{"text":"FCI[FV[p, \\[Mu]]] === FourVector[p, \\[Mu]]","anchor":"cb7","section":"Examples"},{"text":"\\[\\text{True}\\]","anchor":"cb7-1","section":"Examples"},{"text":"FCI[FVD[p, \\[Mu]]] === FourVector[p, \\[Mu], Dimension -> D]","anchor":"cb8","section":"Examples"},{"text":"\\[\\text{True}\\]","anchor":"cb8-1","section":"Examples"}]