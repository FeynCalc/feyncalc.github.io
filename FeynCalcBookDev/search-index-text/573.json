[{"text":"FVLP[p,mu,n,nb] denotes the positive component in the lightcone decomposition of the Lorentz vector p^{\\mu } along the vectors n and nb. It corresponds to \\(\\frac{1}{2} \\bar{n}^{\\mu} (p \\cdot n)\\).","anchor":"fvlp"},{"text":"Overview, Pair, FVLN, FVLR, SPLP, SPLN, SPLR, MTLP, MTLN, MTLR.","anchor":"see-also","section":"See also"},{"text":"FVLP[p, \\[Mu], n, nb]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{1}{2} \\overline{\\text{nb}}^{\\mu } \\left(\\overline{n}\\cdot \\overline{p}\\right)\\]","anchor":"cb1-1","section":"Examples"},{"text":"StandardForm[FVLP[p, \\[Mu], n, nb] // FCI]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{2} \\;\\text{Pair}[\\text{LorentzIndex}[\\mu ],\\text{Momentum}[\\text{nb}]] \\;\\text{Pair}[\\text{Momentum}[n],\\text{Momentum}[p]]\\]","anchor":"cb2-1","section":"Examples"},{"text":"FVLP[p, \\[Mu], n, nb] FVLN[q, \\[Mu], n, nb] // Contract","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{1}{4} \\left(\\overline{n}\\cdot \\overline{\\text{nb}}\\right) \\left(\\overline{n}\\cdot \\overline{p}\\right) \\left(\\overline{\\text{nb}}\\cdot \\overline{q}\\right)\\]","anchor":"cb3-1","section":"Examples"},{"text":"FVLP[p, \\[Mu], n, nb] FVLP[q, \\[Mu], n, nb] // Contract","anchor":"cb4","section":"Examples"},{"text":"\\[\\frac{1}{4} \\overline{\\text{nb}}^2 \\left(\\overline{n}\\cdot \\overline{p}\\right) \\left(\\overline{n}\\cdot \\overline{q}\\right)\\]","anchor":"cb4-1","section":"Examples"},{"text":"FVLP[p, \\[Mu], n, nb] FVLN[q, \\[Mu], n, nb] // Contract","anchor":"cb6","section":"Examples"},{"text":"\\[\\frac{1}{2} \\left(\\overline{n}\\cdot \\overline{p}\\right) \\left(\\overline{\\text{nb}}\\cdot \\overline{q}\\right)\\]","anchor":"cb6-1","section":"Examples"},{"text":"FVLP[p, \\[Mu], n, nb] FVLP[q, \\[Mu], n, nb] // Contract","anchor":"cb7","section":"Examples"},{"text":"\\[0\\]","anchor":"cb7-1","section":"Examples"},{"text":"FCClearScalarProducts[]","anchor":"cb8","section":"Examples"}]