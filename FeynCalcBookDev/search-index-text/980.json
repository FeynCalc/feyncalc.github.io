[{"text":"TR[exp] calculates the Dirac trace of exp.","anchor":"tr"},{"text":"If the option SUNSimplify is set to True (default), \\(SU(N)\\) algebra is simplified as well.","anchor":"tr"},{"text":"Notice that TR is a legacy function that should not be used in new codes. Instead, you can wrap your string Dirac matrices with DiracTrace and subsequently apply DiracSimplify to calculate the trace.","anchor":"tr"},{"text":"Overview, DiracSimplify, DiracTrace, SUNSimplify.","anchor":"see-also","section":"See also"},{"text":"GA[\\[Mu], \\[Nu]] TR[%]","anchor":"cb1","section":"Examples"},{"text":"\\[\\bar{\\gamma }^{\\mu }.\\bar{\\gamma }^{\\nu }\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[4 \\bar{g}^{\\mu \\nu }\\]","anchor":"cb1-3","section":"Examples"},{"text":"TR[(GSD[p] + m) . GAD[\\[Mu]] . (GSD[q] - m) . GAD[\\[Nu]]]","anchor":"cb2","section":"Examples"},{"text":"\\[-4 \\left(m^2 g^{\\mu \\nu }+g^{\\mu \\nu } (p\\cdot q)-p^{\\nu } q^{\\mu }-p^{\\mu } q^{\\nu }\\right)\\]","anchor":"cb2-1","section":"Examples"},{"text":"TR[GA[\\[Mu], \\[Nu], \\[Rho], \\[Sigma], 5]]","anchor":"cb3","section":"Examples"},{"text":"\\[-4 i \\bar{\\epsilon }^{\\mu \\nu \\rho \\sigma }\\]","anchor":"cb3-1","section":"Examples"},{"text":"TR[GS[p, q, r, s]]","anchor":"cb4","section":"Examples"},{"text":"\\[4 \\left(\\left(\\overline{p}\\cdot \\overline{s}\\right) \\left(\\overline{q}\\cdot \\overline{r}\\right)-\\left(\\overline{p}\\cdot \\overline{r}\\right) \\left(\\overline{q}\\cdot \\overline{s}\\right)+\\left(\\overline{p}\\cdot \\overline{q}\\right) \\left(\\overline{r}\\cdot \\overline{s}\\right)\\right)\\]","anchor":"cb4-1","section":"Examples"},{"text":"TR[(GS[p] + m) . GA[\\[Mu]] . (GS[q] + m) . GA[\\[Mu]], Factoring -> True]","anchor":"cb5","section":"Examples"},{"text":"\\[8 \\left(2 m^2-\\overline{p}\\cdot \\overline{q}\\right)\\]","anchor":"cb5-1","section":"Examples"},{"text":"TR[GA[\\[Alpha], \\[Beta]], FCE -> True]","anchor":"cb6","section":"Examples"},{"text":"\\[4 \\bar{g}^{\\alpha \\beta }\\]","anchor":"cb6-1","section":"Examples"},{"text":"```mathematica GA[[Mu], [Nu]] SUNT[b] . SUNT[c] SUNDelta[c, b]","anchor":"cb6-1","section":"Examples"},{"text":"TR[%]","anchor":"cb6-1","section":"Examples"},{"text":"```mathematica","anchor":"cb6-1","section":"Examples"},{"text":"\\[\\delta ^{bc} T^b.T^c \\bar{\\gamma }^{\\mu }.\\bar{\\gamma }^{\\nu }\\]","anchor":"cb6-1","section":"Examples"},{"text":"\\[4 C_F \\bar{g}^{\\mu \\nu }\\]","anchor":"cb6-1","section":"Examples"}]