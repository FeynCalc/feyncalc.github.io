[{"text":"AnomalousDimension[name] is a database of anomalous dimensions of twist 2 operators.","anchor":"anomalousdimension"},{"text":"AnomalousDimension[\"gnsqg0\"] yields the non-singlet one-loop contribution to the anomalous dimension \\gamma_{S,qg}^{(0),m} in the MS-bar scheme etc.","anchor":"anomalousdimension"},{"text":"Overview, SplittingFunction, SumS, SumT.","anchor":"see-also","section":"See also"},{"text":"Polarized case:","anchor":"examples","section":"Examples"},{"text":"SetOptions[AnomalousDimension, Polarization -> 1]","anchor":"cb1","section":"Examples"},{"text":"\\[\\{\\text{Polarization}\\to 1,\\text{Simplify}\\to \\;\\text{FullSimplify}\\}\\]","anchor":"cb1-1","section":"Examples"},{"text":"\\(\\gamma _{NS,qq }^{(0) }\\) polarized:","anchor":"cb1-1","section":"Examples"},{"text":"AnomalousDimension[gnsqq0]","anchor":"cb2","section":"Examples"},{"text":"\\[C_F \\left(8 S_1(m-1)+\\frac{4}{m}+\\frac{4}{m+1}-6\\right)\\]","anchor":"cb2-1","section":"Examples"},{"text":"\\(\\gamma _{S,qg }^{(0)}\\) polarized:","anchor":"cb2-1","section":"Examples"},{"text":"AnomalousDimension[gsqg0]","anchor":"cb3","section":"Examples"},{"text":"\\[\\left(\\frac{8}{m}-\\frac{16}{m+1}\\right) T_f\\]","anchor":"cb3-1","section":"Examples"},{"text":"\\(\\gamma _{S,gq }^{(0)}\\)polarized:","anchor":"cb3-1","section":"Examples"},{"text":"AnomalousDimension[gsgq0]","anchor":"cb4","section":"Examples"},{"text":"\\[\\left(\\frac{4}{m+1}-\\frac{8}{m}\\right) C_F\\]","anchor":"cb4-1","section":"Examples"},{"text":"\\(\\gamma _{S,gg}^{(0)}\\) polarized:","anchor":"cb4-1","section":"Examples"},{"text":"AnomalousDimension[gsgg0]","anchor":"cb5","section":"Examples"},{"text":"\\[C_A \\left(8 S_1(m-1)-\\frac{8}{m}+\\frac{16}{m+1}-\\frac{22}{3}\\right)+\\frac{8 T_f}{3}\\]","anchor":"cb5-1","section":"Examples"},{"text":"\\(\\gamma _{PS,qq}^{(0)}\\) polarized:","anchor":"cb5-1","section":"Examples"},{"text":"AnomalousDimension[gpsqq1]","anchor":"cb6","section":"Examples"},{"text":"\\[16 \\left(\\frac{2}{m^3}-\\frac{1}{m^2}+\\frac{1}{m+1}+\\frac{3}{(m+1)^2}+\\frac{2}{(m+1)^3}-\\frac{1}{m}\\right) C_F T_f\\]","anchor":"cb6-1","section":"Examples"},{"text":"\\(\\gamma _{NS,qq }^{(1)}\\) polarized:","anchor":"cb6-1","section":"Examples"},{"text":"AnomalousDimension[gnsqq1]","anchor":"cb7","section":"Examples"},{"text":"\\[-C_A C_F \\left(-\\frac{16 \\tilde{S}_2(m-1)}{m}-\\frac{16 \\tilde{S}_2(m-1)}{m+1}+16 \\tilde{S}_3(m-1)-32 \\tilde{S}_{12}(m-1)+\\frac{44}{3 m^2}-\\frac{536}{9} S_1(m-1)+\\frac{88}{3} S_2(m-1)-16 S_3(m-1)+\\frac{212}{9 m}-\\frac{748}{9 (m+1)}-\\frac{4}{3 (m+1)^2}-\\frac{16}{(m+1)^3}+\\frac{17}{3}\\right)-\\left(C_F^2 \\left(\\frac{32 \\tilde{S}_2(m-1)}{m}+\\frac{32 \\tilde{S}_2(m-1)}{m+1}-32 \\tilde{S}_3(m-1)+64 \\tilde{S}_{12}(m-1)+\\frac{8}{m^3}+\\frac{16 S_1(m-1)}{m^2}+\\frac{16 S_1(m-1)}{(m+1)^2}+\\frac{16 S_2(m-1)}{m}+\\frac{16 S_2(m-1)}{m+1}-24 S_2(m-1)+32 S_{12}(m-1)+32 S_{21}(m-1)-\\frac{40}{m}+\\frac{40}{m+1}+\\frac{16}{(m+1)^2}+\\frac{40}{(m+1)^3}+3\\right)\\right)-C_F N_f \\left(-\\frac{8}{3 m^2}+\\frac{80}{9} S_1(m-1)-\\frac{16}{3} S_2(m-1)-\\frac{8}{9 m}+\\frac{88}{9 (m+1)}-\\frac{8}{3 (m+1)^2}-\\frac{2}{3}\\right)\\]","anchor":"cb7-1","section":"Examples"},{"text":"\\(\\gamma _{S,qg }^{(1)}\\) polarized:","anchor":"cb7-1","section":"Examples"},{"text":"AnomalousDimension[gsqg1]","anchor":"cb8","section":"Examples"},{"text":"\\[16 C_A T_f \\left(-\\frac{2 \\tilde{S}_2(m-1)}{m}+\\frac{4 \\tilde{S}_2(m-1)}{m+1}+\\frac{2}{m^3}-\\frac{2 S_1(m-1)}{m^2}-\\frac{3}{m^2}-\\frac{S_1^2(m-1)}{m}+\\frac{2 S_1^2(m-1)}{m+1}+\\frac{4 S_1(m-1)}{(m+1)^2}-\\frac{S_2(m-1)}{m}+\\frac{2 S_2(m-1)}{m+1}-\\frac{4}{m}+\\frac{3}{m+1}+\\frac{8}{(m+1)^2}+\\frac{12}{(m+1)^3}\\right)+8 C_F T_f \\left(-\\frac{2}{m^3}-\\frac{1}{m^2}+\\frac{2 S_1^2(m-1)}{m}-\\frac{4 S_1^2(m-1)}{m+1}-\\frac{2 S_2(m-1)}{m}+\\frac{4 S_2(m-1)}{m+1}+\\frac{14}{m}-\\frac{19}{m+1}-\\frac{8}{(m+1)^2}+\\frac{4}{(m+1)^3}\\right)\\]","anchor":"cb8-1","section":"Examples"},{"text":"\\(\\gamma _{S,gq }^{(1)}\\) polarized:","anchor":"cb8-1","section":"Examples"},{"text":"AnomalousDimension[gsgq1]","anchor":"cb9","section":"Examples"},{"text":"\\[8 C_A C_F \\left(\\frac{4 \\tilde{S}_2(m-1)}{m}-\\frac{2 \\tilde{S}_2(m-1)}{m+1}-\\frac{4}{m^3}+\\frac{28}{3 m^2}-\\frac{2 S_1^2(m-1)}{m}+\\frac{S_1^2(m-1)}{m+1}+\\frac{16 S_1(m-1)}{3 m}-\\frac{5 S_1(m-1)}{3 (m+1)}+\\frac{2 S_2(m-1)}{m}-\\frac{S_2(m-1)}{m+1}-\\frac{56}{9 m}-\\frac{20}{9 (m+1)}-\\frac{38}{3 (m+1)^2}-\\frac{6}{(m+1)^3}\\right)+32 C_F T_f \\left(-\\frac{2}{3 m^2}-\\frac{2 S_1(m-1)}{3 m}+\\frac{S_1(m-1)}{3 (m+1)}+\\frac{7}{9 m}-\\frac{2}{9 (m+1)}+\\frac{1}{3 (m+1)^2}\\right)+4 C_F^2 \\left(\\frac{4}{m^3}+\\frac{8 S_1(m-1)}{m^2}-\\frac{12}{m^2}+\\frac{4 S_1^2(m-1)}{m}-\\frac{2 S_1^2(m-1)}{m+1}-\\frac{8 S_1(m-1)}{m}+\\frac{2 S_1(m-1)}{m+1}-\\frac{4 S_1(m-1)}{(m+1)^2}+\\frac{4 S_2(m-1)}{m}-\\frac{2 S_2(m-1)}{m+1}+\\frac{15}{m}-\\frac{6}{m+1}+\\frac{3}{(m+1)^2}-\\frac{2}{(m+1)^3}\\right)\\]","anchor":"cb9-1","section":"Examples"},{"text":"\\(\\gamma _{S,gg }^{(1)}\\) polarized:","anchor":"cb9-1","section":"Examples"},{"text":"v1 = AnomalousDimension[gsgg1]","anchor":"cb10","section":"Examples"}]