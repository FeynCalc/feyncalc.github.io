[{"text":"TIDL is a database of tensorial reduction formulas.","anchor":"tidl"},{"text":"Overview, TID.","anchor":"see-also","section":"See also"},{"text":"TIDL[{q, mu}, {p}]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{p^{\\text{mu}} (p\\cdot q)}{p^2}\\]","anchor":"cb1-1","section":"Examples"},{"text":"TIDL[{q, mu}, {p1, p2}]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{\\text{p1}^{\\text{mu}} \\left((\\text{p1}\\cdot \\;\\text{p2}) (\\text{p2}\\cdot q)-\\text{p2}^2 (\\text{p1}\\cdot q)\\right)}{(\\text{p1}\\cdot \\;\\text{p2})^2-\\text{p1}^2 \\;\\text{p2}^2}-\\frac{\\text{p2}^{\\text{mu}} \\left(\\text{p1}^2 (\\text{p2}\\cdot q)-(\\text{p1}\\cdot \\;\\text{p2}) (\\text{p1}\\cdot q)\\right)}{(\\text{p1}\\cdot \\;\\text{p2})^2-\\text{p1}^2 \\;\\text{p2}^2}\\]","anchor":"cb2-1","section":"Examples"},{"text":"TIDL[{{q1, mu}, {q2, nu}}, {p}]","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{g^{\\text{mu}\\;\\text{nu}} \\left((p\\cdot \\;\\text{q1}) (p\\cdot \\;\\text{q2})-p^2 (\\text{q1}\\cdot \\;\\text{q2})\\right)}{(1-D) p^2}-\\frac{p^{\\text{mu}} p^{\\text{nu}} \\left(D (p\\cdot \\;\\text{q1}) (p\\cdot \\;\\text{q2})-p^2 (\\text{q1}\\cdot \\;\\text{q2})\\right)}{(1-D) p^4}\\]","anchor":"cb3-1","section":"Examples"},{"text":"TIDL[{{q1, mu}, {q2, nu}}, {}]","anchor":"cb4","section":"Examples"},{"text":"\\[\\frac{g^{\\text{mu}\\;\\text{nu}} (\\text{q1}\\cdot \\;\\text{q2})}{D}\\]","anchor":"cb4-1","section":"Examples"}]