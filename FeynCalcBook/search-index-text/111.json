[{"text":"B00[pp, ma^2, mb^2] is the Passarino-Veltman B_{00}-function, i.e., the coefficient function of the metric tensor. All arguments are scalars and have dimension mass squared.","anchor":"b00"},{"text":"Overview, B0, B1, PaVe.","anchor":"see-also","section":"See also"},{"text":"B00[SPD[p], m^2, M^2]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{\\left(m^2-2 m M+M^2-p^2\\right) \\left(m^2+2 m M+M^2-p^2\\right) \\;\\text{B}_0\\left(p^2,m^2,M^2\\right)}{4 (1-D) p^2}+\\frac{\\text{A}_0\\left(M^2\\right) \\left(m^2-M^2-p^2\\right)}{4 (1-D) p^2}-\\frac{\\text{A}_0\\left(m^2\\right) \\left(m^2-M^2+p^2\\right)}{4 (1-D) p^2}\\]","anchor":"cb1-1","section":"Examples"},{"text":"B00[SPD[p], m^2, m^2]","anchor":"cb2","section":"Examples"},{"text":"\\[-\\frac{\\left(4 m^2-p^2\\right) \\;\\text{B}_0\\left(p^2,m^2,m^2\\right)}{4 (1-D)}-\\frac{\\text{A}_0\\left(m^2\\right)}{2 (1-D)}\\]","anchor":"cb2-1","section":"Examples"},{"text":"B00[SPD[p], m^2, M^2, BReduce -> False]","anchor":"cb3","section":"Examples"},{"text":"\\text{B}_{00}\\left(p^2,m^2,M^2\\right)","anchor":"cb3-1","section":"Examples"},{"text":"B00[0, m^2, m^2]","anchor":"cb4","section":"Examples"},{"text":"\\[-\\frac{m^2 \\;\\text{B}_0\\left(0,m^2,m^2\\right)}{1-D}-\\frac{\\text{A}_0\\left(m^2\\right)}{2 (1-D)}\\]","anchor":"cb4-1","section":"Examples"},{"text":"B00[SmallVariable[M^2], m^2, m^2]","anchor":"cb5","section":"Examples"},{"text":"\\[-\\frac{m^2 \\;\\text{B}_0\\left(M^2,m^2,m^2\\right)}{1-D}-\\frac{\\text{A}_0\\left(m^2\\right)}{2 (1-D)}\\]","anchor":"cb5-1","section":"Examples"}]