[{"text":"SumS[1, m] is the harmonic number S_ 1(m) = \\sum_ {i=1}^m i^{-1}.","anchor":"sums"},{"text":"SumS[1,1,m] is \\(\\sum_{i=1}^m S_ 1 (i)/i\\).","anchor":"sums"},{"text":"SumS[k,l,m] is \\(\\sum_{i=1}^m S_l (i)/i^k\\).","anchor":"sums"},{"text":"SumS[r, n] represents Sum[Sign[r]^i/i^Abs[r], {i, 1, n}].","anchor":"sums"},{"text":"SumS[r,s, n] is Sum[Sign[r]^k/k^Abs[r] Sign[s]^j/j^Abs[s], {k, 1, n}, {j, 1, k}] etc.","anchor":"sums"},{"text":"Overview, SumP, SumT.","anchor":"see-also","section":"See also"},{"text":"SumS[1, m - 1]","anchor":"cb1","section":"Examples"},{"text":"\\[S_1(m-1)\\]","anchor":"cb1-1","section":"Examples"},{"text":"SumS[2, m - 1]","anchor":"cb2","section":"Examples"},{"text":"\\[S_2(m-1)\\]","anchor":"cb2-1","section":"Examples"},{"text":"SumS[-1, m]","anchor":"cb3","section":"Examples"},{"text":"\\[S_{-1}(m)\\]","anchor":"cb3-1","section":"Examples"},{"text":"SumS[1, m, Reduce -> True]","anchor":"cb4","section":"Examples"},{"text":"\\[S_1(m-1)+\\frac{1}{m}\\]","anchor":"cb4-1","section":"Examples"},{"text":"SumS[3, m + 2, Reduce -> True]","anchor":"cb5","section":"Examples"},{"text":"\\[S_3(m+1)+\\frac{1}{(m+2)^3}\\]","anchor":"cb5-1","section":"Examples"},{"text":"SetOptions[SumS, Reduce -> True]; SumS[3, m + 2]","anchor":"cb6","section":"Examples"},{"text":"\\frac{1}{m^3}+S_3(m-1)+\\frac{1}{(m+1)^3}+\\frac{1}{(m+2)^3}","anchor":"cb6-3","section":"Examples"},{"text":"SetOptions[SumS, Reduce -> False]; SumS[1, 4]","anchor":"cb7","section":"Examples"},{"text":"\\[\\frac{25}{12}\\]","anchor":"cb7-3","section":"Examples"},{"text":"SumS[1, 2, m - 1]","anchor":"cb8","section":"Examples"},{"text":"\\[S_{12}(m-1)\\]","anchor":"cb8-1","section":"Examples"},{"text":"SumS[1, 1, 1, 11]","anchor":"cb9","section":"Examples"},{"text":"\\frac{31276937512951}{4260000729600}","anchor":"cb9-1","section":"Examples"},{"text":"SumS[-1, 4]","anchor":"cb10","section":"Examples"},{"text":"\\[-\\frac{7}{12}\\]","anchor":"cb10-1","section":"Examples"},{"text":"Su