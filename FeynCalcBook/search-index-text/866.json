[{"text":"SISE[p] can be used as input for D-4-dimensional \\sigma ^{\\mu } p_{\\mu } with D-4-dimensional Lorentz vector p and is transformed into PauliSigma[Momentum[p,D-4], D-4] by FeynCalcInternal.","anchor":"sise"},{"text":"Overview, SIS, PauliSigma.","anchor":"see-also","section":"See also"},{"text":"SISE[p]","anchor":"cb1","section":"Examples"},{"text":"\\[\\hat{\\sigma }\\cdot \\hat{p}\\]","anchor":"cb1-1","section":"Examples"},{"text":"SISE[p] // FCI // StandardForm (*PauliSigma[Momentum[p, -4 + D], -4 + D]*)","anchor":"cb2","section":"Examples"},{"text":"SISE[p, q, r, s]","anchor":"cb3","section":"Examples"},{"text":"\\[\\left(\\hat{\\sigma }\\cdot \\hat{p}\\right).\\left(\\hat{\\sigma }\\cdot \\hat{q}\\right).\\left(\\hat{\\sigma }\\cdot \\hat{r}\\right).\\left(\\hat{\\sigma }\\cdot \\hat{s}\\right)\\]","anchor":"cb3-1","section":"Examples"},{"text":"SISE[p, q, r, s] // StandardForm (*SISE[p] . SISE[q] . SISE[r] . SISE[s]*)","anchor":"cb4","section":"Examples"}]