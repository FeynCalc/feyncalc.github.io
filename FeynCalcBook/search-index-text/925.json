[{"text":"SUNFSimplify[exp] is an auxiliary function that simplifies expressions containing \\(\\text{SU}(N)\\) indices in the fundamental representation. The simplifications performed by SUNFSimplify are mostly limited to the contractions of the fundamental indices. The function is by far not as powerful as SUNSimplify.","anchor":"sunfsimplify"},{"text":"Overview, SUNTF, SUNFDelta.","anchor":"see-also","section":"See also"},{"text":"SDF[a, a] SUNFSimplify[%]","anchor":"cb1","section":"Examples"},{"text":"\\[\\delta _{aa}\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[C_A\\]","anchor":"cb1-3","section":"Examples"},{"text":"SUNFSimplify[SDF[a, a], SUNNToCACF -> False]","anchor":"cb2","section":"Examples"},{"text":"\\[N\\]","anchor":"cb2-1","section":"Examples"},{"text":"SDF[a, b] SDF[b, d] SUNFSimplify[%]","anchor":"cb3","section":"Examples"},{"text":"\\[\\delta _{ab} \\delta _{bd}\\]","anchor":"cb3-3","section":"Examples"},{"text":"\\[\\delta _{ad}\\]","anchor":"cb3-3","section":"Examples"},{"text":"SDF[a, b] SUNTF[i, a, d] SUNTF[j, d, c] SUNFSimplify[%]","anchor":"cb4","section":"Examples"},{"text":"\\[\\delta _{ab} T_{ad}^i T_{dc}^j\\]","anchor":"cb4-3","section":"Examples"},{"text":"\\[\\left(T^iT^j\\right){}_{bc}\\]","anchor":"cb4-3","section":"Examples"},{"text":"SDF[a, b] (SUNTF[i, a, d] SUNTF[j, d, b] + SD[i, j] SUNTF[i, a, d] SUNTF[i, d, b]) SUNFSimplify[%, SUNNToCACF -> False]","anchor":"cb5","section":"Examples"},{"text":"\\[\\delta _{ab} \\left(\\delta ^{ij} T_{ad}^i T_{db}^i+T_{ad}^i T_{db}^j\\right)\\]","anchor":"cb5-3","section":"Examples"},{"text":"\\[\\frac{\\delta ^{ij}}{2}+\\frac{1}{2} \\left(N^2-1\\right) \\delta ^{ij}\\]","anchor":"cb5-3","section":"Examples"}]