[{"text":"SUND[a, b, c] are the symmetric SU(N) d_{abc}.","anchor":"sund"},{"text":"Overview, SUNDelta, SUNF, SUNSimplify.","anchor":"see-also","section":"See also"},{"text":"SUND[a, b, c]","anchor":"cb1","section":"Examples"},{"text":"\\[d^{abc}\\]","anchor":"cb1-1","section":"Examples"},{"text":"SUND[a, b, c, Explicit -> True]","anchor":"cb2","section":"Examples"},{"text":"\\[2 \\left(\\text{tr}(T^a.T^b.T^c)\\right)+2 \\left(\\text{tr}(T^b.T^a.T^c)\\right)\\]","anchor":"cb2-1","section":"Examples"},{"text":"SUND[c, a, b]","anchor":"cb3","section":"Examples"},{"text":"\\[d^{abc}\\]","anchor":"cb3-1","section":"Examples"},{"text":"SUND[a, b, b]","anchor":"cb4","section":"Examples"},{"text":"\\[d^{abb}\\]","anchor":"cb4-1","section":"Examples"},{"text":"SUNSimplify[SUND[a, b, c] SUND[a, b, c]]","anchor":"cb5","section":"Examples"},{"text":"\\[-2 \\left(4-C_A^2\\right) C_F\\]","anchor":"cb5-1","section":"Examples"},{"text":"SUNSimplify[SUND[a, b, c] SUND[a, b, c], SUNNToCACF -> False] // Factor2","anchor":"cb6","section":"Examples"},{"text":"\\[\\frac{\\left(1-N^2\\right) \\left(4-N^2\\right)}{N}\\]","anchor":"cb6-1","section":"Examples"},{"text":"SUNSimplify[SUND[a, b, c] SUND[e, b, c], SUNNToCACF -> False] // Factor2","anchor":"cb7","section":"Examples"},{"text":"\\[-\\frac{\\left(4-N^2\\right) \\delta ^{ae}}{N}\\]","anchor":"cb7-1","section":"Examples"},{"text":"SUND[a, b, c] // StandardForm (*SUND[a, b, c]*)","anchor":"cb8","section":"Examples"},{"text":"SUND[a, b, c] // FCI // StandardForm (*SUND[SUNIndex[a], SUNIndex[b], SUNIndex[c]]*)","anchor":"cb9","section":"Examples"},{"text":"SUND[a, b, c] // FCI // FCE // StandardForm (*SUND[a, b, c]*)","anchor":"cb10","section":"Examples"}]