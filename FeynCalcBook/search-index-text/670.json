[{"text":"LeftRightNablaD[i] denotes \\overleftrightarrow {\\nabla}_{i}, acting to the left and right.","anchor":"leftrightnablad"},{"text":"ExplicitPartialD[LeftRightNablaD[i]] gives 1/2 (RightNablaD[i] - LeftNablaD[i]).","anchor":"leftrightnablad"},{"text":"Overview, ExplicitPartialD, ExpandPartialD, FCPartialD, LeftNablaD, LeftRightNablaD2, RightNablaD.","anchor":"see-also","section":"See also"},{"text":"LeftRightNablaD[i] ExplicitPartialD[%]","anchor":"cb1","section":"Examples"},{"text":"\\[\\overleftrightarrow{\\nabla }_i\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[\\frac{1}{2} \\overleftarrow{\\partial }_i-\\vec{\\partial }_i\\]","anchor":"cb1-3","section":"Examples"},{"text":"LeftRightNablaD[i] . QuantumField[A, LorentzIndex[\\[Nu]]] ExpandPartialD[%]","anchor":"cb2","section":"Examples"},{"text":"\\[\\overleftrightarrow{\\nabla }_i.A_{\\nu }\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[\\frac{1}{2} \\left(\\overleftarrow{\\partial }_i.A_{\\nu }-\\left(\\partial _iA_{\\nu }\\right)\\right)\\]","anchor":"cb2-3","section":"Examples"},{"text":"QuantumField[A, LorentzIndex[\\[Mu]]] . LeftRightNablaD[i] . QuantumField[A, LorentzIndex[\\[Rho]]] ExpandPartialD[%]","anchor":"cb3","section":"Examples"},{"text":"\\[A_{\\mu }.\\overleftrightarrow{\\nabla }_i.A_{\\rho }\\]","anchor":"cb3-3","section":"Examples"},{"text":"\\[\\frac{1}{2} \\left(\\left(\\partial _iA_{\\mu }\\right).A_{\\rho }-A_{\\mu }.\\left(\\partial _iA_{\\rho }\\right)\\right)\\]","anchor":"cb3-3","section":"Examples"}]