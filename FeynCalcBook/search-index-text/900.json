[{"text":"SPLN[p,q,n,nb] denotes the negative component in the lightcone decomposition of the scalar product p \\cdot q along the vectors n and nb. It corresponds to \\frac{1}{2} (p \\cdot \\bar{n}) (q \\cdot n).","anchor":"spln"},{"text":"Overview, Pair, FVLN, FVLP, FVLR, SPLP, SPLR, MTLP, MTLN, MTLR.","anchor":"see-also","section":"See also"},{"text":"SPLN[p, q, n, nb]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{1}{2} \\left(\\overline{n}\\cdot \\overline{q}\\right) \\left(\\overline{\\text{nb}}\\cdot \\overline{p}\\right)\\]","anchor":"cb1-1","section":"Examples"},{"text":"StandardForm[SPLN[p, q, n, nb] // FCI]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{2} \\;\\text{Pair}[\\text{Momentum}[n],\\text{Momentum}[q]] \\;\\text{Pair}[\\text{Momentum}[\\text{nb}],\\text{Momentum}[p]]\\]","anchor":"cb2-1","section":"Examples"},{"text":"SPLN[p1 + p2 + n, q, n, nb] // ExpandScalarProduct","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{1}{2} \\left(\\overline{n}\\cdot \\overline{q}\\right) \\left(\\overline{n}\\cdot \\overline{\\text{nb}}+\\overline{\\text{nb}}\\cdot \\overline{\\text{p1}}+\\overline{\\text{nb}}\\cdot \\overline{\\text{p2}}\\right)\\]","anchor":"cb3-1","section":"Examples"},{"text":"SPLN[p1 + p2 + n, q, n, nb] // ExpandScalarProduct","anchor":"cb5","section":"Examples"},{"text":"\\[\\frac{1}{2} \\left(\\overline{n}\\cdot \\overline{q}\\right) \\left(\\overline{\\text{nb}}\\cdot \\overline{\\text{p1}}+\\overline{\\text{nb}}\\cdot \\overline{\\text{p2}}+2\\right)\\]","anchor":"cb5-1","section":"Examples"},{"text":"FCClearScalarProducts[]","anchor":"cb6","section":"Examples"}]