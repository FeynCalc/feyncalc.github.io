[{"text":"FourDivergence[exp, FV[p, mu]] calculates the partial derivative of exp w.r.t \\(p^{\\mu }\\). FourDivergence[exp, FV[p, mu], FV[p,nu], ...] gives the multiple derivative.","anchor":"fourdivergence"},{"text":"Overview, ThreeDivergence.","anchor":"see-also","section":"See also"},{"text":"SP[p, q] FourDivergence[%, FV[q, \\[Mu]]]","anchor":"cb1","section":"Examples"},{"text":"\\[\\overline{p}\\cdot \\overline{q}\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[\\overline{p}^{\\mu }\\]","anchor":"cb1-3","section":"Examples"},{"text":"SP[p - k, q] FourDivergence[%, FV[k, \\[Mu]]]","anchor":"cb2","section":"Examples"},{"text":"\\[(\\overline{p}-\\overline{k})\\cdot \\overline{q}\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[-\\overline{q}^{\\mu }\\]","anchor":"cb2-3","section":"Examples"},{"text":"SFAD[{p, m^2}] FourDivergence[%, FVD[p, \\[Nu]]]","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{1}{(p^2-m^2+i \\eta )}\\]","anchor":"cb3-3","section":"Examples"},{"text":"\\[-\\frac{2 p^{\\nu }}{(p^2-m^2+i \\eta )^2}\\]","anchor":"cb3-3","section":"Examples"},{"text":"FVD[l, \\[Mu]] FAD[{l, 0}, {l - p, 0}] FourDivergence[%, FVD[l, \\[Mu]]]","anchor":"cb4","section":"Examples"},{"text":"\\[\\frac{l^{\\mu }}{l^2.(l-p)^2}\\]","anchor":"cb4-3","section":"Examples"},{"text":"\\[\\frac{D}{l^2.(l-p)^2}-\\frac{2 l^2}{\\left(l^2\\right)^2.(l-p)^2}+\\frac{2 (l\\cdot p)-2 l^2}{l^2.(l-p)^4}\\]","anchor":"cb4-3","section":"Examples"},{"text":"SP[p, w]*SpinorUBar[p2, m] . GS[w] . SpinorU[p1, m] FourDivergence[%, FV[w, a]]","anchor":"cb5","section":"Examples"},{"text":"\\[\\left(\\overline{p}\\cdot \\overline{w}\\right) \\bar{u}(\\text{p2},m).\\left(\\bar{\\gamma }\\cdot \\overline{w}\\right).u(\\text{p1},m)\\]","anchor":"cb5-3","section":"Examples"},{"text":"\\[\\left(\\overline{p}\\cdot \\overline{w}\\right) \\left(\\varphi (\\overline{\\text{p2}},m)\\right).\\bar{\\gamma }^a.\\left(\\varphi (\\overline{\\text{p1}},m)\\right)+\\overline{p}^a \\left(\\varphi (\\overline{\\text{p2}},m)\\right).\\left(\\bar{\\gamma }\\cdot \\overline{w}\\right).\\left(\\varphi (\\overline{\\text{p1}},m)\\right)\\]","anchor":"cb5-3","section":"Examples"},{"text":"Differentiation of \\(4\\)-vectors living in different dimensions (\\(4\\), D, \\(D-4\\)) works only in the t’Hooft-Veltman scheme","anchor":"cb5-3","section":"Examples"},{"text":"FourDivergence[FVD[p, mu], FV[p, nu]]","anchor":"cb6","section":"Examples"},{"text":"\\[\\text{\\$Aborted}\\]","anchor":"cb6-1","section":"Examples"},{"text":"FCSetDiracGammaScheme[\"BMHV\"];","anchor":"cb7","section":"Examples"},{"text":"FourDivergence[FVD[p, mu], FV[p, nu]]","anchor":"cb8","section":"Examples"},{"text":"\\[\\bar{g}^{\\text{mu}\\;\\text{nu}}\\]","anchor":"cb8-1","section":"Examples"}]