[{"text":"IsolateTimes is an option for Isolate and other functions using Isolate. If it is set to True, Isolate will be applied also to pure products.","anchor":"isolatetimes"},{"text":"Overview, Isolate, Collect2.","anchor":"see-also","section":"See also"},{"text":"By default, this expression does not become abbreviated","anchor":"examples","section":"Examples"},{"text":"Isolate[a*b*c*d, a]","anchor":"cb1","section":"Examples"},{"text":"\\[a b c d\\]","anchor":"cb1-1","section":"Examples"},{"text":"Now an abbreviation is introduced","anchor":"cb1-1","section":"Examples"},{"text":"Isolate[a*b*c*d, a, IsolateTimes -> True]","anchor":"cb2","section":"Examples"},{"text":"\\[a \\;\\text{KK}(19)\\]","anchor":"cb2-1","section":"Examples"}]