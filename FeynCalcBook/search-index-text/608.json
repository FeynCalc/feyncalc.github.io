[{"text":"GSLP[p,n,nb] denotes the positive component in the lightcone decomposition of the slashed Dirac matrix (\\gamma \\cdot p) along the vectors n and nb. It corresponds to \\frac{1}{2} (\\bar{n} \\cdot p) (\\gamma \\cdot n).","anchor":"gslp"},{"text":"Overview, DiracGamma, GALP, GALN, GALR, GSLN, GSLR.","anchor":"see-also","section":"See also"},{"text":"GSLP[p, n, nb]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{1}{2} \\bar{\\gamma }\\cdot \\overline{n} \\left(\\overline{\\text{nb}}\\cdot \\overline{p}\\right)\\]","anchor":"cb1-1","section":"Examples"},{"text":"StandardForm[GSLP[p, n, nb] // FCI]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{2} \\;\\text{DiracGamma}[\\text{Momentum}[n]] \\;\\text{Pair}[\\text{Momentum}[\\text{nb}],\\text{Momentum}[p]]\\]","anchor":"cb2-1","section":"Examples"},{"text":"GSLP[p, n, nb] . GSLP[q, n, nb] // DiracSimplify","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{1}{4} \\overline{n}^2 \\left(\\overline{\\text{nb}}\\cdot \\overline{p}\\right) \\left(\\overline{\\text{nb}}\\cdot \\overline{q}\\right)\\]","anchor":"cb3-1","section":"Examples"},{"text":"GSLP[p, n, nb] . GSLP[q, n, nb] // DiracSimplify","anchor":"cb5","section":"Examples"},{"text":"\\[0\\]","anchor":"cb5-1","section":"Examples"},{"text":"FCClearScalarProducts[]","anchor":"cb6","section":"Examples"}]