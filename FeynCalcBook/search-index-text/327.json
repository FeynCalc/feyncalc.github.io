[{"text":"FCCompareNumbers[x, y] compares two purely numerical or semi-numerical expressions x and y and returns the number of agreeing significant digits calculated from the relative differences.","anchor":"fccomparenumbers"},{"text":"Overview","anchor":"see-also","section":"See also"},{"text":"These two numbers disagree in their 6th significant digit","anchor":"examples","section":"Examples"},{"text":"FCCompareNumbers[5.123542342 + 1.23145 I, 5.123542324 + 1.23146 I]","anchor":"cb1","section":"Examples"},{"text":"\\[\\text{FCCompareNumbers: Minimal number of significant digits to agree in: }6\\]","anchor":"cb1-1","section":"Examples"},{"text":"\\[\\text{FCCompareNumbers: Chop is set to }\\;\\text{1.$\\grave{ }$*${}^{\\wedge}$-10}\\]","anchor":"cb1-1","section":"Examples"},{"text":"\\[\\text{FCCompareNumbers: No number is set to 0. by Chop at this stage. }\\]","anchor":"cb1-1","section":"Examples"},{"text":"\\[\\text{FCGV}(\\text{I}) \\;\\text{FCGV}(\\text{CommonDigits})(5.09042)\\]","anchor":"cb1-1","section":"Examples"},{"text":"Requiring agreement only in the first 5 significant digits returns 0","anchor":"cb1-1","section":"Examples"},{"text":"FCCompareNumbers[5.123542342 + 1.23145 I, 5.123542324 + 1.23146 I, DigitCount -> 5]","anchor":"cb2","section":"Examples"},{"text":"\\[\\text{FCCompareNumbers: Minimal number of significant digits to agree in: }5\\]","anchor":"cb2-1","section":"Examples"},{"text":"\\[\\text{FCCompareNumbers: Chop is set to }\\;\\text{1.$\\grave{ }$*${}^{\\wedge}$-10}\\]","anchor":"cb2-1","section":"Examples"},{"text":"\\[\\text{FCCompareNumbers: No number is set to 0. by Chop at this stage. }\\]","anchor":"cb2-1","section":"Examples"},{"text":"\\[0\\]","anchor":"cb2-1","section":"Examples"},{"text":"Here even the first significant digit doesn’t agree (obviously)","anchor":"cb2-1","section":"Examples"},{"text":"FCCompareNumbers[5, 6]","anchor":"cb3","section":"Examples"},{"text":"\\[\\text{FCCompareNumbers: Minimal number of significant digits to agree in: }6\\]","anchor":"cb3-1","section":"Examples"},{"text":"\\[\\text{FCCompareNumbers: Chop is set to }\\;\\text{1.$\\grave{ }$*${}^{\\wedge}$-10}\\]","anchor":"cb3-1","section":"Examples"},{"text":"\\[\\text{FCCompareNumbers: No number is set to 0. by Chop at this stage. }\\]","anchor":"cb3-1","section":"Examples"},{"text":"\\text{FCGV}(\\text{CommonDigits})(0.778151)","anchor":"cb3-1","section":"Examples"},{"text":"lhs = (0. + 0.*I) - (0.20132103165327941 - 0.00043434443313399246*I)*coeffO^2*parX^2 + (0.047227066764317975)*coeffO^2*parX^2*parY - (0.00005403882927314103)*coeffO^2*parX^2*parY^2 + (1.4588597782189382*^-6 - 4.06569606476957*^-13*I)*coeffO^2*parX^2*parY^3 + (0.03841797609570242 + 0.000028403733516153446*I)*coeffO^2*parX^2*parZ","anchor":"cb4","section":"Examples"},{"text":"\\[(0.038418\\, +0.0000284037 i) \\;\\text{coeffO}^2 \\;\\text{parX}^2 \\;\\text{parZ}-(0.201321\\, -0.000434344 i) \\;\\text{coeffO}^2 \\;\\text{parX}^2+(0.\\, +0. i)+(\\text{1.4588597782189382$\\grave{ }$*${}^{\\wedge}$-6}-\\text{4.06569606476957$\\grave{ }$*${}^{\\wedge}$-13} i) \\;\\text{coeffO}^2 \\;\\text{parX}^2 \\;\\text{parY}^3-0.0000540388 \\;\\text{coeffO}^2 \\;\\text{parX}^2 \\;\\text{parY}^2+0.0472271 \\;\\text{coeffO}^2 \\;\\text{parX}^2 \\;\\text{parY}\\]","anchor":"cb4-1","section":"Examples"},{"text":"rhs = (-0.20132103165327922 + 0.0004343444331339952*I)*coeffO^2*parX^2 + (0.0472270672349811)*coeffO^2*parX^2*parY - (0.00005403887000187252)*coeffO^2*parX^2*parY^2 + 1.4588601127764193*^-6*coeffO^2*parX^2*parY^3 + (0.038417976095702376 + 0.000028403733516153537*I)*coeffO^2*parX^2*parZ","anchor":"cb5","section":"Examples"},{"text":"\\[(0.038418\\, +0.0000284037 i) \\;\\text{coeffO}^2 \\;\\text{parX}^2 \\;\\text{parZ}-(0.201321\\, -0.000434344 i) \\;\\text{coeffO}^2 \\;\\text{parX}^2+\\text{1.4588601127764193$\\grave{ }$*${}^{\\wedge}$-6} \\;\\text{coeffO}^2 \\;\\text{parX}^2 \\;\\text{parY}^3-0.0000540389 \\;\\text{coeffO}^2 \\;\\text{parX}^2 \\;\\text{parY}^2+0.0472271 \\;\\text{coeffO}^2 \\;\\text{parX}^2 \\;\\text{parY}\\]","anchor":"cb5-1","section":"Examples"},{"text":"Here the two above expressions agree in their first 6 significant digits. Notice that the number of the size 10^{-13} is treated as a numerical fluctuation and consequently removed by Chop","anchor":"cb5-1","section":"Examples"},{"text":"FCCompareNumbers[lhs, rhs]","anchor":"cb6","section":"Examples"},{"text":"\\[\\text{FCCompareNumbers: Minimal number of significant digits to agree in: }6\\]","anchor":"cb6-1","section":"Examples"},{"text":"\\[\\text{FCCompareNumbers: Chop is set to }\\;\\text{1.$\\grave{ }$*${}^{\\wedge}$-10}\\]","anchor":"cb6-1","section":"Examples"},{"text":"\\[\\text{FCCompareNumbers: Following numbers on the l.h.s. are set to 0. by Chop: }\\{-\\text{4.06569606476957$\\grave{ }$*${}^{\\wedge}$-13}\\}\\]","anchor":"cb6-1","section":"Examples"},{"text":"\\[0\\]","anchor":"cb6-1","section":"Examples"},{"text":"The application of Chop can be of course disabled","anchor":"cb6-1","section":"Examples"},{"text":"FCCompareNumbers[lhs, rhs, Chop -> False]","anchor":"cb7","section":"Examples"}]