[{"text":"FCClausen[x,y] gives the Clausen function with arguments x and y.","anchor":"fcclausen"},{"text":"Overview","anchor":"see-also","section":"See also"},{"text":"FCClausen[2, x]","anchor":"cb1","section":"Examples"},{"text":"\\[\\text{Cl}_2(x)\\]","anchor":"cb1-1","section":"Examples"},{"text":"FCClausen[2, x] // Explicit","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{2} i \\left(\\text{Li}_2\\left(e^{-i x}\\right)-\\text{Li}_2\\left(e^{i x}\\right)\\right)\\]","anchor":"cb2-1","section":"Examples"},{"text":"FCClausen[2, 1.3]","anchor":"cb3","section":"Examples"},{"text":"\\[\\text{Cl}_2(1.3)\\]","anchor":"cb3-1","section":"Examples"},{"text":"FCClausen[2, 1.3] // N","anchor":"cb4","section":"Examples"},{"text":"\\[0.989703\\, +0. i\\]","anchor":"cb4-1","section":"Examples"},{"text":"FCClausen[2, Pi/2, Explicit -> True]","anchor":"cb5","section":"Examples"},{"text":"\\[C\\]","anchor":"cb5-1","section":"Examples"},{"text":"FCClausen[2, Pi/2, Explicit -> True] // StandardForm (*Catalan*)","anchor":"cb6","section":"Examples"}]