[{"text":"Write2[file, val1 = expr1, val2 = expr2, ...] writes the settings val1 = expr1, val2 = expr2 in sequence followed by a newline, to the specified output file. Setting the option FormatType of Write2 to FortranForm results in Fortran syntax output.","anchor":"write2"},{"text":"Overview, Isolate, PaVeReduce.","anchor":"see-also","section":"See also"},{"text":"FullForm[$FortranContinuationCharacter]","anchor":"cb1","section":"Examples"},{"text":"\\[\\&\\]","anchor":"cb1-1","section":"Examples"},{"text":"t = Collect[((a - c)^2 + (a - b)^2)^2, a, Factor]","anchor":"cb2","section":"Examples"},{"text":"\\[4 a^4-8 a^3 (b+c)+8 a^2 \\left(b^2+b c+c^2\\right)-4 a (b+c) \\left(b^2+c^2\\right)+\\left(b^2+c^2\\right)^2\\]","anchor":"cb2-1","section":"Examples"},{"text":"This writes the assignment r=t to a file.","anchor":"cb2-1","section":"Examples"},{"text":"tempfilename = ToString[$SessionID] <> \".s\"; Write2[tempfilename, r = t];","anchor":"cb3","section":"Examples"},{"text":"This shows the contents of the file.","anchor":"cb3-3","section":"Examples"},{"text":"TableForm[ReadList[If[$OperatingSystem === \"MacOS\", \":\", \"\"] <> tempfilename, String]]","anchor":"cb4","section":"Examples"},{"text":"\\[\\begin{array}{l} \\;\\text{r = ( 4*a${}^{\\wedge}$4 - 8*a${}^{\\wedge}$3*(b + c) - 4*a*(b + c)*(b${}^{\\wedge}$2 + c${}^{\\wedge}$2) + } \\\\ \\;\\text{ (b${}^{\\wedge}$2 + c${}^{\\wedge}$2)${}^{\\wedge}$2 + 8*a${}^{\\wedge}$2*(b${}^{\\wedge}$2 + b*c + c${}^{\\wedge}$2)} \\\\ \\;\\text{ );} \\\\ \\end{array}\\]","anchor":"cb4-1","section":"Examples"},{"text":"DeleteFile[If[$OperatingSystem === \"MacOS\", \":\", \"\"] <> tempfilename]","anchor":"cb5","section":"Examples"},{"text":"t2 = x + Isolate[t, a, IsolateNames -> w]","anchor":"cb6","section":"Examples"},{"text":"\\[4 a^4-8 a^3 w(19)+8 a^2 w(21)-4 a w(19) w(20)+w(20)^2+x\\]","anchor":"cb6-1","section":"Examples"},{"text":"Write2[tempfilename, r = t2];","anchor":"cb7","section":"Examples"},{"text":"TableForm[ReadList[If[$OperatingSystem === \"MacOS\", \":\", \"\"] <> tempfilename, String]]","anchor":"cb8","section":"Examples"},{"text":"\\[\\begin{array}{l} \\;\\text{w[19] = (b + c} \\\\ \\;\\text{ );} \\\\ \\;\\text{w[20] = (b${}^{\\wedge}$2 + c${}^{\\wedge}$2} \\\\ \\;\\text{ );} \\\\ \\;\\text{w[21] = (b${}^{\\wedge}$2 + b*c + c${}^{\\wedge}$2} \\\\ \\;\\text{ );} \\\\ \\;\\text{r = ( 4*a${}^{\\wedge}$4 + x - 8*a${}^{\\wedge}$3*HoldForm[w[19]] - 4*a*HoldForm[w[19]]*} \\\\ \\;\\text{ HoldForm[w[20]] + HoldForm[w[20]]${}^{\\wedge}$2 + 8*a${}^{\\wedge}$2*HoldForm[w[21]]} \\\\ \\;\\text{ );} \\\\ \\end{array}\\]","anchor":"cb8-1","section":"Examples"},{"text":"DeleteFile[If[$OperatingSystem === \"MacOS\", \":\", \"\"] <> tempfilename]","anchor":"cb9","section":"Examples"},{"text":"This is how to write out the expression t2 in Fortran format.","anchor":"cb9-1","section":"Examples"},{"text":"Write2[tempfilename, r = t2, FormatType -> FortranForm];","anchor":"cb10","section":"Examples"},{"text":"TableForm[ReadList[If[$OperatingSystem === \"MacOS\", \":\", \"\"] <> tempfilename, String]]","anchor":"cb11","section":"Examples"},{"text":"\\[\\begin{array}{l} \\;\\text{ w(19)= b + c} \\\\ \\;\\text{ w(20)= b**2 + c**2} \\\\ \\;\\text{ w(21)= b**2 + b*c + c**2} \\\\ \\;\\text{ r = x + a**4*4D0 - a**3*8D0*w(19) - a*4D0*w(19)*w(20) + } \\\\ \\;\\text{ $\\&$ w(20)**2 + a**2*8D0*w(21)} \\\\ \\;\\text{ } \\\\ \\end{array}\\]","anchor":"cb11-1","section":"Examples"},{"text":"DeleteFile[If[$OperatingSystem === \"MacOS\", \":\", \"\"] <> tempfilename]; Clear[w, t, t2, r, tempfilename];","anchor":"cb12","section":"Examples"}]