[{"text":"SPLP[p,q,n,nb] denotes the positive component in the lightcone decomposition of the scalar product p \\cdot q along the vectors n and nb. It corresponds to \\frac{1}{2} (p \\cdot n) (q \\cdot \\bar{n}).","anchor":"splp"},{"text":"Overview, Pair, FVLN, FVLP, FVLR, SPLN, SPLR, MTLP, MTLN, MTLR.","anchor":"see-also","section":"See also"},{"text":"SPLP[p, q, n, nb]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{1}{2} \\left(\\overline{n}\\cdot \\overline{p}\\right) \\left(\\overline{\\text{nb}}\\cdot \\overline{q}\\right)\\]","anchor":"cb1-1","section":"Examples"},{"text":"StandardForm[SPLP[p, q, n, nb] // FCI]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{2} \\;\\text{Pair}[\\text{Momentum}[n],\\text{Momentum}[p]] \\;\\text{Pair}[\\text{Momentum}[\\text{nb}],\\text{Momentum}[q]]\\]","anchor":"cb2-1","section":"Examples"},{"text":"SPLP[p1 + p2 + n, q, n, nb] // ExpandScalarProduct","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{1}{2} \\left(\\overline{\\text{nb}}\\cdot \\overline{q}\\right) \\left(\\overline{n}\\cdot \\overline{\\text{p1}}+\\overline{n}\\cdot \\overline{\\text{p2}}+\\overline{n}^2\\right)\\]","anchor":"cb3-1","section":"Examples"},{"text":"SPLP[p1 + p2 + n, q, n, nb] // ExpandScalarProduct","anchor":"cb5","section":"Examples"},{"text":"\\[\\frac{1}{2} \\left(\\overline{\\text{nb}}\\cdot \\overline{q}\\right) \\left(\\overline{n}\\cdot \\overline{\\text{p1}}+\\overline{n}\\cdot \\overline{\\text{p2}}\\right)\\]","anchor":"cb5-1","section":"Examples"},{"text":"FCClearScalarProducts[]","anchor":"cb6","section":"Examples"}]