[{"text":"Sometimes one might want to define custom symbolic tensors that are not specified in terms of the 4-vectors, metric tensors and Levi-Civitas. This is possible in FeynCalc, but the handling of such objects is not as good as that of the built-in quantities","anchor":"cb9-1","section":"Manipulations of tensorial quantities"},{"text":"DeclareFCTensor[myTensor];","anchor":"cb10","section":"Manipulations of tensorial quantities"},{"text":"myTensor[LorentzIndex[\\[Mu]], LorentzIndex[\\[Nu]]] FV[p, \\[Nu]] FV[q, \\[Mu]] ex = Contract[%]","anchor":"cb11","section":"Manipulations of tensorial quantities"},{"text":"\\[\\overline{p}^{\\nu } \\overline{q}^{\\mu } \\;\\text{myTensor}(\\mu ,\\nu )\\]","anchor":"cb11-2","section":"Manipulations of tensorial quantities"},{"text":"\\text{myTensor}\\left(\\overline{q},\\overline{p}\\right)","anchor":"cb11-2","section":"Manipulations of tensorial quantities"},{"text":"Uncontract[ex, p, q, Pair -> All]","anchor":"cb12","section":"Manipulations of tensorial quantities"},{"text":"\\[\\overline{p}^{\\text{\\$AL}(\\text{\\$36})} \\overline{q}^{\\text{\\$AL}(\\text{\\$35})} \\;\\text{myTensor}(\\text{\\$AL}(\\text{\\$35}),\\text{\\$AL}(\\text{\\$36}))\\]","anchor":"cb12-1","section":"Manipulations of tensorial quantities"},{"text":"(myTensor[LorentzIndex[\\[Mu]], LorentzIndex[\\[Nu]]] MT[LorentzIndex[\\[Mu]], LorentzIndex[\\[Nu]]] + myTensor[LorentzIndex[\\[Alpha]], LorentzIndex[\\[Beta]]] MT[LorentzIndex[\\[Alpha]], LorentzIndex[\\[Beta]]]) FCCanonicalizeDummyIndices[%, LorentzIndexNames -> {i1, i2}]","anchor":"cb13","section":"Manipulations of tensorial quantities"},{"text":"\\[\\bar{g}^{\\alpha \\beta } \\;\\text{myTensor}(\\alpha ,\\beta )+\\bar{g}^{\\mu \\nu } \\;\\text{myTensor}(\\mu ,\\nu )\\]","anchor":"cb13-3","section":"Manipulations of tensorial quantities"},{"text":"\\[2 \\bar{g}^{\\text{i1}\\;\\text{i2}} \\;\\text{myTensor}(\\text{i1},\\text{i2})\\]","anchor":"cb13-3","section":"Manipulations of tensorial quantities"},{"text":"To extract the list of free or dummy indices present in the expression, one can use FCGetFreeIndices and FCGetDummyIndices respectively","anchor":"cb13-3","section":"Manipulations of tensorial quantities"},{"text":"FCI[FV[p, \\[Mu]] FV[q, \\[Nu]]] FCGetFreeIndices[%, {LorentzIndex}]","anchor":"cb14","section":"Manipulations of tensorial quantities"},{"text":"\\[\\overline{p}^{\\mu } \\overline{q}^{\\nu }\\]","anchor":"cb14-2","section":"Manipulations of tensorial quantities"},{"text":"\\[\\{\\mu ,\\nu \\}\\]","anchor":"cb14-2","section":"Manipulations of tensorial quantities"},{"text":"```mathematica FCI[FV[p, [Mu]] FV[q, [Mu]]] FCGetDummyIndices[%, {LorentzIndex}]","anchor":"cb14-2","section":"Manipulations of tensorial quantities"},{"text":"```mathematica","anchor":"cb14-2","section":"Manipulations of tensorial quantities"},{"text":"\\[\\overline{p}^{\\mu } \\overline{q}^{\\mu }\\]","anchor":"cb14-2","section":"Manipulations of tensorial quantities"},{"text":"\\[\\{\\mu \\}\\]","anchor":"cb14-2","section":"Manipulations of tensorial quantities"}]