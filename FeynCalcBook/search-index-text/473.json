[{"text":"FCRemoveTypesettingRules[expr] removes all typesetting rules attached to expr. Effectively it sets the FormatValues of expr to an empty list.","anchor":"fcremovetypesettingrules"},{"text":"Overview, FCAttachTypesettingRule.","anchor":"see-also","section":"See also"},{"text":"ST1","anchor":"cb1","section":"Examples"},{"text":"\\[\\text{ST1}\\]","anchor":"cb1-1","section":"Examples"},{"text":"FCAttachTypesettingRule[ST1, {SubscriptBox, \"S\", \"T,1\"}]","anchor":"cb2","section":"Examples"},{"text":"ST1","anchor":"cb3","section":"Examples"},{"text":"\\[S_{T,1}\\]","anchor":"cb3-1","section":"Examples"},{"text":"FCRemoveTypesettingRules[ST1] ST1","anchor":"cb4","section":"Examples"},{"text":"\\[\\text{ST1}\\]","anchor":"cb4-3","section":"Examples"}]