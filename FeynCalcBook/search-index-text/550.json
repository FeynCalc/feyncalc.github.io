[{"text":"FromFCPartialFractionForm[exp] converts all FCPartialFractionForm symbols present in exp back into the standard representation.","anchor":"fromfcpartialfractionform"},{"text":"Overview, ToFCPartialFractionForm, FCPartialFractionForm.","anchor":"see-also","section":"See also"},{"text":"FromFCPartialFractionForm[FCPartialFractionForm[x, {}, x]]","anchor":"cb1","section":"Examples"},{"text":"\\[x\\]","anchor":"cb1-1","section":"Examples"},{"text":"FromFCPartialFractionForm[FCPartialFractionForm[0, {{{x - 1, -2}, 1}}, x]]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{(x-1)^2}\\]","anchor":"cb2-1","section":"Examples"},{"text":"FromFCPartialFractionForm[FCPartialFractionForm[0, {{{x + 1, -1}, 1}, {{x - y, -2}, c}}, x]]","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{c}{(x-y)^2}+\\frac{1}{x+1}\\]","anchor":"cb3-1","section":"Examples"},{"text":"FromFCPartialFractionForm[FCPartialFractionForm[0, {{{x + 1, -1}, 1}, {{x - y, -2}, c}}, x], Factoring -> Together]","anchor":"cb4","section":"Examples"},{"text":"\\[\\frac{c x+c+x^2-2 x y+y^2}{(x+1) (x-y)^2}\\]","anchor":"cb4-1","section":"Examples"}]