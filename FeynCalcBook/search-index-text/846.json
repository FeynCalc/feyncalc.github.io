[{"text":"SelectNotFree[expr, x] returns that part of expr which is not free of any occurrence of x.","anchor":"selectnotfree"},{"text":"SelectNotFree[expr, a, b, ...] is equivalent to Select[expr, !FreeQ2[#, {a, b, ...}]&], except the special cases: SelectNotFree[a, b] returns 1 and SelectNotFree[a, a] returns a (where a is not a product or a sum).","anchor":"selectnotfree"},{"text":"Overview, FreeQ2, SelectFree.","anchor":"see-also","section":"See also"},{"text":"SelectNotFree[a + b + f[a], a]","anchor":"cb1","section":"Examples"},{"text":"\\[f(a)+a\\]","anchor":"cb1-1","section":"Examples"},{"text":"SelectNotFree[2 x y f[x] z, {x, y}]","anchor":"cb2","section":"Examples"},{"text":"\\[x y f(x)\\]","anchor":"cb2-1","section":"Examples"},{"text":"SelectNotFree[a, b]","anchor":"cb3","section":"Examples"},{"text":"\\[1\\]","anchor":"cb3-1","section":"Examples"},{"text":"SelectNotFree[a + x, b]","anchor":"cb4","section":"Examples"},{"text":"\\[0\\]","anchor":"cb4-1","section":"Examples"},{"text":"SelectNotFree[a, a]","anchor":"cb5","section":"Examples"},{"text":"\\[a\\]","anchor":"cb5-1","section":"Examples"},{"text":"SelectNotFree[1, c]","anchor":"cb6","section":"Examples"},{"text":"\\[1\\]","anchor":"cb6-1","section":"Examples"},{"text":"SelectNotFree[f[x], x]","anchor":"cb7","section":"Examples"},{"text":"\\[f(x)\\]","anchor":"cb7-1","section":"Examples"}]