[{"text":"SumT[1, m] is the alternative harmonic number \\sum _{i=1}^m (-1){}^{\\wedge}i/i","anchor":"sumt"},{"text":"SumT[r, n] represents Sum[(-1)^i/i^r, {i,1,n}]","anchor":"sumt"},{"text":"SumT[r,s, n] is Sum[1/k^r (-1)^j/j^s, {k, 1, n}, {j, 1, k}].","anchor":"sumt"},{"text":"Overview, SumP, SumS.","anchor":"see-also","section":"See also"},{"text":"SumT[1, m - 1]","anchor":"cb1","section":"Examples"},{"text":"\\[\\tilde{S}_1(m-1)\\]","anchor":"cb1-1","section":"Examples"},{"text":"SumT[2, m - 1]","anchor":"cb2","section":"Examples"},{"text":"\\[\\tilde{S}_2(m-1)\\]","anchor":"cb2-1","section":"Examples"},{"text":"SumT[1, m]","anchor":"cb3","section":"Examples"},{"text":"\\[\\tilde{S}_1(m)\\]","anchor":"cb3-1","section":"Examples"},{"text":"SumT[1, m, Reduce -> True]","anchor":"cb4","section":"Examples"},{"text":"\\tilde{S}_1(m-1)+\\frac{(-1)^m}{m}","anchor":"cb4-1","section":"Examples"},{"text":"SumT[1, 4]","anchor":"cb5","section":"Examples"},{"text":"\\[-\\frac{7}{12}\\]","anchor":"cb5-1","section":"Examples"},{"text":"SumT[1, 2, m - 1]","anchor":"cb6","section":"Examples"},{"text":"\\[\\tilde{S}_{12}(m-1)\\]","anchor":"cb6-1","section":"Examples"},{"text":"SumT[1, 2, 42]","anchor":"cb7","section":"Examples"},{"text":"-\\frac{38987958697055013360489864298703621429610152138683927}{10512121660702378405316004964483761080879190528000000}","anchor":"cb7-1","section":"Examples"},{"text":"SumT[1, 4]","anchor":"cb8","section":"Examples"},{"text":"\\[-\\frac{7}{12}\\]","anchor":"cb8-1","section":"Examples"},{"text":"SumS[-1, 4]","anchor":"cb9","section":"Examples"},{"text":"\\[-\\frac{7}{12}\\]","anchor":"cb9-1","section":"Examples"},{"text":"SumT[1, 2, 12]","anchor":"cb10","section":"Examples"},{"text":"-\\frac{57561743656913}{21300003648000}","anchor":"cb10-1","section":"Examples"},{"text":"SumS[1, -2, 42]","anchor":"cb11","section":"Examples"},{"text":"-\\frac{38987958697055013360489864298703621429610152138683927}{10512121660702378405316004964483761080879190528000000