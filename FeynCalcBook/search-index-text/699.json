[{"text":"Momentum[p] is the head of a four momentum p.","anchor":"momentum"},{"text":"The internal representation of a 4-dimensional p is Momentum[p].","anchor":"momentum"},{"text":"For other than \\(4\\) dimensions: Momentum[p, dim].","anchor":"momentum"},{"text":"Momentum[p, 4] simplifies to Momentum[p].","anchor":"momentum"},{"text":"Overview, DiracGamma, Eps, LorentzIndex, MomentumExpand.","anchor":"see-also","section":"See also"},{"text":"This is a \\(4\\)-dimensional momentum.","anchor":"examples","section":"Examples"},{"text":"Momentum[p]","anchor":"cb1","section":"Examples"},{"text":"\\[\\overline{p}\\]","anchor":"cb1-1","section":"Examples"},{"text":"As an optional second argument the dimension must be specified if it is different from \\(4\\).","anchor":"cb1-1","section":"Examples"},{"text":"Momentum[p, D]","anchor":"cb2","section":"Examples"},{"text":"\\[p\\]","anchor":"cb2-1","section":"Examples"},{"text":"The dimension index is suppressed in the output.","anchor":"cb2-1","section":"Examples"},{"text":"Momentum[p, d]","anchor":"cb3","section":"Examples"},{"text":"\\[p\\]","anchor":"cb3-1","section":"Examples"},{"text":"Momentum[-q]","anchor":"cb4","section":"Examples"},{"text":"\\[-\\overline{q}\\]","anchor":"cb4-1","section":"Examples"},{"text":"Momentum[-q] // StandardForm (*-Momentum[q]*)","anchor":"cb5","section":"Examples"},{"text":"ex = Momentum[p - q] + Momentum[2 q]","anchor":"cb6","section":"Examples"},{"text":"\\[\\left(\\overline{p}-\\overline{q}\\right)+2 \\overline{q}\\]","anchor":"cb6-1","section":"Examples"},{"text":"ex // StandardForm (*Momentum[p - q] + 2 Momentum[q]*)","anchor":"cb7","section":"Examples"},{"text":"ex // MomentumExpand // StandardForm (*Momentum[p] + Momentum[q]*)","anchor":"cb8","section":"Examples"},{"text":"ex // MomentumCombine // StandardForm (*Momentum[p + q]*)","anchor":"cb9","section":"Examples"},{"text":"ChangeDimension[Momentum[p], d] // StandardForm (*Momentum[p, d]*)","anchor":"cb10","section":"Examples"}]