[{"text":"No surprise that following does not work","anchor":"cb21-1","section":"Why it matters"},{"text":"ex /. SP[p, q] -> 1","anchor":"cb22","section":"Why it matters"},{"text":"\\[\\overline{p}\\cdot \\overline{q}\\]","anchor":"cb22-1","section":"Why it matters"},{"text":"But if we wrap the r.h.s of the rule with FCI, then everything is fine","anchor":"cb22-1","section":"Why it matters"},{"text":"ex /. FCI[SP[p, q]] -> 1","anchor":"cb23","section":"Why it matters"},{"text":"\\[1\\]","anchor":"cb23-1","section":"Why it matters"}]