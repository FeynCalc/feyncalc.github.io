[{"text":"B11[pp, ma^2, mb^2] is the Passarino-Veltman B_{11}-function, i.e. the coefficient function of \\(p^{\\mu } p^{\\nu }\\). All arguments are scalars and have dimension mass squared.","anchor":"b11"},{"text":"Overview, B0, B00, B1, PaVe.","anchor":"see-also","section":"See also"},{"text":"B11[SPD[p], m^2, M^2]","anchor":"cb1","section":"Examples"},{"text":"\\[-\\frac{\\left(D m^4-2 D m^2 M^2+2 D m^2 p^2+D M^4-2 D M^2 p^2+D p^4-4 m^2 p^2\\right) \\;\\text{B}_0\\left(p^2,m^2,M^2\\right)}{4 (1-D) p^4}+\\frac{D \\;\\text{A}_0\\left(m^2\\right) \\left(m^2-M^2+p^2\\right)}{4 (1-D) p^4}-\\frac{\\text{A}_0\\left(M^2\\right) \\left(D m^2-D M^2+3 D p^2-4 p^2\\right)}{4 (1-D) p^4}\\]","anchor":"cb1-1","section":"Examples"},{"text":"B11[SPD[p], m^2, M^2, BReduce -> False]","anchor":"cb2","section":"Examples"},{"text":"\\text{B}_{11}\\left(p^2,m^2,M^2\\right)","anchor":"cb2-1","section":"Examples"},{"text":"B11[SPD[p], m^2, m^2]","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{\\left(4 m^2-D p^2\\right) \\;\\text{B}_0\\left(p^2,m^2,m^2\\right)}{4 (1-D) p^2}+\\frac{(2-D) \\;\\text{A}_0\\left(m^2\\right)}{2 (1-D) p^2}\\]","anchor":"cb3-1","section":"Examples"},{"text":"B11[SPD[p], m^2, m^2, BReduce -> False]","anchor":"cb4","section":"Examples"},{"text":"\\text{B}_{11}\\left(p^2,m^2,m^2\\right)","anchor":"cb4-1","section":"Examples"},{"text":"B11[0, m^2, m^2]","anchor":"cb5","section":"Examples"},{"text":"\\[\\frac{1}{3} \\;\\text{B}_0\\left(0,m^2,m^2\\right)\\]","anchor":"cb5-1","section":"Examples"},{"text":"B11[0, m^2, m^2, BReduce -> False]","anchor":"cb6","section":"Examples"},{"text":"\\text{B}_{11}\\left(0,m^2,m^2\\right)","anchor":"cb6-1","section":"Examples"},{"text":"B11[SmallVariable[M^2], m^2, m^2]","anchor":"cb7","section":"Examples"},{"text":"\\[\\frac{m^2 \\;\\text{B}_0\\left(M^2,m^2,m^2\\right)}{(1-D) M^2}+\\frac{(2-D) \\;\\text{A}_0\\left(m^2\\right)}{2 (1-D) M^2}\\]","anchor":"cb7-1","section":"Examples"},{"text":"B11[SmallVariable[M^2], m^2, m^2, BReduce -> False]","anchor":"cb8","section":"Examples"},{"text":"\\text{B}_{11}\\left(M^2,m^2,m^2\\right)","anchor":"cb8-1","section":"Examples"}]