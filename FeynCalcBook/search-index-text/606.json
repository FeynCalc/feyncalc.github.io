[{"text":"GSLN[p,n,nb] denotes the negative component in the lightcone decomposition of the slashed Dirac matrix (\\gamma \\cdot p) along the vectors n and nb. It corresponds to \\frac{1}{2} (n \\cdot p) (\\gamma \\cdot \\bar{n}).","anchor":"gsln"},{"text":"Overview, DiracGamma, GALP, GALN, GALR, GSLP, GSLR.","anchor":"see-also","section":"See also"},{"text":"GSLN[p, n, nb]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{1}{2} \\left(\\overline{n}\\cdot \\overline{p}\\right) \\bar{\\gamma }\\cdot \\overline{\\text{nb}}\\]","anchor":"cb1-1","section":"Examples"},{"text":"StandardForm[GSLN[p, n, nb] // FCI]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{2} \\;\\text{DiracGamma}[\\text{Momentum}[\\text{nb}]] \\;\\text{Pair}[\\text{Momentum}[n],\\text{Momentum}[p]]\\]","anchor":"cb2-1","section":"Examples"},{"text":"GSLN[p, n, nb] . GSLN[q, n, nb] // DiracSimplify","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{1}{4} \\overline{\\text{nb}}^2 \\left(\\overline{n}\\cdot \\overline{p}\\right) \\left(\\overline{n}\\cdot \\overline{q}\\right)\\]","anchor":"cb3-1","section":"Examples"},{"text":"GSLN[p, n, nb] . GSLN[q, n, nb] // DiracSimplify","anchor":"cb5","section":"Examples"},{"text":"\\[0\\]","anchor":"cb5-1","section":"Examples"},{"text":"FCClearScalarProducts[]","anchor":"cb6","section":"Examples"}]