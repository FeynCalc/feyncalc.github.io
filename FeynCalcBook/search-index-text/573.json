[{"text":"GALP[mu,n,nb] denotes the positive component in the lightcone decomposition of the Dirac matrix \\gamma^{\\mu } along the vectors n and nb. It corresponds to \\frac{1}{2} \\bar{n}^{\\mu} (\\gamma \\cdot n).","anchor":"galp"},{"text":"Overview, DiracGamma, GALN, GALR, GSLP, GSLN, GSLR.","anchor":"see-also","section":"See also"},{"text":"GALP[\\[Mu], n, nb]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{1}{2} \\overline{\\text{nb}}^{\\mu } \\bar{\\gamma }\\cdot \\overline{n}\\]","anchor":"cb1-1","section":"Examples"},{"text":"StandardForm[GALP[\\[Mu], n, nb] // FCI]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{2} \\;\\text{DiracGamma}[\\text{Momentum}[n]] \\;\\text{Pair}[\\text{LorentzIndex}[\\mu ],\\text{Momentum}[\\text{nb}]]\\]","anchor":"cb2-1","section":"Examples"},{"text":"GALP[\\[Mu], n, nb] . GALP[\\[Nu], n, nb] // DiracSimplify","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{1}{4} \\overline{n}^2 \\overline{\\text{nb}}^{\\mu } \\overline{\\text{nb}}^{\\nu }\\]","anchor":"cb3-1","section":"Examples"},{"text":"GALP[\\[Mu], n, nb] . GALP[\\[Nu], n, nb] // DiracSimplify","anchor":"cb5","section":"Examples"},{"text":"\\[0\\]","anchor":"cb5-1","section":"Examples"},{"text":"FCClearScalarProducts[]","anchor":"cb6","section":"Examples"}]