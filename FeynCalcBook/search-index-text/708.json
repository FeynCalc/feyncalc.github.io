[{"text":"MTLP[mu,nu,n,nb] denotes the positive component in the lightcone decomposition of the metric tensor g^{\\mu \\nu} along the vectors n and nb. It corresponds to \\frac{1}{2} \\bar{n}^{\\mu} n^\\nu.","anchor":"mtlp"},{"text":"Overview, Pair, FVLP, FVLN, FVLR, SPLP, SPLN, SPLR, MTLN, MTLR.","anchor":"see-also","section":"See also"},{"text":"MTLP[\\[Mu], \\[Nu], n, nb]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{1}{2} \\overline{n}^{\\nu } \\overline{\\text{nb}}^{\\mu }\\]","anchor":"cb1-1","section":"Examples"},{"text":"StandardForm[MTLP[\\[Mu], \\[Nu], n, nb] // FCI]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{1}{2} \\;\\text{Pair}[\\text{LorentzIndex}[\\mu ],\\text{Momentum}[\\text{nb}]] \\;\\text{Pair}[\\text{LorentzIndex}[\\nu ],\\text{Momentum}[n]]\\]","anchor":"cb2-1","section":"Examples"},{"text":"MTLP[\\[Mu], \\[Nu], n, nb] FV[p, \\[Mu]] // Contract","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{1}{2} \\overline{n}^{\\nu } \\left(\\overline{\\text{nb}}\\cdot \\overline{p}\\right)\\]","anchor":"cb3-1","section":"Examples"},{"text":"MTLP[\\[Mu], \\[Nu], n, nb] FV[p, \\[Nu]] // Contract","anchor":"cb4","section":"Examples"},{"text":"\\[\\frac{1}{2} \\overline{\\text{nb}}^{\\mu } \\left(\\overline{n}\\cdot \\overline{p}\\right)\\]","anchor":"cb4-1","section":"Examples"},{"text":"MTLP[\\[Mu], \\[Nu], n, nb] FV[n, \\[Nu]] // Contract","anchor":"cb5","section":"Examples"},{"text":"\\[\\frac{1}{2} \\overline{n}^2 \\overline{\\text{nb}}^{\\mu }\\]","anchor":"cb5-1","section":"Examples"},{"text":"MTLP[\\[Mu], \\[Nu], n, nb] FV[n, \\[Nu]] // Contract","anchor":"cb7","section":"Examples"},{"text":"\\[0\\]","anchor":"cb7-1","section":"Examples"},{"text":"FCClearScalarProducts[]","anchor":"cb8","section":"Examples"}]