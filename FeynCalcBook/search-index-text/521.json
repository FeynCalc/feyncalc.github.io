[{"text":"FeynCalc2FORM[exp] displays exp in FORM syntax.","anchor":"feyncalc2form"},{"text":"FeynCalc2FORM[file, x] writes x in FORM syntax to a file.","anchor":"feyncalc2form"},{"text":"FeynCalc2FORM[file, x == y] writes x=y to a file in FORM syntax.","anchor":"feyncalc2form"},{"text":"The capabilities of this function are very limited, so you should not expect it to easily handle large and complicated expressions.","anchor":"feyncalc2form"},{"text":"Overview, FeynCalc2FORM.","anchor":"see-also","section":"See also"},{"text":"FORM2FeynCalc","anchor":"cb1","section":"Examples"},{"text":"\\[\\text{FORM2FeynCalc}\\]","anchor":"cb1-1","section":"Examples"},{"text":"MT[\\[Mu], \\[Nu]] FV[p, \\[Rho]] y^2/d FeynCalc2FORM[%];","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{y^2 \\overline{p}^{\\rho } \\bar{g}^{\\mu \\nu }}{d}\\]","anchor":"cb2-3","section":"Examples"},{"text":"(y^2d_(mu,nu)p(ro))/d","anchor":"cb2-3","section":"Examples"},{"text":"LC[\\[Alpha], \\[Beta], \\[Delta], \\[Rho]] FeynCalc2FORM[%];","anchor":"cb3","section":"Examples"},{"text":"\\[\\bar{\\epsilon }^{\\alpha \\beta \\delta \\rho }\\]","anchor":"cb3-3","section":"Examples"},{"text":"(-i_)*e_(al,be,de,ro)","anchor":"cb3-3","section":"Examples"},{"text":"DiracTrace[GA[\\[Mu], \\[Nu], \\[Rho], \\[Sigma]]] FeynCalc2FORM[%];","anchor":"cb4","section":"Examples"},{"text":"\\[\\text{tr}\\left(\\bar{\\gamma }^{\\mu }.\\bar{\\gamma }^{\\nu }.\\bar{\\gamma }^{\\rho }.\\bar{\\gamma }^{\\sigma }\\right)\\]","anchor":"cb4-3","section":"Examples"},{"text":"g_(0,mu)g_(0,nu)g_(0,ro)*g_(0,si)","anchor":"cb4-3","section":"Examples"},{"text":"DiracTrace[GA[\\[Mu], \\[Nu]]] DiracTrace[GA[\\[Mu], \\[Rho]]] FeynCalc2FORM[%];","anchor":"cb5","section":"Examples"},{"text":"\\[\\text{tr}\\left(\\bar{\\gamma }^{\\mu }.\\bar{\\gamma }^{\\nu }\\right) \\;\\text{tr}\\left(\\bar{\\gamma }^{\\mu }.\\bar{\\gamma }^{\\rho }\\right)\\]","anchor":"cb5-3","section":"Examples"},{"text":"g_(0,mu)g_(0,nu)g_(1,mu)*g_(1,ro)","anchor":"cb5-3","section":"Examples"},{"text":"t = DiracSimplify[DiracTrace[GA[\\[Mu], \\[Nu], \\[Rho], \\[Sigma]] . GS[p, q]]]","anchor":"cb6","section":"Examples"},{"text":"FeynCalc2FORM[\"fc2ftest.f\", L == t];","anchor":"cb7","section":"Examples"},{"text":"TableForm[ReadList[If[$OperatingSystem === \"MacOS\", \":\", \"\"] <> \"fc2ftest.f\", String]]","anchor":"cb8","section":"Examples"},{"text":"\\[\\begin{array}{l} \\;\\text{Indices $\\backslash \\backslash $[Mu],$\\backslash \\backslash $[Nu],$\\backslash \\backslash $[Rho],$\\backslash \\backslash $[Sigma];} \\\\ \\;\\text{Vectors OPEDelta,p,q;} \\\\ \\;\\text{write statistics;} \\\\ \\;\\text{Local L = ( } \\\\ \\;\\text{4*d$\\_$(mu,si)*d$\\_$(nu,ro)*q.p-4*d$\\_$(mu,ro)*d$\\_$(nu,si)*q.p+4*d$\\_$(mu,nu)*d$\\_$(ro,si)*q.p+} \\\\ \\;\\text{4*d$\\_$(ro,si)*p(nu)*q(mu)-4*d$\\_$(nu,si)*p(ro)*q(mu)+4*d$\\_$(nu,ro)*p(si)*q(mu)-} \\\\ \\;\\text{4*d$\\_$(ro,si)*p(mu)*q(nu)+4*d$\\_$(mu,si)*p(ro)*q(nu)-4*d$\\_$(mu,ro)*p(si)*q(nu)+} \\\\ \\;\\text{4*d$\\_$(nu,si)*p(mu)*q(ro)-4*d$\\_$(mu,si)*p(nu)*q(ro)+4*d$\\_$(mu,nu)*p(si)*q(ro)-} \\\\ \\;\\text{4*d$\\_$(nu,ro)*p(mu)*q(si)+4*d$\\_$(mu,ro)*p(nu)*q(si)-4*d$\\_$(mu,nu)*p(ro)*q(si) ); } \\\\ \\;\\text{ } \\\\ \\;\\text{print;} \\\\ \\;\\text{.end} \\\\ \\end{array}\\]","anchor":"cb8-1","section":"Examples"},{"text":"If[FileNames[\"fc2ftest.f\"] =!= {}, DeleteFile[\"fc2ftest.f\"]];","anchor":"cb9","section":"Examples"},{"text":"Clear[t];","anchor":"cb10","section":"Examples"}]