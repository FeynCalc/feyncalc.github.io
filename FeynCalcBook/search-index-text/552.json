[{"text":"ex = GFAD[{{SPD[k1, k1] - 2*gkin*meta*u0b*SPD[k1, n], 1}, 1}];","anchor":"cb15","section":"Examples"},{"text":"Notice that we need to declare the appearing variables as FCVariables","anchor":"cb15-1","section":"Examples"},{"text":"(DataType[#, FCVariable] = True) & /@ {gkin, meta, u0b};","anchor":"cb16","section":"Examples"},{"text":"Without these options we get a mixed quadratic-eikonal propagator that will cause us troubles when doing topology minimizations.","anchor":"cb16-1","section":"Examples"},{"text":"FromGFAD[ex, FCE -> True] % // InputForm","anchor":"cb17","section":"Examples"},{"text":"\\text{FromGFAD}(\\text{GFAD}(\\{\\{\\text{SPD}(\\text{k1},\\text{k1})-2 \\;\\text{gkin} \\;\\text{meta} \\;\\text{u0b} \\;\\text{SPD}(\\text{k1},n),1\\},1\\}),\\text{FCE}\\to \\;\\text{True})","anchor":"cb17-2","section":"Examples"},{"text":"FromGFAD[GFAD[{{SPD[k1, k1] - 2*gkin*meta*u0b*SPD[k1, n], 1}, 1}], FCE -> True]","anchor":"cb18","section":"Examples"},{"text":"But when doing everything right we end up with a purely quadratic propagator","anchor":"cb18-2","section":"Examples"},{"text":"FromGFAD[ex, InitialSubstitutions -> {ExpandScalarProduct[SPD[k1 - gkin meta u0b n]] -> SPD[k1 - gkin meta u0b n]}, IntermediateSubstitutions -> {SPD[n] -> 0, SPD[nb] -> 0, SPD[n, nb] -> 2}]","anchor":"cb19","section":"Examples"},{"text":"\\text{FromGFAD}(\\text{GFAD}(\\{\\{\\text{SPD}(\\text{k1},\\text{k1})-2 \\;\\text{gkin} \\;\\text{meta} \\;\\text{u0b} \\;\\text{SPD}(\\text{k1},n),1\\},1\\}),\\text{InitialSubstitutions}\\to \\{\\text{ExpandScalarProduct}(\\text{SPD}(\\text{k1}-\\text{gkin} \\;\\text{meta} n \\;\\text{u0b}))\\to \\;\\text{SPD}(\\text{k1}-\\text{gkin} \\;\\text{meta} n \\;\\text{u0b})\\},\\text{IntermediateSubstitutions}\\to \\{\\text{SPD}(n)\\to 0,\\text{SPD}(\\text{nb})\\to 0,\\text{SPD}(n,\\text{nb})\\to 2\\})","anchor":"cb19-2","section":"Examples"},{"text":"However, in this case the function can also figure out the necessary square completion on its own if we tell it that k1 is a momentum w.r.t which the square should be completed. In this case the option IntermediateSubstitutions is not really needed","anchor":"cb19-2","section":"Examples"},{"text":"FromGFAD[ex, LoopMomenta -> {k1}]","anchor":"cb20","section":"Examples"},{"text":"\\text{FromGFAD}(\\text{GFAD}(\\{\\{\\text{SPD}(\\text{k1},\\text{k1})-2 \\;\\text{gkin} \\;\\text{meta} \\;\\text{u0b} \\;\\text{SPD}(\\text{k1},n),1\\},1\\}),\\text{LoopMomenta}\\to \\{\\text{k1}\\})","anchor":"cb20-1","section":"Examples"},{"text":"It is still helpful, though","anchor":"cb20-1","section":"Examples"},{"text":"FromGFAD[ex, LoopMomenta -> {k1}, IntermediateSubstitutions -> {SPD[n] -> 0, SPD[nb] -> 0, SPD[n, nb] -> 2}]","anchor":"cb21","section":"Examples"},{"text":"\\text{FromGFAD}(\\text{GFAD}(\\{\\{\\text{SPD}(\\text{k1},\\text{k1})-2 \\;\\text{gkin} \\;\\text{meta} \\;\\text{u0b} \\;\\text{SPD}(\\text{k1},n),1\\},1\\}),\\text{LoopMomenta}\\to \\{\\text{k1}\\},\\text{IntermediateSubstitutions}\\to \\{\\text{SPD}(n)\\to 0,\\text{SPD}(\\text{nb})\\to 0,\\text{SPD}(n,\\text{nb})\\to 2\\})","anchor":"cb21-1","section":"Examples"},{"text":"If we have multiple loop momenta, we need to first complete the square with respect to them before handling the full expression","anchor":"cb21-1","section":"Examples"},{"text":"ex = GFAD[{{SPD[k1, k1] + 2 SPD[k1, k2] + SPD[k2, k2] + 2 gkin meta (SPD[k1, n] + SPD[k2, n]), 1}, 1}]","anchor":"cb22","section":"Examples"},{"text":"\\[\\text{GFAD}(\\{\\{2 \\;\\text{gkin} \\;\\text{meta} (\\text{SPD}(\\text{k1},n)+\\text{SPD}(\\text{k2},n))+2 \\;\\text{SPD}(\\text{k1},\\text{k2})+\\text{SPD}(\\text{k1},\\text{k1})+\\text{SPD}(\\text{k2},\\text{k2}),1\\},1\\})\\]","anchor":"cb22-1","section":"Examples"},{"text":"FromGFAD[ex, LoopMomenta -> {k1, k2}]","anchor":"cb23","section":"Examples"},{"text":"\\[\\text{FromGFAD}(\\text{GFAD}(\\{\\{2 \\;\\text{gkin} \\;\\text{meta} (\\text{SPD}(\\text{k1},n)+\\text{SPD}(\\text{k2},n))+2 \\;\\text{SPD}(\\text{k1},\\text{k2})+\\text{SPD}(\\text{k1},\\text{k1})+\\text{SPD}(\\text{k2},\\text{k2}),1\\},1\\}),\\text{LoopMomenta}\\to \\{\\text{k1},\\text{k2}\\})\\]","anchor":"cb23-1","section":"Examples"},{"text":"FromGFAD[ex, LoopMomenta -> {k1, k2}, InitialSubstitutions -> {ExpandScalarProduct[SPD[k1 + k2]] -> SPD[k1 + k2]}, IntermediateSubstitutions -> {SPD[n] -> 0}]","anchor":"cb24","section":"Examples"},{"text":"\\[\\text{FromGFAD}(\\text{GFAD}(\\{\\{2 \\;\\text{gkin} \\;\\text{meta} (\\text{SPD}(\\text{k1},n)+\\text{SPD}(\\text{k2},n))+2 \\;\\text{SPD}(\\text{k1},\\text{k2})+\\text{SPD}(\\text{k1},\\text{k1})+\\text{SPD}(\\text{k2},\\text{k2}),1\\},1\\}),\\text{LoopMomenta}\\to \\{\\text{k1},\\text{k2}\\},\\text{InitialSubstitutions}\\to \\{\\text{ExpandScalarProduct}(\\text{SPD}(\\text{k1}+\\text{k2}))\\to \\;\\text{SPD}(\\text{k1}+\\text{k2})\\},\\text{IntermediateSubstitutions}\\to \\{\\text{SPD}(n)\\to 0\\})\\]","anchor":"cb24-3","section":"Examples"}]