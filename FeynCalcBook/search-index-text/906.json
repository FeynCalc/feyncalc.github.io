[{"text":"SquareAmplitude[m1, m2] multiplies the amplitudes from the list m1 with their complex conjugate from the list m2 to obtain the list of products m1_i m2_j. This function can be useful when exporting amplitudes obtained with FeynCalc to FORM.","anchor":"squareamplitude"},{"text":"Overview","anchor":"see-also","section":"See also"},{"text":"Clear[a1, a2, a3, b1, b2, b3]","anchor":"cb1","section":"Examples"},{"text":"SquareAmplitude[{a1, a2, a3}, {b1, b2, b3}]","anchor":"cb2","section":"Examples"},{"text":"\\[\\{\\text{a1} \\;\\text{b1},\\text{a1} \\;\\text{b2},\\text{a1} \\;\\text{b3},\\text{a2} \\;\\text{b1},\\text{a2} \\;\\text{b2},\\text{a2} \\;\\text{b3},\\text{a3} \\;\\text{b1},\\text{a3} \\;\\text{b2},\\text{a3} \\;\\text{b3}\\}\\]","anchor":"cb2-1","section":"Examples"},{"text":"SquareAmplitude[{a1, a2, a3}, {b1, b2, b3}, List -> False]","anchor":"cb3","section":"Examples"},{"text":"\\[\\text{a1} \\;\\text{b1}+\\text{a1} \\;\\text{b2}+\\text{a1} \\;\\text{b3}+\\text{a2} \\;\\text{b1}+\\text{a2} \\;\\text{b2}+\\text{a2} \\;\\text{b3}+\\text{a3} \\;\\text{b1}+\\text{a3} \\;\\text{b2}+\\text{a3} \\;\\text{b3}\\]","anchor":"cb3-1","section":"Examples"},{"text":"When the option Real is set to True, the amplitudes are assumed to have no imaginary part","anchor":"cb3-1","section":"Examples"},{"text":"SquareAmplitude[{a1, a2, a3}, {b1, b2, b3}, Real -> True, List -> False]","anchor":"cb4","section":"Examples"},{"text":"\\[\\text{a1} \\;\\text{b1}+2 \\;\\text{a2} \\;\\text{b1}+\\text{a2} \\;\\text{b2}+2 \\;\\text{a3} \\;\\text{b1}+2 \\;\\text{a3} \\;\\text{b2}+\\text{a3} \\;\\text{b3}\\]","anchor":"cb4-1","section":"Examples"},{"text":"The option Indexed allows us to attach a marker to each contribution","anchor":"cb4-1","section":"Examples"},{"text":"SquareAmplitude[{a1, a2, a3}, {b1, b2, b3}, Real -> True, List -> False, Indexed -> mark]","anchor":"cb5","section":"Examples"},{"text":"\\[\\text{a1} \\;\\text{b1} \\;\\text{mark}(1,1)+2 \\;\\text{a2} \\;\\text{b1} \\;\\text{mark}(2,1)+\\text{a2} \\;\\text{b2} \\;\\text{mark}(2,2)+2 \\;\\text{a3} \\;\\text{b1} \\;\\text{mark}(3,1)+2 \\;\\text{a3} \\;\\text{b2} \\;\\text{mark}(3,2)+\\text{a3} \\;\\text{b3} \\;\\text{mark}(3,3)\\]","anchor":"cb5-1","section":"Examples"}]