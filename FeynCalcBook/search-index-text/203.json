[{"text":"DeclareFCTensor[a, b, ...] declares a,b, … to be tensor heads, i.e., DataType[a,b, ..., FCTensor] is set to True.","anchor":"declarefctensor"},{"text":"Overview, ExpandScalarProduct, Uncontract.","anchor":"see-also","section":"See also"},{"text":"ClearAll[myTens] DeclareFCTensor[myTens] ExpandScalarProduct[myTens[z, Momentum[a + b], Momentum[c + d]]]","anchor":"cb1","section":"Examples"},{"text":"\\text{myTens}\\left(z,\\overline{a},\\overline{c}\\right)+\\text{myTens}\\left(z,\\overline{a},\\overline{d}\\right)+\\text{myTens}\\left(z,\\overline{b},\\overline{c}\\right)+\\text{myTens}\\left(z,\\overline{b},\\overline{d}\\right)","anchor":"cb1-5","section":"Examples"},{"text":"UnDeclareFCTensor[myTens]","anchor":"cb2","section":"Examples"}]