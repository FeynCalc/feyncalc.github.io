[{"text":"FCLoopFindSubtopologies[topo] finds all scalefull subtopologies of the FCTopology topo.","anchor":"fcloopfindsubtopologies"},{"text":"Each subtopology receives a marker that specifies the topology from which it was derived. The symbol denoting the marker is specified via the option SubtopologyMarker. Setting it to False will disable the inclusion of the markers","anchor":"fcloopfindsubtopologies"},{"text":"Overview, FCTopology, FCLoopFindTopologies, FCLoopFindTopologyMappings, SubtopologyMarker.","anchor":"see-also","section":"See also"},{"text":"res = FCLoopFindSubtopologies[FCTopology[TRI, {SFAD[{{p1, 0}, {0, 1}, 1}], SFAD[{{p2, 0}, {0, 1}, 1}], SFAD[{{p1 + Q1, 0}, {0, 1}, 1}], SFAD[{{p1 + p2 + Q1, 0}, {0, 1}, 1}], SFAD[{{-p1 + Q2, 0}, {0, 1}, 1}], SFAD[{{-p1 - p2 + Q2, 0}, {0, 1}, 1}]}, {p1, p2}, {Q1, Q2}, {}, {}]];","anchor":"cb1","section":"Examples"},{"text":"res // Length","anchor":"cb2","section":"Examples"},{"text":"\\[19\\]","anchor":"cb2-1","section":"Examples"},{"text":"Show the first three subtopologies of this 2-loop self-energy topology","anchor":"cb2-1","section":"Examples"},{"text":"res[[1 ;; 3]]","anchor":"cb3","section":"Examples"},{"text":"res = FCLoopFindSubtopologies[FCTopology[topo1, {SFAD[{{p3, 0}, {0, 1}, 1}], SFAD[{{p2, 0}, {0, 1}, 1}], SFAD[{{p1, 0}, {0, 1}, 1}], SFAD[{{p2 + p3, 0}, {0, 1}, 1}], SFAD[{{p2 - Q, 0}, {0, 1}, 1}], SFAD[{{p1 - Q, 0}, {0, 1}, 1}], SFAD[{{p2 + p3 - Q, 0}, {0, 1}, 1}], SFAD[{{p1 + p3 - Q, 0}, {0, 1}, 1}], SFAD[{{p1 + p2 + p3 - Q, 0}, {0, 1}, 1}]}, {p1, p2, p3}, {Q}, {}, {}], FCE -> True];","anchor":"cb4","section":"Examples"},{"text":"res // Length","anchor":"cb5","section":"Examples"},{"text":"\\[36\\]","anchor":"cb5-1","section":"Examples"},{"text":"Show the first three subtopologies of this 3-loop self-energy topology","anchor":"cb5-1","section":"Examples"},{"text":"res[[1 ;; 3]]","anchor":"cb6","section":"Examples"}]