[{"text":"\\[\\left(\\partial _iS^x\\right)\\]","anchor":"cb11-3","section":"Examples"},{"text":"RightPartialD[{CartesianIndex[i], x}] . QuantumField[S, x] % // ExpandPartialD","anchor":"cb12","section":"Examples"},{"text":"\\[\\vec{\\partial }_{\\{i,x\\}}.S^x\\]","anchor":"cb12-3","section":"Examples"},{"text":"\\[\\left(\\partial _{\\{i,x\\}}S^x\\right)\\]","anchor":"cb12-3","section":"Examples"},{"text":"By default the derivative won’t act on anything outside of the input expression. But it can be made to by setting the option RightPartialD to True","anchor":"cb12-3","section":"Examples"},{"text":"ExpandPartialD[RightPartialD[\\[Mu]] . QuantumField[A, LorentzIndex[\\[Mu]]] . QuantumField[A, LorentzIndex[\\[Nu]]]]","anchor":"cb13","section":"Examples"},{"text":"\\[A_{\\mu }.\\left(\\partial _{\\mu }A_{\\nu }\\right)+\\left(\\partial _{\\mu }A_{\\mu }\\right).A_{\\nu }\\]","anchor":"cb13-1","section":"Examples"},{"text":"ExpandPartialD[RightPartialD[\\[Mu]] . QuantumField[A, LorentzIndex[\\[Mu]]] . QuantumField[A, LorentzIndex[\\[Nu]]], RightPartialD -> True]","anchor":"cb14","section":"Examples"},{"text":"\\[A_{\\mu }.\\left(\\partial _{\\mu }A_{\\nu }\\right)+\\left(\\partial _{\\mu }A_{\\mu }\\right).A_{\\nu }+A_{\\mu }.A_{\\nu }.\\vec{\\partial }_{\\mu }\\]","anchor":"cb14-1","section":"Examples"},{"text":"The same applies also to LeftPartialD","anchor":"cb14-1","section":"Examples"},{"text":"ExpandPartialD[QuantumField[A, LorentzIndex[\\[Nu]]] . LeftNablaD[i]]","anchor":"cb15","section":"Examples"},{"text":"\\[-\\left(\\partial _iA_{\\nu }\\right)\\]","anchor":"cb15-1","section":"Examples"},{"text":"ExpandPartialD[QuantumField[A, LorentzIndex[\\[Nu]]] . LeftNablaD[i], LeftPartialD -> True]","anchor":"cb16","section":"Examples"},{"text":"\\[-\\left(\\partial _iA_{\\nu }\\right)-\\overleftarrow{\\partial }_i.A_{\\nu }\\]","anchor":"cb16-1","section":"Examples"}]