[{"text":"FCLoopGLIToSymbol[exp] converts GLIs to symbols.","anchor":"fcloopglitosymbol"},{"text":"The option Head determines the prefix of the symbol and can be set to FCTopology (default) or GLI","anchor":"fcloopglitosymbol"},{"text":"The option Character specifies the separator between to prefix and the indices.","anchor":"fcloopglitosymbol"},{"text":"Overview, GLI, SMPToSymbol, FCGVToSymbol.","anchor":"see-also","section":"See also"},{"text":"FCLoopGLIToSymbol[GLI[topo1, {1, 1, 1, 1, 1}]]","anchor":"cb1","section":"Examples"},{"text":"\\[\\text{topo1X11111}\\]","anchor":"cb1-1","section":"Examples"},{"text":"FCLoopGLIToSymbol[GLI[topo1, {1, 1, 1, 1, 1}], Head -> GLI]","anchor":"cb2","section":"Examples"},{"text":"\\[\\text{GLIXtopo1X11111}\\]","anchor":"cb2-1","section":"Examples"},{"text":"FCLoopGLIToSymbol[GLI[topo1, {1, 1, 1, 1, 1}], Character -> \"$\"]","anchor":"cb3","section":"Examples"},{"text":"\\[\\text{topo1\\$11111}\\]","anchor":"cb3-1","section":"Examples"}]