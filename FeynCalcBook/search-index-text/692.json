[{"text":"LorentzIndexNames is an option for FCFAConvert, FCCanonicalizeDummyIndices and other functions. It renames the generic dummy Lorentz indices to the indices in the supplied list.","anchor":"lorentzindexnames"},{"text":"Overview, FCFAConvert, FCCanonicalizeDummyIndices, CartesianIndexNames.","anchor":"see-also","section":"See also"},{"text":"LC[i1, i2, i3, i4] GA[i1, i2, i3, i4] FCCanonicalizeDummyIndices[%]","anchor":"cb1","section":"Examples"},{"text":"\\[\\bar{\\gamma }^{\\text{i1}}.\\bar{\\gamma }^{\\text{i2}}.\\bar{\\gamma }^{\\text{i3}}.\\bar{\\gamma }^{\\text{i4}} \\bar{\\epsilon }^{\\text{i1}\\;\\text{i2}\\;\\text{i3}\\;\\text{i4}}\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[\\bar{\\gamma }^{\\text{FCGV}(\\text{li191})}.\\bar{\\gamma }^{\\text{FCGV}(\\text{li192})}.\\bar{\\gamma }^{\\text{FCGV}(\\text{li193})}.\\bar{\\gamma }^{\\text{FCGV}(\\text{li194})} \\bar{\\epsilon }^{\\text{FCGV}(\\text{li191})\\text{FCGV}(\\text{li192})\\text{FCGV}(\\text{li193})\\text{FCGV}(\\text{li194})}\\]","anchor":"cb1-3","section":"Examples"},{"text":"LC[i1, i2, i3, i4] GA[i1, i2, i3, i4] FCCanonicalizeDummyIndices[%, LorentzIndexNames -> {mu, nu, rho, si}]","anchor":"cb2","section":"Examples"},{"text":"\\[\\bar{\\gamma }^{\\text{i1}}.\\bar{\\gamma }^{\\text{i2}}.\\bar{\\gamma }^{\\text{i3}}.\\bar{\\gamma }^{\\text{i4}} \\bar{\\epsilon }^{\\text{i1}\\;\\text{i2}\\;\\text{i3}\\;\\text{i4}}\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[\\bar{\\gamma }^{\\text{mu}}.\\bar{\\gamma }^{\\text{nu}}.\\bar{\\gamma }^{\\text{rho}}.\\bar{\\gamma }^{\\text{si}} \\bar{\\epsilon }^{\\text{mu}\\;\\text{nu}\\;\\text{rho}\\;\\text{si}}\\]","anchor":"cb2-3","section":"Examples"}]