[{"text":"SpinorChainEvaluate[exp] explicitly evaluates suitable spinor chains, i.e. it replaces a DOT[Spinor[...],...,Spinor[...]] with a scalar quantity without a DOT.","anchor":"spinorchainevaluate"},{"text":"Overview","anchor":"see-also","section":"See also"},{"text":"ex = SpinorUBar[p, m] . SpinorU[p, m] SpinorChainEvaluate[ex]","anchor":"cb1","section":"Examples"},{"text":"\\[\\bar{u}(p,m).u(p,m)\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[2 m\\]","anchor":"cb1-3","section":"Examples"},{"text":"SpinorChainEvaluate[ex, DiracSpinorNormalization -> \"Nonrelativistic\"]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{m}{p^0}\\]","anchor":"cb2-1","section":"Examples"},{"text":"SpinorChainEvaluate[ex, DiracSpinorNormalization -> \"Rest\"]","anchor":"cb3","section":"Examples"},{"text":"\\[1\\]","anchor":"cb3-1","section":"Examples"},{"text":"ex = SpinorUBarD[p, m] . GA[5] . SpinorUD[p, m] SpinorChainEvaluate[ex]","anchor":"cb4","section":"Examples"},{"text":"\\[\\bar{u}(p,m).\\bar{\\gamma }^5.u(p,m)\\]","anchor":"cb4-3","section":"Examples"},{"text":"\\[0\\]","anchor":"cb4-3","section":"Examples"},{"text":"FCSetDiracGammaScheme[\"BMHV\"] SpinorChainEvaluate[ex]","anchor":"cb5","section":"Examples"},{"text":"\\[\\text{BMHV}\\]","anchor":"cb5-3","section":"Examples"},{"text":"\\[(\\varphi (p,m)).\\bar{\\gamma }^5.(\\varphi (p,m))\\]","anchor":"cb5-3","section":"Examples"}]