[{"text":"FCLoopTopologyNameToSymbol[exp] converts topology names in FCTopologys and GLIs that are strings to expressions. This can be useful when exporting expressions generated with Mathematica to other software tools.","anchor":"fclooptopologynametosymbol"},{"text":"Using the option Except one can exclude certain names from the conversion process.","anchor":"fclooptopologynametosymbol"},{"text":"Overview, FCTopology, GLI.","anchor":"see-also","section":"See also"},{"text":"FCLoopTopologyNameToSymbol[GLI[\"a1\", {1, 1, 1}]] // InputForm","anchor":"cb1","section":"Examples"},{"text":"GLI[a1, {1, 1, 1}]","anchor":"cb2","section":"Examples"},{"text":"FCLoopTopologyNameToSymbol[FCTopology[\"topo2\", {FAD[{p1, m}], FAD[{p1 - q, m}]}, {p1}, {q}, {}, {}]] // InputForm","anchor":"cb3","section":"Examples"},{"text":"GLI[topo2, {FAD[{p1, m}], FAD[{p1 - q, m}]}, {p1}, {q}, {}, {}]","anchor":"cb4","section":"Examples"},{"text":"FCLoopTopologyNameToSymbol[GLI[\"a1\", {1, 1, 1}] + GLI[\"b1\", {1, 1, 1}], Except -> {\"a\"}] // InputForm","anchor":"cb5","section":"Examples"},{"text":"GLI[\"a1\", {1, 1, 1}] + GLI[b1, {1, 1, 1}]","anchor":"cb6","section":"Examples"}]