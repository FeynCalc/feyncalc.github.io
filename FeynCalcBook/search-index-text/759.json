[{"text":"PartialIntegrate[exp, ap, t] does a partial integration of the definite integral Integrate[exp,{t,0,1}], with ap the factor that is to be integrated and exp/ap the factor that is to be differentiated.","anchor":"partialintegrate"},{"text":"Overview, IntegrateByParts, Integrate2.","anchor":"see-also","section":"See also"},{"text":"PartialIntegrate[f[x] g[x], g[x], {x, 0, 1}]","anchor":"cb1","section":"Examples"},{"text":"\\[-(f(x) \\int g(x) \\, dx\\text{/.}\\, x\\to 0)+(f(x) \\int g(x) \\, dx\\text{/.}\\, x\\to 1)-\\int_0^1 f'(x) (\\int g(x) \\, dx) \\, dx\\]","anchor":"cb1-1","section":"Examples"},{"text":"f[x_] = Integrate[Log[3 x + 2], x] g[x_] = D[1/Log[3 x + 2], x]","anchor":"cb2","section":"Examples"},{"text":"\\[\\left(x+\\frac{2}{3}\\right) \\log (3 x+2)-x\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[-\\frac{3}{(3 x+2) \\log ^2(3 x+2)}\\]","anchor":"cb2-3","section":"Examples"},{"text":"Integrate[PartialIntegrate[f[x] g[x], f[x], x], {x, 0, 1}] // FullSimplify","anchor":"cb3","section":"Examples"},{"text":"\\[-\\frac{1}{\\log (5)}\\]","anchor":"cb3-1","section":"Examples"},{"text":"Integrate[f[x] g[x], {x, 0, 1}] // Simplify","anchor":"cb4","section":"Examples"},{"text":"\\[-\\frac{1}{\\log (5)}\\]","anchor":"cb4-1","section":"Examples"},{"text":"Clear[f, g]","anchor":"cb5","section":"Examples"}]