[{"text":"QuarkPropagator[p] is the massless quark propagator.","anchor":"quarkpropagator"},{"text":"QuarkPropagator[{p, m}] gives the quark propagator with mass \\(m\\).","anchor":"quarkpropagator"},{"text":"QP can be used as an abbreviation of QuarkPropagator.","anchor":"quarkpropagator"},{"text":"Overview, GluonPropagator, QuarkGluonVertex.","anchor":"see-also","section":"See also"},{"text":"QuarkPropagator[p, Explicit -> True]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{i \\gamma \\cdot p}{p^2}\\]","anchor":"cb1-1","section":"Examples"},{"text":"QuarkPropagator[{p, m}, Explicit -> True]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{i (m+\\gamma \\cdot p)}{p^2-m^2}\\]","anchor":"cb2-1","section":"Examples"},{"text":"QP[{p, m}] Explicit[%]","anchor":"cb3","section":"Examples"},{"text":"\\[\\Pi _q(p)\\]","anchor":"cb3-3","section":"Examples"},{"text":"\\[\\frac{i (m+\\gamma \\cdot p)}{p^2-m^2}\\]","anchor":"cb3-3","section":"Examples"}]