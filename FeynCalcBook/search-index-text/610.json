[{"text":"GSLR[p,n,nb] denotes the perpendicular component in the lightcone decomposition of the slashed Dirac matrix (\\gamma \\cdot p) along the vectors n and nb. It corresponds to (\\gamma \\cdot p)_{\\perp}.","anchor":"gslr"},{"text":"Overview, DiracGamma, GALP, GALN, GALR, GSLP, GSLN.","anchor":"see-also","section":"See also"},{"text":"GSLR[p, n, nb]","anchor":"cb1","section":"Examples"},{"text":"\\[\\bar{\\gamma }\\cdot \\overline{p}_{\\perp }\\]","anchor":"cb1-1","section":"Examples"},{"text":"StandardForm[GSLR[p, n, nb] // FCI] (*DiracGamma[LightConePerpendicularComponent[Momentum[p], Momentum[n], Momentum[nb]]]*)","anchor":"cb2","section":"Examples"},{"text":"GSLR[p, n, nb] . GSLP[q, n, nb] // DiracSimplify","anchor":"cb3","section":"Examples"},{"text":"\\[-\\frac{1}{4} \\overline{n}^2 \\left(\\overline{\\text{nb}}\\cdot \\overline{q}\\right) \\left(\\bar{\\gamma }\\cdot \\overline{\\text{nb}}\\right).\\left(\\bar{\\gamma }\\cdot \\overline{p}_{\\perp }\\right)-\\frac{1}{4} \\left(\\overline{n}\\cdot \\overline{\\text{nb}}\\right) \\left(\\overline{\\text{nb}}\\cdot \\overline{q}\\right) \\left(\\bar{\\gamma }\\cdot \\overline{n}\\right).\\left(\\bar{\\gamma }\\cdot \\overline{p}_{\\perp }\\right)\\]","anchor":"cb3-1","section":"Examples"},{"text":"GSLR[p, n, nb] . GSLP[q, n, nb] // DiracSimplify","anchor":"cb5","section":"Examples"},{"text":"\\[-\\frac{1}{2} \\left(\\overline{\\text{nb}}\\cdot \\overline{q}\\right) \\left(\\bar{\\gamma }\\cdot \\overline{n}\\right).\\left(\\bar{\\gamma }\\cdot \\overline{p}_{\\perp }\\right)\\]","anchor":"cb5-1","section":"Examples"},{"text":"FCClearScalarProducts[]","anchor":"cb6","section":"Examples"}]