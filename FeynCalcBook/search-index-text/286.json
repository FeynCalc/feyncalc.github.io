[{"text":"Overview.","anchor":"see-also","section":"See also"},{"text":"FeynCalc offers further useful functions for the manipulations of Lorentz tensors and Dirac matrices. To expand scalar products","anchor":"manipulations","section":"Manipulations"},{"text":"ex1 = SP[p + q + r, s + t]","anchor":"cb1","section":"Manipulations"},{"text":"(\\overline{p}+\\overline{q}+\\overline{r})\\cdot (\\overline{s}+\\overline{t})","anchor":"cb1-1","section":"Manipulations"},{"text":"or expressions like","anchor":"cb1-1","section":"Manipulations"},{"text":"ex2 = FV[p + q + r, \\[Mu]]","anchor":"cb2","section":"Manipulations"},{"text":"\\left(\\overline{p}+\\overline{q}+\\overline{r}\\right)^{\\mu }","anchor":"cb2-1","section":"Manipulations"},{"text":"one can use","anchor":"cb2-1","section":"Manipulations"},{"text":"ExpandScalarProduct[ex1]","anchor":"cb3","section":"Manipulations"},{"text":"\\[\\overline{p}\\cdot \\overline{s}+\\overline{p}\\cdot \\overline{t}+\\overline{q}\\cdot \\overline{s}+\\overline{q}\\cdot \\overline{t}+\\overline{r}\\cdot \\overline{s}+\\overline{r}\\cdot \\overline{t}\\]","anchor":"cb3-1","section":"Manipulations"},{"text":"ExpandScalarProduct[ex2]","anchor":"cb4","section":"Manipulations"},{"text":"\\[\\overline{p}^{\\mu }+\\overline{q}^{\\mu }+\\overline{r}^{\\mu }\\]","anchor":"cb4-1","section":"Manipulations"},{"text":"Notice that ExpandScalarProduct can also do expansions only for the given momentum, while leaving the rest of the expression untouched, e.g.","anchor":"cb4-1","section":"Manipulations"},{"text":"x SP[p1 + p2, q1 + q2] + y SP[p3 + p4, q3 + q4] + z SP[p5 + p6, q5 + q6] ExpandScalarProduct[%, Momentum -> {p1}]","anchor":"cb5","section":"Manipulations"},{"text":"\\[x \\left((\\overline{\\text{p1}}+\\overline{\\text{p2}})\\cdot (\\overline{\\text{q1}}+\\overline{\\text{q2}})\\right)+y \\left((\\overline{\\text{p3}}+\\overline{\\text{p4}})\\cdot (\\overline{\\text{q3}}+\\overline{\\text{q4}})\\right)+z \\left((\\overline{\\text{p5}}+\\overline{\\text{p6}})\\cdot (\\overline{\\text{q5}}+\\overline{\\text{q6}})\\right)\\]","anchor":"cb5-2","section":"Manipulations"},{"text":"\\[x \\left(\\overline{\\text{p1}}\\cdot (\\overline{\\text{q1}}+\\overline{\\text{q2}})+\\overline{\\text{p2}}\\cdot (\\overline{\\text{q1}}+\\overline{\\text{q2}})\\right)+y \\left((\\overline{\\text{p3}}+\\overline{\\text{p4}})\\cdot (\\overline{\\text{q3}}+\\overline{\\text{q4}})\\right)+z \\left((\\overline{\\text{p5}}+\\overline{\\text{p6}})\\cdot (\\overline{\\text{q5}}+\\overline{\\text{q6}})\\right)\\]","anchor":"cb5-2","section":"Manipulations"},{"text":"For the expansion of Eps tensors, we use","anchor":"cb5-2","section":"Manipulations"},{"text":"LC[][p1 + p2, q, r, s] EpsEvaluate[%]","anchor":"cb6","section":"Manipulations"},{"text":"\\[\\bar{\\epsilon }^{\\overline{\\text{p1}}+\\overline{\\text{p2}}\\overline{q}\\overline{r}\\overline{s}}\\]","anchor":"cb6-2","section":"Manipulations"},{"text":"\\[\\bar{\\epsilon }^{\\overline{\\text{p1}}\\overline{q}\\overline{r}\\overline{s}}+\\bar{\\epsilon }^{\\overline{\\text{p2}}\\overline{q}\\overline{r}\\overline{s}}\\]","anchor":"cb6-2","section":"Manipulations"},{"text":"EpsEvaluate also reorders the arguments of Eps according to its antisymmetric properties","anchor":"cb6-2","section":"Manipulations"},{"text":"LC[\\[Mu], \\[Sigma], \\[Rho], \\[Nu]] EpsEvaluate[%]","anchor":"cb7","section":"Manipulations"},{"text":"\\[\\bar{\\epsilon }^{\\mu \\sigma \\rho \\nu }\\]","anchor":"cb7-2","section":"Manipulations"},{"text":"\\[-\\bar{\\epsilon }^{\\mu \\nu \\rho \\sigma }\\]","anchor":"cb7-2","section":"Manipulations"},{"text":"The inverse of ExpandScalarProduct is called MomentumCombine","anchor":"cb7-2","section":"Manipulations"},{"text":"3 FV[p, \\[Mu]] + 4 FV[q, \\[Mu]] MomentumCombine[%]","anchor":"cb8","section":"Manipulations"},{"text":"\\[3 \\overline{p}^{\\mu }+4 \\overline{q}^{\\mu }\\]","anchor":"cb8-2","section":"Manipulations"},{"text":"\\[\\left(3 \\overline{p}+4 \\overline{q}\\right)^{\\mu }\\]","anchor":"cb8-2","section":"Manipulations"},{"text":"This also works for scalar products, but the results may not be always optimal","anchor":"cb8-2","section":"Manipulations"},{"text":"SP[p + q + t, r + s] ExpandScalarProduct[%] MomentumCombine[%]","anchor":"cb9","section":"Manipulations"},{"text":"\\[(\\overline{r}+\\overline{s})\\cdot (\\overline{p}+\\overline{q}+\\overline{t})\\]","anchor":"cb9-3","section":"Manipulations"},{"text":"\\[\\overline{p}\\cdot \\overline{r}+\\overline{p}\\cdot \\overline{s}+\\overline{q}\\cdot \\overline{r}+\\overline{q}\\cdot \\overline{s}+\\overline{r}\\cdot \\overline{t}+\\overline{s}\\cdot \\overline{t}\\]","anchor":"cb9-3","section":"Manipulations"}]