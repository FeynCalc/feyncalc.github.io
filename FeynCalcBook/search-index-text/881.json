[{"text":"SPD[a, b] denotes a D-dimensional scalar product.","anchor":"spd"},{"text":"SPD[a, b] is transformed into ScalarProduct[a, b,Dimension->D] by FeynCalcInternal.","anchor":"spd"},{"text":"SPD[p] is the same as SPD[p,p] (=p^2).","anchor":"spd"},{"text":"Overview, PD, Calc, ExpandScalarProduct, ScalarProduct.","anchor":"see-also","section":"See also"},{"text":"SPD[p, q] + SPD[q]","anchor":"cb1","section":"Examples"},{"text":"\\[p\\cdot q+q^2\\]","anchor":"cb1-1","section":"Examples"},{"text":"SPD[p - q, q + 2 p]","anchor":"cb2","section":"Examples"},{"text":"\\[(p-q)\\cdot (2 p+q)\\]","anchor":"cb2-1","section":"Examples"},{"text":"Calc[ SPD[p - q, q + 2 p] ]","anchor":"cb3","section":"Examples"},{"text":"\\[-p\\cdot q+2 p^2-q^2\\]","anchor":"cb3-1","section":"Examples"},{"text":"ExpandScalarProduct[SPD[p - q]]","anchor":"cb4","section":"Examples"},{"text":"\\[-2 (p\\cdot q)+p^2+q^2\\]","anchor":"cb4-1","section":"Examples"},{"text":"SPD[a, b] // StandardForm (*SPD[a, b]*)","anchor":"cb5","section":"Examples"},{"text":"SPD[a, b] // FCI // StandardForm (*Pair[Momentum[a, D], Momentum[b, D]]*)","anchor":"cb6","section":"Examples"},{"text":"SPD[a, b] // FCI // FCE // StandardForm (*SPD[a, b]*)","anchor":"cb7","section":"Examples"},{"text":"FCE[ChangeDimension[SP[p, q], D]] // StandardForm (*SPD[p, q]*)","anchor":"cb8","section":"Examples"}]