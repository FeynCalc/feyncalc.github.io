[{"text":"QuarkGluonVertex[mu, a] gives the Feynman rule for the quark-gluon vertex.","anchor":"quarkgluonvertex"},{"text":"QGV can be used as an abbreviation of QuarkGluonVertex.","anchor":"quarkgluonvertex"},{"text":"The dimension and the name of the coupling constant are determined by the options Dimension and CouplingConstant.","anchor":"quarkgluonvertex"},{"text":"Overview, GluonVertex.","anchor":"see-also","section":"See also"},{"text":"QuarkGluonVertex[\\[Mu], a, Explicit -> True]","anchor":"cb1","section":"Examples"},{"text":"\\[i g_s T^a.\\gamma ^{\\mu }\\]","anchor":"cb1-1","section":"Examples"},{"text":"QGV[\\[Mu], a]","anchor":"cb2","section":"Examples"},{"text":"\\[Q_a^{\\mu }\\]","anchor":"cb2-1","section":"Examples"},{"text":"Explicit[%]","anchor":"cb3","section":"Examples"},{"text":"\\[i g_s T^a.\\gamma ^{\\mu }\\]","anchor":"cb3-1","section":"Examples"},{"text":"QuarkGluonVertex[\\[Mu], a, CounterTerm -> 1, Explicit -> True]","anchor":"cb4","section":"Examples"},{"text":"\\[\\frac{2 i g_s^3 S_n \\left(C_F-\\frac{C_A}{2}\\right) T^a.\\gamma ^{\\mu }}{\\varepsilon }\\]","anchor":"cb4-1","section":"Examples"},{"text":"QuarkGluonVertex[\\[Mu], a, CounterTerm -> 2, Explicit -> True]","anchor":"cb5","section":"Examples"},{"text":"\\[\\frac{3 i C_A g_s^3 S_n T^a.\\gamma ^{\\mu }}{\\varepsilon }\\]","anchor":"cb5-1","section":"Examples"},{"text":"QuarkGluonVertex[\\[Mu], a, CounterTerm -> 3, Explicit -> True]","anchor":"cb6","section":"Examples"},{"text":"\\[\\frac{2 i g_s^3 S_n \\left(C_A+C_F\\right) T^a.\\gamma ^{\\mu }}{\\varepsilon }\\]","anchor":"cb6-1","section":"Examples"},{"text":"QuarkGluonVertex[{p, \\[Mu], a}, {q}, {k}, OPE -> True, Explicit -> True]","anchor":"cb7","section":"Examples"},{"text":"\\[\\Omega \\Delta ^{\\mu } g_s (\\gamma \\cdot \\Delta ).T^a \\left(\\sum _{i=0}^{-2+m} (-1)^i (k\\cdot \\Delta )^i (\\Delta \\cdot q)^{-2-i+m}\\right)+i g_s T^a.\\gamma ^{\\mu }\\]","anchor":"cb7-1","section":"Examples"},{"text":"QuarkGluonVertex[{p, \\[Mu], a}, {q}, {k}, OPE -> False, Explicit -> True]","anchor":"cb8","section":"Examples"},{"text":"\\[i g_s T^a.\\gamma ^{\\mu }\\]","anchor":"cb8-1","section":"Examples"}]