[{"text":"PauliIndexNames is an option for FCFAConvert, FCCanonicalizeDummyIndices and other functions. It renames the generic dummy Pauli indices to the indices in the supplied list.","anchor":"pauliindexnames"},{"text":"Overview, FCFAConvert, FCCanonicalizeDummyIndices, DiracIndexNames, LorentzIndexNames.","anchor":"see-also","section":"See also"},{"text":"PCHN[CSI[a], i, j] PCHN[CSI[b], j, k] FCCanonicalizeDummyIndices[%]","anchor":"cb1","section":"Examples"},{"text":"\\[\\left(\\overline{\\sigma }^a\\right){}_{ij} \\left(\\overline{\\sigma }^b\\right){}_{jk}\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[\\left(\\overline{\\sigma }^a\\right){}_{i\\text{FCGV}(\\text{pi251})} \\left(\\overline{\\sigma }^b\\right){}_{\\text{FCGV}(\\text{pi251})k}\\]","anchor":"cb1-3","section":"Examples"},{"text":"PCHN[CSI[a], i, j] PCHN[CSI[b], j, k] FCCanonicalizeDummyIndices[%, PauliIndexNames -> {l}]","anchor":"cb2","section":"Examples"},{"text":"\\[\\left(\\overline{\\sigma }^a\\right){}_{ij} \\left(\\overline{\\sigma }^b\\right){}_{jk}\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[\\left(\\overline{\\sigma }^a\\right){}_{il} \\left(\\overline{\\sigma }^b\\right){}_{lk}\\]","anchor":"cb2-3","section":"Examples"}]