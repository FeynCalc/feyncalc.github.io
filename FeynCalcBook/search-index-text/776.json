[{"text":"PauliSigmaExpand[exp] expands all PauliSigma[Momentum[a+b+..]] in exp into (PauliSigma[Momentum[a]] + PauliSigma[Momentum[b]] + ...).","anchor":"paulisigmaexpand"},{"text":"Overview, PauliSigmaCombine.","anchor":"see-also","section":"See also"},{"text":"SIS[q] . SIS[p - q] PauliSigmaExpand[%]","anchor":"cb1","section":"Examples"},{"text":"\\[\\left(\\bar{\\sigma }\\cdot \\overline{q}\\right).\\left(\\bar{\\sigma }\\cdot \\left(\\overline{p}-\\overline{q}\\right)\\right)\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[\\left(\\bar{\\sigma }\\cdot \\overline{q}\\right).\\left(\\bar{\\sigma }\\cdot \\overline{p}-\\bar{\\sigma }\\cdot \\overline{q}\\right)\\]","anchor":"cb1-3","section":"Examples"},{"text":"SIS[a + b] . SIS[c + d] PauliSigmaExpand[%, Momentum -> {a}] PauliSigmaExpand[%%, Momentum -> All]","anchor":"cb2","section":"Examples"},{"text":"\\[\\left(\\bar{\\sigma }\\cdot \\left(\\overline{a}+\\overline{b}\\right)\\right).\\left(\\bar{\\sigma }\\cdot \\left(\\overline{c}+\\overline{d}\\right)\\right)\\]","anchor":"cb2-5","section":"Examples"},{"text":"\\[\\left(\\bar{\\sigma }\\cdot \\overline{a}+\\bar{\\sigma }\\cdot \\overline{b}\\right).\\left(\\bar{\\sigma }\\cdot \\left(\\overline{c}+\\overline{d}\\right)\\right)\\]","anchor":"cb2-5","section":"Examples"},{"text":"\\[\\left(\\bar{\\sigma }\\cdot \\overline{a}+\\bar{\\sigma }\\cdot \\overline{b}\\right).\\left(\\bar{\\sigma }\\cdot \\overline{c}+\\bar{\\sigma }\\cdot \\overline{d}\\right)\\]","anchor":"cb2-5","section":"Examples"}]