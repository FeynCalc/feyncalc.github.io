[{"text":"FCRenameDummyIndices[expr] identifies dummy indices and changes their names pairwise to random symbols. This can be useful if you have an expression that contains dummy indices and want to compute the square of it. For example, the square of GA[a, l, a] equals \\(16\\). However, if you forget to rename the dummy indices and compute GA[a, l, a, a, l, a] instead of GA[a, l, a, b, l, b], you will get 64.","anchor":"fcrenamedummyindices"},{"text":"Notice that this routine does not perform any canonicalization. Use FCCanonicalizeDummyIndices for that.","anchor":"fcrenamedummyindices"},{"text":"Overview, ComplexConjugate, FCCanonicalizeDummyIndices.","anchor":"see-also","section":"See also"},{"text":"FVD[q, mu] FVD[p, mu] + FVD[q, nu] FVD[p, nu] + FVD[q, si] FVD[r, si] FCRenameDummyIndices[%] // Factor2","anchor":"cb1","section":"Examples"},{"text":"\\[p^{\\text{mu}} q^{\\text{mu}}+p^{\\text{nu}} q^{\\text{nu}}+q^{\\text{si}} r^{\\text{si}}\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[p^{\\text{\\$AL}(\\text{\\$19})} q^{\\text{\\$AL}(\\text{\\$19})}+p^{\\text{\\$AL}(\\text{\\$20})} q^{\\text{\\$AL}(\\text{\\$20})}+q^{\\text{\\$AL}(\\text{\\$21})} r^{\\text{\\$AL}(\\text{\\$21})}\\]","anchor":"cb1-3","section":"Examples"},{"text":"Uncontract[SPD[q, p]^2, q, p, Pair -> All] FCRenameDummyIndices[%]","anchor":"cb2","section":"Examples"},{"text":"\\[p^{\\text{\\$AL}(\\text{\\$22})} p^{\\text{\\$AL}(\\text{\\$23})} q^{\\text{\\$AL}(\\text{\\$22})} q^{\\text{\\$AL}(\\text{\\$23})}\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[p^{\\text{\\$AL}(\\text{\\$24})} p^{\\text{\\$AL}(\\text{\\$25})} q^{\\text{\\$AL}(\\text{\\$24})} q^{\\text{\\$AL}(\\text{\\$25})}\\]","anchor":"cb2-3","section":"Examples"},{"text":"amp = -(Spinor[Momentum[k1], SMP[\"m_mu\"], 1] . GA[Lor1] . Spinor[-Momentum[k2], SMP[\"m_mu\"], 1]*Spinor[-Momentum[p2], SMP[\"m_e\"], 1] . GA[Lor1] . Spinor[Momentum[p1], SMP[\"m_e\"], 1]*FAD[k1 + k2, Dimension -> 4]*SMP[\"e\"]^2); amp // FCRenameDummyIndices","anchor":"cb3","section":"Examples"},{"text":"\\[-\\frac{\\text{e}^2 \\left(\\varphi (-\\overline{\\text{p2}},m_e)\\right).\\bar{\\gamma }^{\\text{\\$AL}(\\text{\\$26})}.\\left(\\varphi (\\overline{\\text{p1}},m_e)\\right) \\left(\\varphi (\\overline{\\text{k1}},m_{\\mu })\\right).\\bar{\\gamma }^{\\text{\\$AL}(\\text{\\$26})}.\\left(\\varphi (-\\overline{\\text{k2}},m_{\\mu })\\right)}{(\\overline{\\text{k1}}+\\overline{\\text{k2}})^2}\\]","anchor":"cb3-5","section":"Examples"},{"text":"CVD[p, i] CVD[q, i] + CVD[p, j] CVD[r, j] % // FCRenameDummyIndices","anchor":"cb4","section":"Examples"},{"text":"\\[p^i q^i+p^j r^j\\]","anchor":"cb4-3","section":"Examples"},{"text":"\\[p^{\\text{\\$AL}(\\text{\\$27})} q^{\\text{\\$AL}(\\text{\\$27})}+p^{\\text{\\$AL}(\\text{\\$28})} r^{\\text{\\$AL}(\\text{\\$28})}\\]","anchor":"cb4-3","section":"Examples"},{"text":"SUNT[a, b, a] + SUNT[c, b, c] % // FCRenameDummyIndices","anchor":"cb5","section":"Examples"},{"text":"\\[T^a.T^b.T^a+T^c.T^b.T^c\\]","anchor":"cb5-3","section":"Examples"},{"text":"T^{\\text{\\$AL}(\\text{\\$29})}.T^b.T^{\\text{\\$AL}(\\text{\\$29})}+T^{\\text{\\$AL}(\\text{\\$30})}.T^b.T^{\\text{\\$AL}(\\text{\\$30})}","anchor":"cb5-3","section":"Examples"},{"text":"DCHN[GA[mu], i, j] DCHN[GA[nu], j, k] % // FCRenameDummyIndices","anchor":"cb6","section":"Examples"},{"text":"\\[\\left(\\bar{\\gamma }^{\\text{mu}}\\right){}_{ij} \\left(\\bar{\\gamma }^{\\text{nu}}\\right){}_{jk}\\]","anchor":"cb6-3","section":"Examples"},{"text":"\\[\\left(\\bar{\\gamma }^{\\text{mu}}\\right){}_{i\\text{\\$AL}(\\text{\\$31})} \\left(\\bar{\\gamma }^{\\text{nu}}\\right){}_{\\text{\\$AL}(\\text{\\$31})k}\\]","anchor":"cb6-3","section":"Examples"},{"text":"PCHN[CSI[a], i, j] PCHN[CSI[b], j, k] % // FCRenameDummyIndices","anchor":"cb7","section":"Examples"},{"text":"\\[\\left(\\overline{\\sigma }^a\\right){}_{ij} \\left(\\overline{\\sigma }^b\\right){}_{jk}\\]","anchor":"cb7-3","section":"Examples"},{"text":"\\[\\left(\\overline{\\sigma }^a\\right){}_{i\\text{\\$AL}(\\text{\\$32})} \\left(\\overline{\\sigma }^b\\right){}_{\\text{\\$AL}(\\text{\\$32})k}\\]","anchor":"cb7-3","section":"Examples"}]