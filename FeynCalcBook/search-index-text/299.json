[{"text":"Factor2[poly] factors a polynomial in a standard way.","anchor":"factor2"},{"text":"Factor2 works sometimes better than Factor on polynomials involving rationals with sums in the denominator.","anchor":"factor2"},{"text":"Factor2 uses Factor internally and is in general slower than Factor. There are four possible settings of the option Method (0,1,2,3). In general, Factor will work faster than Factor2.","anchor":"factor2"},{"text":"Overview, Collect2.","anchor":"see-also","section":"See also"},{"text":"(a - x) (b - x) {Factor2[%], Factor[%]}","anchor":"cb1","section":"Examples"},{"text":"\\[(a-x) (b-x)\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[\\{(a-x) (b-x),-((a-x) (x-b))\\}\\]","anchor":"cb1-3","section":"Examples"},{"text":"ex = Expand[(a - b) (a + b)]","anchor":"cb2","section":"Examples"},{"text":"\\[a^2-b^2\\]","anchor":"cb2-1","section":"Examples"},{"text":"Factor[ex]","anchor":"cb3","section":"Examples"},{"text":"\\[(a-b) (a+b)\\]","anchor":"cb3-1","section":"Examples"},{"text":"Factor2[ex]","anchor":"cb4","section":"Examples"},{"text":"\\[a^2-b^2\\]","anchor":"cb4-1","section":"Examples"},{"text":"Factor2[ex, FactorFull -> True]","anchor":"cb5","section":"Examples"},{"text":"\\[(a-b) (a+b)\\]","anchor":"cb5-1","section":"Examples"}]