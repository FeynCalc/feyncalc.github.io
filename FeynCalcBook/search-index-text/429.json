[{"text":"FCLoopNonIntegerPropagatorPowersFreeQ[int] checks if the integral contains propagators raised to noninteger (i.e. fractional or symbolic) powers.","anchor":"fcloopnonintegerpropagatorpowersfreeq"},{"text":"Overview, FCLoopRemoveNegativePropagatorPowers.","anchor":"see-also","section":"See also"},{"text":"SFAD[{q + p, m^2, 2}] FCLoopNonIntegerPropagatorPowersFreeQ[FCI[%]]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{1}{((p+q)^2-m^2+i \\eta )^2}\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[\\text{True}\\]","anchor":"cb1-3","section":"Examples"},{"text":"SFAD[{q + p, m^2, n}] FCLoopNonIntegerPropagatorPowersFreeQ[FCI[%]]","anchor":"cb2","section":"Examples"},{"text":"\\[((p+q)^2-m^2+i \\eta )^{-n}\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[\\text{False}\\]","anchor":"cb2-3","section":"Examples"},{"text":"CFAD[{l, m^2, 1/2}] FCLoopNonIntegerPropagatorPowersFreeQ[FCI[%]]","anchor":"cb3","section":"Examples"},{"text":"\\[\\frac{1}{\\sqrt{(l^2+m^2-i \\eta )}}\\]","anchor":"cb3-3","section":"Examples"},{"text":"\\[\\text{False}\\]","anchor":"cb3-3","section":"Examples"}]