[{"text":"GAD[mu] can be used as input for a D-dimensional \\gamma ^{\\mu } and is transformed into DiracGamma[LorentzIndex[mu,D],D] by FeynCalcInternal (=FCI).","anchor":"gad"},{"text":"GAD[mu , nu , ...] is a short form for GAD[mu].GAD[nu].","anchor":"gad"},{"text":"Overview, DiracGamma, GA, GS.","anchor":"see-also","section":"See also"},{"text":"GAD[\\[Mu]]","anchor":"cb1","section":"Examples"},{"text":"\\[\\gamma ^{\\mu }\\]","anchor":"cb1-1","section":"Examples"},{"text":"GAD[\\[Mu], \\[Nu]] - GAD[\\[Nu], \\[Mu]]","anchor":"cb2","section":"Examples"},{"text":"\\[\\gamma ^{\\mu }.\\gamma ^{\\nu }-\\gamma ^{\\nu }.\\gamma ^{\\mu }\\]","anchor":"cb2-1","section":"Examples"},{"text":"StandardForm[FCI[GAD[\\[Mu]]]] (*DiracGamma[LorentzIndex[\\[Mu], D], D]*)","anchor":"cb3","section":"Examples"},{"text":"GAD[\\[Mu], \\[Nu], \\[Rho], \\[Sigma]]","anchor":"cb4","section":"Examples"},{"text":"\\[\\gamma ^{\\mu }.\\gamma ^{\\nu }.\\gamma ^{\\rho }.\\gamma ^{\\sigma }\\]","anchor":"cb4-1","section":"Examples"},{"text":"StandardForm[GAD[\\[Mu], \\[Nu], \\[Rho], \\[Sigma]]] (*GAD[\\[Mu]] . GAD[\\[Nu]] . GAD[\\[Rho]] . GAD[\\[Sigma]]*)","anchor":"cb5","section":"Examples"},{"text":"GAD[\\[Alpha]] . (GSD[p] + m) . GAD[\\[Beta]]","anchor":"cb6","section":"Examples"},{"text":"\\[\\gamma ^{\\alpha }.(m+\\gamma \\cdot p).\\gamma ^{\\beta }\\]","anchor":"cb6-1","section":"Examples"}]