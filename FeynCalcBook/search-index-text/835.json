[{"text":"ScalarProductCancel[exp, q1, q2, ...] cancels scalar products with propagators.","anchor":"scalarproductcancel"},{"text":"ScalarProductCancel[exp] cancels simple cases.","anchor":"scalarproductcancel"},{"text":"ScalarProductCancel is deprecated, please use the more powerful ApartFF instead.","anchor":"scalarproductcancel"},{"text":"Overview, ApartFF, FCClearScalarProducts, ExpandScalarProduct, Pair, SP, SPC, SPD.","anchor":"see-also","section":"See also"},{"text":"SPD[q, p] FAD[{q, m}, {q - p, 0}] ScalarProductCancel[%, q]","anchor":"cb1","section":"Examples"},{"text":"\\[\\frac{p\\cdot q}{\\left(q^2-m^2\\right).(q-p)^2}\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[\\frac{m^2+p^2}{2 q^2.\\left((q-p)^2-m^2\\right)}-\\frac{1}{2 \\left(q^2-m^2\\right)}\\]","anchor":"cb1-3","section":"Examples"},{"text":"SPD[q2, p] SPD[q1, p] FAD[{q1, m}, {q2, m}, q1 - p, q2 - p, q2 - q1] //FCI SPC[%, q1, q2, FDS -> True]","anchor":"cb2","section":"Examples"},{"text":"\\[\\frac{(p\\cdot \\;\\text{q1}) (p\\cdot \\;\\text{q2})}{\\left(\\text{q1}^2-m^2\\right).\\left(\\text{q2}^2-m^2\\right).(\\text{q1}-p)^2.(\\text{q2}-p)^2.(\\text{q2}-\\text{q1})^2}\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[\\frac{\\left(m^2+p^2\\right)^2}{4 \\left(\\text{q1}^2-m^2\\right).\\left(\\text{q2}^2-m^2\\right).(\\text{q1}-p)^2.(\\text{q1}-\\text{q2})^2.(\\text{q2}-p)^2}+\\frac{m^2+p^2}{2 \\;\\text{q1}^2.\\text{q2}^2.\\left((\\text{q1}-p)^2-m^2\\right).(\\text{q1}-\\text{q2})^2}-\\frac{m^2+p^2}{2 \\left(\\text{q1}^2-m^2\\right).\\left(\\text{q2}^2-m^2\\right).(\\text{q1}-p)^2.(\\text{q1}-\\text{q2})^2}-\\frac{1}{2 \\left(\\text{q1}^2-m^2\\right).(\\text{q1}-\\text{q2})^2.(\\text{q2}-p)^2}+\\frac{1}{4 \\left(\\text{q1}^2-m^2\\right).\\left(\\text{q2}^2-m^2\\right).(\\text{q1}-\\text{q2})^2}\\]","anchor":"cb2-3","section":"Examples"}]