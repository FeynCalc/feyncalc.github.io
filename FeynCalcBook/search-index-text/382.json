[{"text":"FCLoopAddMissingHigherOrdersWarning[expr, ep, fun] determines the highest ep-power n in the given expression and adds a warning flag of order \\(\\textrm{ep}^n+1\\). This is meant to prevent incorrect results stemming insufficient high expansions of expr in ep","anchor":"fcloopaddmissinghigherorderswarning"},{"text":"Overview, FCFeynmanParametrize, FCFeynmanPrepare.","anchor":"see-also","section":"See also"},{"text":"FCLoopAddMissingHigherOrdersWarning[1/ep^2 cc1 + 1/ep cc2, ep, epHelp]","anchor":"cb1","section":"Examples"},{"text":"\\frac{\\text{cc1}}{\\text{ep}^2}+\\frac{\\text{cc2}}{\\text{ep}}+(1+i) \\;\\text{epHelp}","anchor":"cb1-1","section":"Examples"},{"text":"FCLoopAddMissingHigherOrdersWarning[cc1, ep, epHelp]","anchor":"cb2","section":"Examples"},{"text":"\\[\\text{cc1}+(1+i) \\;\\text{ep} \\;\\text{epHelp}\\]","anchor":"cb2-1","section":"Examples"},{"text":"FCLoopAddMissingHigherOrdersWarning[cc1, ep, epHelp, Complex -> False]","anchor":"cb3","section":"Examples"},{"text":"\\[\\text{cc1}+\\text{ep} \\;\\text{epHelp}\\]","anchor":"cb3-1","section":"Examples"},{"text":"FCLoopAddMissingHigherOrdersWarning[cc1, ep, epHelp, Names -> False]","anchor":"cb4","section":"Examples"},{"text":"\\[\\text{cc1}+(1+i) \\;\\text{ep} \\;\\text{epHelp}\\]","anchor":"cb4-1","section":"Examples"},{"text":"FCLoopAddMissingHigherOrdersWarning[GLI[topo1, {1, 1, 1, 1, 1}] -> cc1/ep^2 + cc2/ep + cc3 , ep, epHelp]","anchor":"cb5","section":"Examples"},{"text":"\\[G^{\\text{topo1}}(1,1,1,1,1)\\to \\frac{\\text{cc1}}{\\text{ep}^2}+\\frac{\\text{cc2}}{\\text{ep}}+\\text{cc3}+(1+i) \\;\\text{ep} \\;\\text{epHelp}(\\text{topo1X11111})\\]","anchor":"cb5-1","section":"Examples"}]