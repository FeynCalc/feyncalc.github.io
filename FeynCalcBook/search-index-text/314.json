[{"text":"FCAttachTypesettingRule[expr, ...] attaches a specific TraditionalForm typesetting rule to expr. It doesn’t change any properties of expr apart from adding a FormatValue with a MakeBoxes rule.","anchor":"fcattachtypesettingrule"},{"text":"Following choices are possible:","anchor":"fcattachtypesettingrule"},{"text":"FCAttachTypesettingRule[expr_, str]","anchor":"fcattachtypesettingrule"},{"text":"FCAttachTypesettingRules[expr, {SubscriptBox, var, sub}]","anchor":"fcattachtypesettingrule"},{"text":"FCAttachTypesettingRules[expr, {SuperscriptBox, var, sup}]","anchor":"fcattachtypesettingrule"},{"text":"FCAttachTypesettingRules[expr, {SubsuperscriptBox, var, sub, sup}]","anchor":"fcattachtypesettingrule"},{"text":"Use FCRemoveTypesettingRules to remove all typesetting rules attached to expr.","anchor":"fcattachtypesettingrule"},{"text":"Overview, FCRemoveTypesettingRules.","anchor":"see-also","section":"See also"},{"text":"FCRemoveTypesettingRules[mu]","anchor":"cb1","section":"Examples"},{"text":"FCAttachTypesettingRule[mu, \"\\[Mu]\"] mu","anchor":"cb2","section":"Examples"},{"text":"\\[\\mu\\]","anchor":"cb2-3","section":"Examples"},{"text":"mc[\"d_ss\"]","anchor":"cb3","section":"Examples"},{"text":"\\[\\text{mc}(\\text{d$\\_$ss})\\]","anchor":"cb3-1","section":"Examples"},{"text":"FCAttachTypesettingRule[mc[\"d_ss\"], {SubscriptBox, \"d\", \"ss\"}] mc[\"d_ss\"]","anchor":"cb4","section":"Examples"},{"text":"\\[d_{\\text{ss}}\\]","anchor":"cb4-3","section":"Examples"},{"text":"m12","anchor":"cb5","section":"Examples"},{"text":"\\[\\text{m12}\\]","anchor":"cb5-1","section":"Examples"},{"text":"FCAttachTypesettingRule[m12, {SubsuperscriptBox, m, 1, 2}] m12","anchor":"cb6","section":"Examples"},{"text":"\\[m_1^2\\]","anchor":"cb6-3","section":"Examples"},{"text":"{p1, p2, p3, p4} MapThread[FCAttachTypesettingRule[#1, {SubscriptBox, \"p\", #2}] &, {{p1, p2, p3, p4}, Range[4]}]; {p1, p2, p3, p4}","anchor":"cb7","section":"Examples"},{"text":"\\{\\text{p1},\\text{p2},\\text{p3},\\text{p4}\\}","anchor":"cb7-5","section":"Examples"},{"text":"\\[\\left\\{p_1,p_2,p_3,p_4\\right\\}\\]","anchor":"cb7-5","section":"Examples"},{"text":"FCRemoveTypesettingRules[mu] FCRemoveTypesettingRules[mc[\"d_ss\"]] FCRemoveTypesettingRules[m12] FCRemoveTypesettingRules /@ {p1, p2, p3, p4};","anchor":"cb8","section":"Examples"}]