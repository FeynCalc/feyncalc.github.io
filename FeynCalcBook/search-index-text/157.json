[{"text":"Overview.","anchor":"see-also","section":"See also"},{"text":"FeynCalc objects relevant for the color algebra are","anchor":"notation-for-colored-objects","section":"Notation for colored objects"},{"text":"SUNT[a]","anchor":"cb1","section":"Notation for colored objects"},{"text":"\\[T^a\\]","anchor":"cb1-1","section":"Notation for colored objects"},{"text":"SUNF[a, b, c]","anchor":"cb2","section":"Notation for colored objects"},{"text":"\\[f^{abc}\\]","anchor":"cb2-1","section":"Notation for colored objects"},{"text":"SUND[a, b, c]","anchor":"cb3","section":"Notation for colored objects"},{"text":"\\[d^{abc}\\]","anchor":"cb3-1","section":"Notation for colored objects"},{"text":"SUNDelta[a, b]","anchor":"cb4","section":"Notation for colored objects"},{"text":"\\[\\delta ^{ab}\\]","anchor":"cb4-1","section":"Notation for colored objects"},{"text":"SUNN","anchor":"cb5","section":"Notation for colored objects"},{"text":"\\[N\\]","anchor":"cb5-1","section":"Notation for colored objects"},{"text":"\\[C_A\\]","anchor":"cb6-1","section":"Notation for colored objects"},{"text":"\\[C_F\\]","anchor":"cb7-1","section":"Notation for colored objects"},{"text":"There are two main functions to deal with colored objects: SUNSimplify and SUNTrace. In general, SUNSimplify will also simplify color traces when possible","anchor":"cb7-1","section":"Notation for colored objects"},{"text":"SUNT[a, a] SUNSimplify[%]","anchor":"cb8","section":"Notation for colored objects"},{"text":"\\[T^a.T^a\\]","anchor":"cb8-2","section":"Notation for colored objects"},{"text":"\\[C_F\\]","anchor":"cb8-2","section":"Notation for colored objects"},{"text":"SUNT[a, b, a, b] SUNSimplify[%]","anchor":"cb9","section":"Notation for colored objects"},{"text":"\\[T^a.T^b.T^a.T^b\\]","anchor":"cb9-2","section":"Notation for colored objects"},{"text":"\\[-\\frac{1}{2} C_F \\left(C_A-2 C_F\\right)\\]","anchor":"cb9-2","section":"Notation for colored objects"},{"text":"SUNT[b, d, a, b, d] SUNSimplify[%]","