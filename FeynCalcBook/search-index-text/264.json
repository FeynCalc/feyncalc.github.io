[{"text":"DummyIndexFreeQ[exp, {head1, head2, ...}] returns True if the expression contains dummy indices with heads head1, head2, … and False otherwise.","anchor":"dummyindexfreeq"},{"text":"As always in FeynCalc, Einstein summation convention is implicitly assumed.","anchor":"dummyindexfreeq"},{"text":"The function is optimized for large expressions, i.e. it is not so good as a criterion in e.g. Select.","anchor":"dummyindexfreeq"},{"text":"Overview, FCRenameDummyIndices, Contract, FreeIndexFreeQ.","anchor":"see-also","section":"See also"},{"text":"FCI[FV[p, \\[Mu]] FV[q, \\[Nu]]] DummyIndexFreeQ[%, {LorentzIndex}]","anchor":"cb1","section":"Examples"},{"text":"\\[\\overline{p}^{\\mu } \\overline{q}^{\\nu }\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[\\text{True}\\]","anchor":"cb1-3","section":"Examples"},{"text":"FCI[FV[p, \\[Mu]] FV[q, \\[Mu]]] DummyIndexFreeQ[%, {LorentzIndex}]","anchor":"cb2","section":"Examples"},{"text":"\\[\\overline{p}^{\\mu } \\overline{q}^{\\mu }\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[\\text{False}\\]","anchor":"cb2-3","section":"Examples"},{"text":"FCI[SUNT[a, b]] DummyIndexFreeQ[%, {SUNIndex}]","anchor":"cb3","section":"Examples"},{"text":"\\[T^a.T^b\\]","anchor":"cb3-3","section":"Examples"},{"text":"\\[\\text{True}\\]","anchor":"cb3-3","section":"Examples"},{"text":"FCI[SUNT[a, a]] DummyIndexFreeQ[%, {SUNIndex}]","anchor":"cb4","section":"Examples"},{"text":"\\[T^a.T^a\\]","anchor":"cb4-3","section":"Examples"},{"text":"\\[\\text{False}\\]","anchor":"cb4-3","section":"Examples"}]