[{"text":"Convolute[f, g, x] convolutes f(x) and g(x), i.e., \\(\\int _0^1 dx_1 \\int _0^1 dx_2 \\delta \\left(x - x_1 x_2\\right) f (x_1) g(x_2)\\).","anchor":"convolute"},{"text":"Convolute[f, g] is equivalent to Convolute[f, g, x].","anchor":"convolute"},{"text":"Convolute[exp, {x1, x2}] assumes that exp is polynomial in x1 and x2. Convolute uses table-look-up and does not do any integral calculations, only linear algebra.","anchor":"convolute"},{"text":"Overview, PlusDistribution, ConvoluteTable.","anchor":"see-also","section":"See also"},{"text":"Convolute[1, 1] /. FCGV[z_] :> ToExpression[z]","anchor":"cb1","section":"Examples"},{"text":"\\[-\\log (x)\\]","anchor":"cb1-1","section":"Examples"},{"text":"Convolute[x, x] /. FCGV[z_] :> ToExpression[z]","anchor":"cb2","section":"Examples"},{"text":"\\[-x^2 \\log (x)\\]","anchor":"cb2-1","section":"Examples"},{"text":"Convolute[1, x] /. FCGV[z_] :> ToExpression[z]","anchor":"cb3","section":"Examples"},{"text":"\\[-x \\log (x)\\]","anchor":"cb3-1","section":"Examples"},{"text":"Convolute[1, 1/(1 - x)] /. FCGV[z_] :> ToExpression[z]","anchor":"cb4","section":"Examples"},{"text":"\\[\\frac{\\log (x)}{x-1}\\]","anchor":"cb4-1","section":"Examples"},{"text":"Convolute[1, PlusDistribution[1/(1 - x)]] /. FCGV[z_] :> ToExpression[z]","anchor":"cb5","section":"Examples"},{"text":"\\[\\frac{\\log (x)}{x-1}\\]","anchor":"cb5-1","section":"Examples"},{"text":"Convolute[1/(1 - x), x] /. FCGV[z_] :> ToExpression[z]","anchor":"cb6","section":"Examples"},{"text":"\\[\\frac{x \\log (x)}{x-1}\\]","anchor":"cb6-1","section":"Examples"},{"text":"Convolute[1/(1 - x), 1/(1 - x)] /. FCGV[z_] :> ToExpression[z]","anchor":"cb7","section":"Examples"},{"text":"\\[-\\frac{\\log (x)}{(x-1)^2}\\]","anchor":"cb7-1","section":"Examples"},{"text":"Convolute[1, Log[1 - x]] /. FCGV[z_] :> ToExpression[z]","anchor":"cb8","section":"Examples"},{"text":"\\[-\\log (1-x) \\log (x)\\]","anchor":"cb8-1","section":"Examples"},{"text":"Convolute[1, x Log[1 - x]] /. FCGV[z_] :> ToExpression[z]","anchor":"cb9","section":"Examples"},{"text":"\\[-x \\log (1-x) \\log (x)\\]","anchor":"cb9-1","section":"Examples"},{"text":"Convolute[1/(1 - x), Log[1 - x]] /. FCGV[z_] :> ToExpression[z]","anchor":"cb10","section":"Examples"},{"text":"\\[\\frac{\\log (1-x) \\log (x)}{x-1}\\]","anchor":"cb10-1","section":"Examples"},{"text":"Convolute[1/(1 - x), x Log[1 - x]] /. FCGV[z_] :> ToExpression[z]","anchor":"cb11","section":"Examples"},{"text":"\\[\\frac{x \\log (1-x) \\log (x)}{x-1}\\]","anchor":"cb11-1","section":"Examples"},{"text":"Convolute[Log[1 - x]/(1 - x), x] /. FCGV[z_] :> ToExpression[z]","anchor":"cb12","section":"Examples"},{"text":"\\[\\frac{x \\log (1-x) \\log (x)}{x-1}\\]","anchor":"cb12-1","section":"Examples"},{"text":"Convolute[1, x Log[x]] /. FCGV[z_] :> ToExpression[z]","anchor":"cb13","section":"Examples"},{"text":"\\[-x \\log ^2(x)\\]","anchor":"cb13-1","section":"Examples"},{"text":"Convolute[Log[1 - x], x] /. FCGV[z_] :> ToExpression[z]","anchor":"cb14","section":"Examples"},{"text":"\\[-x \\log (1-x) \\log (x)\\]","anchor":"cb14-1","section":"Examples"}]