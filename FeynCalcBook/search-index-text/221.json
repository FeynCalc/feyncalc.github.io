[{"text":"DiracEquation[exp] applies the Dirac equation without expanding exp. If expansions are necessary, use DiracSimplify.","anchor":"diracequation"},{"text":"Overview","anchor":"see-also","section":"See also"},{"text":"GS[p] . SpinorU[p, m] DiracSimplify[%]","anchor":"cb1","section":"Examples"},{"text":"\\[\\left(\\bar{\\gamma }\\cdot \\overline{p}\\right).u(p,m)\\]","anchor":"cb1-3","section":"Examples"},{"text":"\\[m \\left(\\varphi (\\overline{p},m)\\right)\\]","anchor":"cb1-3","section":"Examples"},{"text":"GS[p] . SpinorU[p, m] DiracEquation[%]","anchor":"cb2","section":"Examples"},{"text":"\\[\\left(\\bar{\\gamma }\\cdot \\overline{p}\\right).u(p,m)\\]","anchor":"cb2-3","section":"Examples"},{"text":"\\[m \\left(\\varphi (\\overline{p},m)\\right)\\]","anchor":"cb2-3","section":"Examples"},{"text":"GS[p] . SpinorV[p, m] DiracEquation[%]","anchor":"cb3","section":"Examples"},{"text":"\\[\\left(\\bar{\\gamma }\\cdot \\overline{p}\\right).v(p,m)\\]","anchor":"cb3-3","section":"Examples"},{"text":"\\[-m \\left(\\varphi (-\\overline{p},m)\\right)\\]","anchor":"cb3-3","section":"Examples"},{"text":"SpinorUBar[p, 0] . GS[p] DiracEquation[%]","anchor":"cb4","section":"Examples"},{"text":"\\[\\bar{u}(p).\\left(\\bar{\\gamma }\\cdot \\overline{p}\\right)\\]","anchor":"cb4-3","section":"Examples"},{"text":"\\[0\\]","anchor":"cb4-3","section":"Examples"},{"text":"DiracEquation also works in D-dimensions","anchor":"cb4-3","section":"Examples"},{"text":"SpinorVBarD[p, m] . GSD[p] DiracEquation[%]","anchor":"cb5","section":"Examples"},{"text":"\\[\\bar{v}(p,m).(\\gamma \\cdot p)\\]","anchor":"cb5-3","section":"Examples"},{"text":"\\[-m (\\varphi (-p,m))\\]","anchor":"cb5-3","section":"Examples"}]