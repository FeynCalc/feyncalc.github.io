[{"text":"Cases2[expr, f] returns a list of all objects in expr with head f.","anchor":"cases2"},{"text":"Cases2[expr,f] is equivalent to Cases2[{expr},f[___],Infinity]//Union.","anchor":"cases2"},{"text":"Cases2[expr, f, g, ...] or Cases2[expr, {f,g, ...}] is equivalent to Cases[{expr},f[___] | g[___] ...].","anchor":"cases2"},{"text":"Overview, Variables2.","anchor":"see-also","section":"See also"},{"text":"Cases2[f[a] + f[b]^2 + f[c, d], f]","anchor":"cb1","section":"Examples"},{"text":"\\[\\{f(a),f(b),f(c,d)\\}\\]","anchor":"cb1-1","section":"Examples"},{"text":"Cases2[Sin[x] Sin[y - z] + g[y], Sin, g]","anchor":"cb2","section":"Examples"},{"text":"\\[\\{g(y),\\sin (x),\\sin (y-z)\\}\\]","anchor":"cb2-1","section":"Examples"},{"text":"Cases2[Sin[x] Sin[y - z] + g[x] + g[a, b, c], {Sin, g}]","anchor":"cb3","section":"Examples"},{"text":"\\[\\{g(x),g(a,b,c),\\sin (x),\\sin (y-z)\\}\\]","anchor":"cb3-1","section":"Examples"},{"text":"Cases2[GS[p] . GS[q] + SP[p, p], Dot]","anchor":"cb4","section":"Examples"},{"text":"\\[\\left\\{\\left(\\bar{\\gamma }\\cdot \\overline{p}\\right).\\left(\\bar{\\gamma }\\cdot \\overline{q}\\right)\\right\\}\\]","anchor":"cb4-1","section":"Examples"}]